diff --git a/include/hw/sh4/sh_intc.h b/include/hw/sh4/sh_intc.h
index 94f1831..6ec46e0 100644
--- a/include/hw/sh4/sh_intc.h
+++ b/include/hw/sh4/sh_intc.h
@@ -37,6 +37,14 @@ struct intc_source {
     unsigned short vect;
     intc_enum next_enum_id;
 
+    /*
+     * SH-4 interrupt priority level, 0..15.  An interrupt is only accepted
+     * while its level is greater than SR.IMASK.  Defaults to 15, so a
+     * controller that does not set it keeps the previous behaviour of
+     * ignoring IMASK.
+     */
+    unsigned char prio;
+
     int asserted; /* emulates the interrupt signal line from device to intc */
     int enable_count;
     int enable_max;
@@ -55,6 +63,8 @@ struct intc_desc {
     struct intc_prio_reg *prio_regs;
     int nr_prio_regs;
     int pending; /* number of interrupt sources that has pending set */
+    /* Priority level of the source last returned by get_pending_vector. */
+    unsigned char pending_prio;
 };
 
 int sh_intc_get_pending_vector(struct intc_desc *desc, int imask);
diff --git a/target/sh4/helper.c b/target/sh4/helper.c
index b6b057f..e2a1e8a 100644
--- a/target/sh4/helper.c
+++ b/target/sh4/helper.c
@@ -151,6 +151,23 @@ void superh_cpu_do_interrupt(CPUState *cs)
     env->sr |= (1u << SR_BL) | (1u << SR_MD) | (1u << SR_RB);
     env->lock_addr = -1;
 
+    if (do_irq) {
+        /*
+         * Accepting an interrupt raises SR.IMASK to that interrupt's priority
+         * level, so a handler which saves SR on entry and restores it on exit
+         * stays masked against its own source until it has acknowledged the
+         * device.  Without this an RTOS whose prologue does exactly that
+         * re-enters on the instruction after restoring SR and never reaches
+         * the code that clears the device flag.
+         */
+        struct intc_desc *desc = env->intc_handle;
+
+        if (desc) {
+            env->sr &= ~(0xfu << 4);
+            env->sr |= (uint32_t)desc->pending_prio << 4;
+        }
+    }
+
     if (env->flags & TB_FLAG_DELAY_SLOT_MASK) {
         /* Branch instruction should be executed again before delay slot. */
         env->spc -= 2;
diff --git a/target/sh4/translate.c b/target/sh4/translate.c
index 373950f..c79ea07 100644
--- a/target/sh4/translate.c
+++ b/target/sh4/translate.c
@@ -220,7 +220,18 @@ static inline void gen_save_cpu_state(DisasContext *ctx, bool save_pc)
 
 static inline bool use_exit_tb(DisasContext *ctx)
 {
-    return (ctx->tbflags & TB_FLAG_GUSA_EXCLUSIVE) != 0;
+    /*
+     * An rte writes SSR back into SR, which can unmask an interrupt that was
+     * declined a moment earlier because the delay slot is indivisible.  The
+     * block holding that delay slot otherwise chains straight into the resumed
+     * code through lookup_and_goto_ptr, so the CPU never returns to the
+     * interrupt check, and a source that stays asserted -- a periodic timer
+     * whose handler did not run -- is never offered again: cpu_interrupt() is
+     * only called on the 0->1 edge, so nothing kicks the CPU out of the chain.
+     * Leave the loop after an rte delay slot instead.
+     */
+    return (ctx->tbflags &
+            (TB_FLAG_GUSA_EXCLUSIVE | TB_FLAG_DELAY_SLOT_RTE)) != 0;
 }
 
