--- a/hw/intc/sh_intc.c
+++ b/hw/intc/sh_intc.c
@@ -91,12 +91,20 @@ int sh_intc_get_pending_vector(struct intc_desc *desc, int imask)
     for (i = 0; i < desc->nr_sources; i++) {
         struct intc_source *source = &desc->sources[i];
 
-        if (source->pending) {
+        /*
+         * An SH-4 interrupt is accepted only while its priority level is
+         * strictly greater than SR.IMASK.  Sources left at the default level
+         * of 15 behave as before.  Without this, a guest that masks its own
+         * timer by raising IMASK inside the interrupt prologue re-enters the
+         * handler immediately and nests until the stack is gone.
+         */
+        if (source->pending && source->prio > imask) {
             trace_sh_intc_pending(desc->pending, source->vect);
+            desc->pending_prio = source->prio;
             return source->vect;
         }
     }
-    g_assert_not_reached();
+    return -1;
 }
 
 typedef enum {
@@ -242,6 +250,21 @@ static void sh_intc_write(void *opaque, hwaddr offset,
         mask = (1 << width) - 1;
         mask <<= (first - k) * width;
 
+        /*
+         * A priority register carries a numeric level per field, and on SH-4
+         * that level is what SR.IMASK is compared against when the interrupt
+         * is offered.  Upstream only ever asked whether the field was
+         * non-zero, which leaves every source at the default level and makes
+         * IMASK meaningless.  Record the level as well.  Levels above 15
+         * cannot exist on this architecture, so a wider field is clamped.
+         */
+        if ((mode & INTC_MODE_IS_PRIO) && enum_ids[k]) {
+            unsigned int level = (value & mask) >> ((first - k) * width);
+
+            desc->sources[enum_ids[k]].prio = MIN(level, 15);
+            trace_sh_intc_prio(enum_ids[k], level);
+        }
+
         if ((*valuep & mask) != (value & mask)) {
             sh_intc_toggle_mask(desc, enum_ids[k], value & mask, 0);
         }
@@ -401,6 +424,7 @@ int sh_intc_init(MemoryRegion *sysmem,
     desc->sources = g_new0(struct intc_source, nr_sources);
     for (i = 0; i < nr_sources; i++) {
