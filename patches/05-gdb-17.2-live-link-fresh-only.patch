+/* Diagnostic only: do not invent another DMA delivery from cached live-link
+   bytes. This does not model the board clocks or the 200-byte housekeeping
+   path, and therefore is not a hardware-correctness claim. Legacy is default. */
+static int
+bfin_sport_link_fresh_only (void)
+{
+  static int cached = -1;
+  if (cached < 0)
+    {
+      const char *env = getenv ("BFIN_LINK_FRESH_ONLY");
+      cached = env && !strcmp (env, "1");
+      if (cached)
+        fprintf (stderr, "link: fresh-only live delivery diagnostic enabled; "
+                 "not a hardware clock model\n");
+    }
+  return cached;
+}
