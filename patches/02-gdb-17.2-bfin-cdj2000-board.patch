+/* Minimal SPORT model.  The upstream BF53x machine maps SPORT MMRs as plain
+   memory even though its DMAC expects bfin_sport devices to exist.  Keep the
+   register file behavior used by that stub, expose the common DMA peer
+   prefix, and stall receive DMA cleanly until board input is supplied.  */
+#define BFIN_MMR_SPORT_SIZE 0x60
+
+struct bfin_sport
+{
+  /* This top portion matches common dv_bfin struct.  */
+  bu32 base;
+  struct hw *dma_master;
+  bool acked;
+
+  bu32 regs[BFIN_MMR_SPORT_SIZE / 4];
+
+  unsigned char *rx_data;
+  size_t rx_size;
+  size_t rx_offset;
+  bool rx_initialized;
+  bool rx_exhaustion_reported;
+  bool rx_records;
+  unsigned char rx_last[4096];
+  size_t rx_last_size;
+
+  /* Minimal MAIN peer.  The GUI does not consume a script: it transmits
+     48-byte requests whose word 1 is 0x8000|type and then reads a 64-byte
+     status record, following it with a payload read when that record
+     announces one (word 29 == 1, word 30 == payload words).  Replaying a
+     recording cannot answer those requests, so answer them directly.  */
+  bool peer_enabled;
+  bool peer_scanned;
+  bool peer_have_status;
+  unsigned char peer_status[64];
+  unsigned char peer_wave[4096];
+  size_t peer_wave_size;
+  unsigned char peer_state[4096];
+  size_t peer_state_size;
+  /* Payloads for request types the capture never contained.  The recording only
+     ever carries command 0x10 (waveform) and 0x11 (player state), but the GUI
+     also asks for types 0, 1, 5 and 7, so those must be synthesized.  Each
+     BFIN_MAIN_PEER_PAYLOAD_<type> names a file holding that type's raw payload;
+     the command word and CRC are rewritten when it is served, so the file only
+     has to carry the body.
+
+     A request is a (type, cursor) PAIR, not just a type.  Word 1 of the 48-byte
+     request is 0x8000|type and word 2 is the cursor; the GUI asks for type 1
+     with cursors 1, 3 and 11, and for type 7 with cursors 0, 7 and 8.  Cursor 11
+     is the right browse pane (handler 0x00b7d396, a second list record with the
+     same wire layout as type 1 but its own destination at 0x4b6624), so keying
+     payloads on the type alone served the left list's bytes to the right pane —
+     that, and no unknown buffer, is why the two panes mirrored each other.
+
+     BFIN_MAIN_PEER_PAYLOAD_<type>_<cursor> selects per pair;
+     BFIN_MAIN_PEER_PAYLOAD_<type> stays valid as the any-cursor fallback so the
+     recipes in CONTINUE_GUI_RE.md keep working unchanged.  */
+#define BFIN_SPORT_PEER_TYPES 16
+#define BFIN_SPORT_PEER_CURSORS 16
+#define BFIN_SPORT_PEER_PAYLOAD_MAX 8192
+  unsigned char *peer_payload[BFIN_SPORT_PEER_TYPES][BFIN_SPORT_PEER_CURSORS];
+  size_t peer_payload_size[BFIN_SPORT_PEER_TYPES][BFIN_SPORT_PEER_CURSORS];
+  unsigned char *peer_payload_any[BFIN_SPORT_PEER_TYPES];
+  size_t peer_payload_any_size[BFIN_SPORT_PEER_TYPES];
+  /* A payload SEQUENCE, so successive answers to the same request can carry
+     different bodies.  The overview-waveform handler takes payload words 2 and
+     3 as the first and last column index, and what a column *means* is the
+     sender's choice, so a moving window over a longer envelope is a scrolling
+     view built entirely on the host -- but only if the peer stops replaying one
+     fixed file.  BFIN_MAIN_PEER_PAYLOAD_<type>_SEQ takes a comma-separated list
+     of files and each delivery advances one entry, wrapping at the end;
+     BFIN_MAIN_PEER_SEQ_HOLD repeats each entry that many deliveries first.
+     A sequence wins over the pair- and any-cursor files; leaving the variable
+     unset keeps every existing recipe byte-for-byte unchanged.  Named
+     peer_plseq_* because peer_seq_* is already taken further down this struct
+     by the STATUS record sequence, which is a different mechanism.  */
+#define BFIN_SPORT_PEER_PLSEQ_MAX 32
+  unsigned char *peer_plseq[BFIN_SPORT_PEER_TYPES][BFIN_SPORT_PEER_PLSEQ_MAX];
+  size_t peer_plseq_size[BFIN_SPORT_PEER_TYPES][BFIN_SPORT_PEER_PLSEQ_MAX];
+  unsigned peer_plseq_count[BFIN_SPORT_PEER_TYPES];
+  unsigned peer_plseq_served[BFIN_SPORT_PEER_TYPES];
+  unsigned peer_plseq_hold;
+  /* Types served with their payload's own command word left intact.  The
+     dispatcher at 0x00b7fa78 routes commands 6 -> 0xb7f348 and 3 -> 0xb7eff4
+     *before* the tag check at 0xb7ebbc, so the bulk transports are reachable
+     only if answer[0] is not rewritten to 0x10|tag.  */
+  unsigned peer_raw_types;
+  unsigned peer_request;
+  unsigned peer_tag;
+  const unsigned char *peer_pending;
+  size_t peer_pending_size;
+  /* The tag to stamp into the announced payload's command.  It must be latched
+     when the payload is announced, not when it is read: the GUI can transmit a
+     new request between the two, and stamping the later request's tag makes the
+     payload fail the check at 0x00b7ebbc.  */
+  unsigned peer_pending_tag;
+  /* Latched with the tag, for the same reason: whether this payload keeps its
+     own command word.  */
+  int peer_pending_raw;
+  unsigned char peer_answer[BFIN_SPORT_PEER_PAYLOAD_MAX];
+  /* A real MAIN board reports a *changing* machine state; replaying one
+     harvested record forever means nothing ever changes, and the GUI only
+     re-evaluates which screen to show when it is told something changed
+     (widget message 0x10016 -> FUN_00bae87a -> the screen router).  Without a
+     transition the router is never called, so the sub-mode command the boot
+     path queues at 0x6b49e0 is never consumed and screen 0 keeps the elements
+     it is supposed to hide.  BFIN_MAIN_PEER_STATUS names a file of
+     concatenated raw 64-byte records; the peer serves each for
+     BFIN_MAIN_PEER_STATUS_HOLD status reads and then holds the last.  */
+#define BFIN_SPORT_PEER_STATUS_MAX 16
+  unsigned char peer_seq[BFIN_SPORT_PEER_STATUS_MAX][64];
+  unsigned peer_seq_count;
+  unsigned peer_seq_index;
+  unsigned peer_seq_reads;
+  unsigned peer_seq_hold;
+  int peer_seq_loaded;
+
+  /* BFIN_MAIN_LINK bridges to a MAIN board emulated elsewhere instead of
+     answering from files.  Requests go out on <port>, records come back on
+     <port>+2 -- the two chardevs of the QEMU cdj2000-main machine, which are
+     the receive and transmit halves of the one physical link.  */
+  int link_enabled;
+  int link_opened;
+  int link_request_fd;
+  int link_record_fd;
+  unsigned char link_in[8192];
+  size_t link_in_len;
+  /* MAIN's records arrive as "CDJL" + LE32 length + body, because a TCP
+     socket does not preserve the boundaries the DMA channel it stands in for
+     does.  MAIN interleaves 64-byte status records with 224-byte payload
+     records; consumed as a flat stream, one 224-byte frame read as 64-byte
+     chunks leaves the reader 32 bytes out of phase permanently, every record
+     then fails the checksum at 0xb7f6be, and after ten of those the GUI puts
+     E-8709: COMMUNICATION ERROR on screen.  link_framed stays 0 against a peer
+     that sends no header, in which case the old flat-stream path is used.  */
+#define BFIN_LINK_FRAME_MAX 512
+#define BFIN_LINK_SIZES 8
+  /* BFIN_LINK_DEPTH=<n>: how many unread frames of one length the model keeps.
+     One -- the default, and bit-for-bit the behaviour every run before r162 was
+     measured on -- means MAIN's next answer overwrites the one the firmware has
+     not fetched yet.  r161 counted what that costs, on the 48-byte browse
+     answer, in one 800 s run:
+
+       arrived 3 002   overwritten unread 2 965   armed 568   hit 37   stale 531
+
+     The firmware asked 568 times and was handed a frame 37 times, while 2 965
+     answers for exactly those requests had already been thrown away.  "Stale"
+     is this model's own doing: the slot holds a frame that has been delivered
+     once, take() refuses to repeat it for a payload, and the newer ones that
+     would have satisfied the ask are gone.  A ring cannot stall MAIN -- the
+     socket is always drained and the oldest entry is dropped on overflow --
+     which is what MVP.md's "a queue stalls MAIN" warned about for a single
+     global queue, not for a bounded per-length one.  */
+/* r175 measured why 8 is not enough to matter: over 373 s MAIN transmitted
+   about 22 status records a second and the firmware armed about 22 64-byte
+   receives a second -- and only **0.2 a second** of those receives found an
+   unread record.  The two streams are not interleaved, they are two bursts out
+   of phase: roughly 96 records arrive with no receive between them, and then
+   roughly 96 receives are armed with no arrival between them.  With depth 1 the
+   96 arrivals collapse onto one entry and 95 are gone, so the firmware sees one
+   record out of every 96 MAIN sent.  A ring of 8 recovers 8 of them; a ring
+   that outlives a whole burst recovers all of them.  Default depth is still 1,
+   so BFIN_LINK_DEPTH is the switch that restores the old behaviour exactly.  */
+#define BFIN_LINK_DEPTH_MAX 256
+  unsigned char link_frame[BFIN_LINK_SIZES][BFIN_LINK_DEPTH_MAX]
+			  [BFIN_LINK_FRAME_MAX];
+  unsigned link_frame_len[BFIN_LINK_SIZES];
+  int link_frame_fresh[BFIN_LINK_SIZES][BFIN_LINK_DEPTH_MAX];
+  /* Where the next arrival is written, and where the next take reads.  With
+     depth 1 both are always 0 and every expression below collapses to the
+     single-slot code it replaced.  */
+  unsigned link_frame_put[BFIN_LINK_SIZES];
+  unsigned link_frame_get[BFIN_LINK_SIZES];
+  int link_framed;
+  /* How many more 200-byte housekeeping reads to refuse so the poll loop at
+     0xb7ef40 gives the shared DMA channel back.  Refusing every read while a
+     record is unread starves the whole board; a small budget per arriving
+     record is enough for the loop to see its count stand still and exit.  */
+  int link_yield_budget;
+  /* The most recent 64-byte status record.  A real link carries MAIN's
+     record continuously, so the GUI's receive DMA always has the latest
+     one; answering "nothing yet" instead stalls its protocol task and it
+     stops issuing requests altogether.  */
+  unsigned char link_last[64];
+  int link_have_last;
+  /* How many 64-byte deliveries in a row BFIN_LINK_HOLD_ANNOUNCE has answered
+     with the record the firmware already holds, so a firmware that never
+     leaves receive state 2 cannot wedge the status stream for the whole run.  */
+  unsigned long link_hold_run;
+  unsigned long link_hold_total;
+  /* Set when a delivered 64-byte record announced a payload, cleared when a
+     payload is delivered.  It is the whole trigger for BFIN_LINK_HOLD_ANNOUNCE
+     and it is local: no guest memory is read and no timing is assumed.  */
+  int link_announce_pending;
+  /* BFIN_LINK_RX_CENSUS -- who freezes the status channel.
+     BFIN_MAIN_LINK_DUMP records every record *handed to the firmware*, and
+     take() below repeats the newest 64-byte record whenever MAIN has not sent
+     a newer one, so a dump cannot tell "MAIN transmitted the same bytes again"
+     from "MAIN transmitted nothing and this model repeated its last record".
+     r174 counted 33 329 delivered status records against 10 186 `link-tx: sent`
+     lines in MAIN's own log, so two out of three dumped records were this
+     model's repeats -- and the "21 113 bit-identical copies" that reading rests
+     on is therefore not a measurement of MAIN at all.  These counters are set
+     where the difference is known.  Logging only; nothing here changes what the
+     firmware is handed.  */
+  int link_take_fresh;
+  /* r176: MAIN wrote 1 912 records to the socket and split() stored 54, with
+     lost=0 -- so the ring is not where they go and the loss is upstream of it.
+     These four say which of the four possible upstream fates it is: the bytes
+     never arrived (bytes), the stream lost frame sync (resync), a bad length
+     threw the whole staging buffer away (flush), or the buffer filled and poll
+     stopped reading (stall).  */
+  unsigned long link_rx_bytes;
+  unsigned long link_rx_resync;
+  unsigned long link_rx_flush;
+  unsigned long link_rx_stall;
+  unsigned long link_rx_arrived;  /* 64-byte records split() stored */
+  unsigned long link_rx_lost;     /* stored onto an entry nobody had read */
+  unsigned long link_rx_fresh;    /* 64-byte records taken off the socket */
+  unsigned long link_rx_repeat;   /* 64-byte records this model repeated */
+  unsigned long link_rx_changed;  /* fresh ones whose bytes differ from the last */
+  unsigned long link_rx_payload;  /* records of every other length */
+  double link_census_next;
+  /* An announcement and the payload it announces are one transaction, and this
+     model does not keep them together: the 64-byte and 224-byte slots advance
+     independently, so the payload the GUI checksums need not be the one the
+     status record in its memory announced.  When that happens word 30 at
+     0x00f0003c reads 0, the length underflows to 0xfffffffe at 0x00b7fa2a, and
+     the checksum loop at 0x00b7cb50 walks from 0x00f00040 until it leaves the
+     firmware's own CPLB map at 0x01100000, where it faults forever.  Four
+     pairing rules were tried against it -- hold the announcing record, drop
+     orphaned payloads, gate the payload on its announcement having been read,
+     and gate new records on the GUI having answered the last one -- and every
+     one of them left the exception count at exactly 67 031, so the trigger is
+     upstream of the slot policy.  See CONTINUE_GUI_RE.md; run with
+     BFIN_SPORT_RX_ADDR_TRACE and BFIN_EXCEPTION_TRACE to see it.  */
+};
+
+
+#ifdef _WIN32
+# include <winsock2.h>
+# define BFIN_LINK_ERR() WSAGetLastError ()
+# define BFIN_LINK_WOULDBLOCK WSAEWOULDBLOCK
+typedef int bfin_socklen;
+#else
+# include <sys/socket.h>
