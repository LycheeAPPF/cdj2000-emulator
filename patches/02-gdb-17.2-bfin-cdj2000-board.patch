+     during the run turns that enumeration into an answer about inputs.  */
+  {
+    static int st_initialized, st_on;
+    static unsigned long st_disp_a, st_disp_b, st_seq, st_bump;
+    static unsigned long st_zero, st_arm16, st_armed, st_w13, st_idle;
+    static unsigned long st_send, st_cls_a, st_cls_b, st_key;
+    static unsigned long st_src, st_parse;
+    /* The three stages between a widget message and the key dispatcher, see
