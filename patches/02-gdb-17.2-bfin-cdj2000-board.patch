+      {
+	const char *env = getenv ("BFIN_RECORD_TRACE");
+
+	rec_initialized = 1;
+	rec_every = (env && *env) ? strtod (env, NULL) : 0.0;
+	if (env && *env && rec_every <= 0.0)
+	  rec_every = 30.0;
+      }
+
