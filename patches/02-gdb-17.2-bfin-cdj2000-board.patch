+	else if (pc == 0xb7fc1a)
+	  ++rec_pendok;
+	else if (pc == 0xb7fc2a)
+	  ++rec_pendfail;
+
+	{
+	  double now = bfin_sim_seconds ();
+
+	  if (now >= rec_next)
+	    {
+	      rec_next = now + rec_every;
+	      fprintf (stderr, "record-trace t%.1f arms64=%lu armsother=%lu"
+		       " isr(busy=%lu wake=%lu)"
+		       " task(pend=%lu ok=%lu fail=%lu) handler=%lu parse=%lu"
+		       " state(0=%lu 2=%lu other=%lu crcbad=%lu)"
+		       " gate19=%lu gate13=%lu anntest=%lu"
+		       " ann(zero=%lu nz=%lu last=%u)"
+		       " w30(ok=%lu bad=%lu last=%u)"
+		       " payload(arm=%lu refuse=%lu ok=%lu bad=%lu use=%lu)\n",
+		       now, rec_arm64, rec_armother, rec_isrbusy, rec_isrwake,
+		       rec_pend, rec_pendok, rec_pendfail,
+		       rec_handler, rec_parse, rec_st0, rec_st2, rec_stx,
+		       rec_crcbad, rec_gate19, rec_gate13, rec_anntest,
+		       rec_annzero, rec_annnz, rec_lastann, rec_w30ok,
+		       rec_w30bad, rec_lastw30, rec_payarm, rec_payrej,
+		       rec_payok, rec_paybad, rec_payuse);
+	      fflush (stderr);
+	    }
+	}
+      }
+  }
