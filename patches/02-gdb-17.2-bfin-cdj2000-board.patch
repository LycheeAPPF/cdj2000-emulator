+  if (enabled < 0)
+    {
+      const char *value_env = getenv ("BFIN_GUI_STATE_READ_TRACE");
+      enabled = value_env && *value_env;
+      value_env = getenv ("BFIN_HOUSEKEEPING_READ_TRACE");
+      housekeeping_enabled = value_env && *value_env;
+      value_env = getenv ("BFIN_BOOTSTRAP_READ_TRACE");
+      bootstrap_enabled = value_env && *value_env;
+      value_env = getenv ("BFIN_GUI_STATE_READ_START");
+      if (value_env && *value_env)
+	custom_start = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_GUI_STATE_READ_END");
+      if (value_env && *value_env)
