+    static unsigned long st_evkind[32], st_evkind_n, st_evkind_wide;
+
+    if (!st_initialized)
+      {
+	const char *env = getenv ("BFIN_STEP_TRACE");
+
+	st_initialized = 1;
+	st_on = env && *env && strcmp (env, "0") != 0;
+      }
+
+    if (st_on)
+      {
+	if (pc == 0xbb4994)
