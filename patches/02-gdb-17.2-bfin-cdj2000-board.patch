+  fprintf (stderr, "bfin cplb: DMEM_CONTROL 0x%08x IMEM_CONTROL 0x%08x\n",
+	   mmu->dmem_control, mmu->imem_control);
+  for (i = 0; i < 16; ++i)
+    if (mmu->dcplb_data[i] & CPLB_VALID)
+      fprintf (stderr, "bfin cplb:  D%-2d 0x%08x +%s data 0x%08x\n", i,
+	       mmu->dcplb_addr[i],
+	       page[(mmu->dcplb_data[i] & PAGE_SIZE) >> 16],
+	       mmu->dcplb_data[i]);
+  for (i = 0; i < 16; ++i)
+    if (mmu->icplb_data[i] & CPLB_VALID)
+      fprintf (stderr, "bfin cplb:  I%-2d 0x%08x +%s data 0x%08x\n", i,
+	       mmu->icplb_addr[i],
+	       page[(mmu->icplb_data[i] & PAGE_SIZE) >> 16],
+	       mmu->icplb_data[i]);
+  fflush (stderr);
+}
+
+static void
+bfin_mmu_report_fault (SIM_CPU *cpu, int excp, bu32 addr, bool write,
+		       bool inst, bool supv)
+{
+  static struct { bu32 addr, pc; unsigned long hits; } seen[64];
+  static unsigned nr_seen;
+  static int enabled = -1;
+  bu32 pc = BFIN_CPU_STATE.multi_pc;
+  unsigned i;
+
+  if (enabled < 0)
+    enabled = (getenv ("BFIN_EXCEPTION_TRACE") != NULL
+	       || getenv ("BFIN_CPLB_TRACE") != NULL);
+  if (!enabled)
+    return;
+
+  for (i = 0; i < nr_seen; ++i)
+    if (seen[i].addr == addr && seen[i].pc == pc)
+      {
+	unsigned long n = ++seen[i].hits;
+
+	while (n >= 10 && n % 10 == 0)
+	  n /= 10;
+	if (n != 1)
+	  return;
+	fprintf (stderr, "bfin fault %#x addr 0x%08x pc 0x%08x x%lu\n",
+		 excp, addr, pc, seen[i].hits);
+	fflush (stderr);
+	return;
+      }
+
+  /* The table state is what turns an address into a diagnosis, and it is only
+     worth printing once.  The registers go with it: a faulting address says
+     where the access went, the pointer registers and the frame say how it was
+     computed, which is the difference between a bad base and a runaway
+     length.  */
+  if (nr_seen == 0)
+    {
+      int i;
+
+      bfin_mmu_dump_cplbs (cpu);
+      for (i = 0; i < 8; ++i)
+	fprintf (stderr, "bfin regs:  R%d 0x%08x  P%d 0x%08x\n",
+		 i, DREG (i), i, PREG (i));
+      {
+	bu32 fp = FPREG;
+	int off;
+
+	for (off = -16; off <= 16; off += 4)
+	  {
+	    bu32 word = 0;
+
+	    if (sim_read (CPU_STATE (cpu), fp + off, &word, 4) == 4)
+	      fprintf (stderr, "bfin regs:  [FP%+d] 0x%08x\n", off, word);
+	  }
+      }
+      /* The link record the protocol task is working from, plus its receive
+	 state at 0x005880c0 (0 = expecting a status record, 2 = expecting the
+	 announced payload).  Word 29 marks an announcement and word 30 is its
+	 length in words -- the pair that decides the checksum length.  */
+      {
+	unsigned char record[64], state[2];
+	int i;
+
+	if (sim_read (CPU_STATE (cpu), 0x00f00000, record, sizeof (record))
+	    == sizeof (record))
+	  for (i = 0; i < 32; i += 8)
+	    fprintf (stderr, "bfin link:  w%-2d %04x %04x %04x %04x"
+			     " %04x %04x %04x %04x\n", i,
+		     record[2 * i + 0] | (record[2 * i + 1] << 8),
+		     record[2 * i + 2] | (record[2 * i + 3] << 8),
+		     record[2 * i + 4] | (record[2 * i + 5] << 8),
+		     record[2 * i + 6] | (record[2 * i + 7] << 8),
+		     record[2 * i + 8] | (record[2 * i + 9] << 8),
+		     record[2 * i + 10] | (record[2 * i + 11] << 8),
+		     record[2 * i + 12] | (record[2 * i + 13] << 8),
+		     record[2 * i + 14] | (record[2 * i + 15] << 8));
+	if (sim_read (CPU_STATE (cpu), 0x005880c0, state, sizeof (state))
+	    == sizeof (state))
+	  fprintf (stderr, "bfin link:  rx state 0x%02x mode 0x%02x\n",
+		   state[0], state[1]);
+      }
+    }
+  fprintf (stderr, "bfin fault %#x addr 0x%08x pc 0x%08x %s%s %s\n",
+	   excp, addr, pc, write ? "write" : "read", inst ? " insn" : "",
+	   supv ? "supv" : "user");
+  fflush (stderr);
+
+  if (nr_seen < ARRAY_SIZE (seen))
+    {
+      seen[nr_seen].addr = addr;
+      seen[nr_seen].pc = pc;
+      seen[nr_seen].hits = 1;
+      ++nr_seen;
+    }
+}
+
 static void
