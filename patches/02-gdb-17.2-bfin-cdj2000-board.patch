+		       " arg0=0x%08x (#%lu of this kind, %lu events) t%.1f\n",
+		       kind, (unsigned) DREG (2), (unsigned) DREG (0),
+		       kind < 32 ? st_evkind[kind] : 0, st_evkind_n,
+		       bfin_sim_seconds ());
+	  }
+	else if (pc == 0xb8ea82)
+	  {
+	    if (DREG (0) != 0)
+	      fprintf (stderr, "step-trace: 0xb8ea70 refill flag [0xb3b2c0] ="
+		       " %#x -- initialising the singleton 0x6a3138 (#%lu)"
+		       " t%.1f\n", (unsigned) DREG (0), ++st_refill,
+		       bfin_sim_seconds ());
+	  }
+	else if (pc == 0xb8ac88)
+	  {
+	    ++st_evroot;
+	    if (st_evroot <= 60 || st_evroot % 500 == 0)
+	      fprintf (stderr, "step-trace: event root 0xb8ac88 r0=0x%08x"
+		       " r1=0x%08x r2=0x%08x rets=0x%08x (#%lu) t%.1f\n",
+		       (unsigned) DREG (0), (unsigned) DREG (1),
+		       (unsigned) DREG (2), (unsigned) RETSREG, st_evroot,
+		       bfin_sim_seconds ());
+	  }
+	else if (pc == 0xba4fe0)
+	  {
+	    ++st_h4fe0;
+	    fprintf (stderr, "step-trace: key arm 0xba4fe0 arg0=0x%08x key=%u"
+		     " rets=0x%08x (#%lu) t%.1f | key chain -- sends(0x10005)"
+		     " %lu of which arg0-zero %lu, handler 0xba5b6c %lu,"
+		     " arm 0xba4fe0 %lu, dispatches %lu, event root %lu,"
+		     " event targets %lu live / %lu null\n",
+		     (unsigned) DREG (0), (unsigned) DREG (2),
+		     (unsigned) RETSREG, st_h4fe0, bfin_sim_seconds (),
+		     st_send05, st_send05_zero, st_h5b6c, st_h4fe0, st_key,
+		     st_evroot, st_evcode_nz, st_evcode_zero);
+	  }
+	else if (pc == 0xbad7d8)
+	  {
+	    if (++st_cls_b <= 5 || st_cls_b % 1000 == 0)
+	      fprintf (stderr, "step-trace: class 0xbaeb6e vtable fetched"
+		       " (#%lu) t%.1f\n", st_cls_b, bfin_sim_seconds ());
+	  }
+	else if (pc == 0xbb44e2)
+	  {
+	    if (++st_cls_a <= 5 || st_cls_a % 1000 == 0)
+	      fprintf (stderr, "step-trace: class 0xbb4994 vtable fetched"
+		       " (#%lu) t%.1f\n", st_cls_a, bfin_sim_seconds ());
+	  }
+	/* r131/r132/r133 drove the same eight presses and reached this point 0,
+	   3 and 1 times.  Until that spread is explained every key run is
+	   noise, because "no change" and "the press never arrived" are the same
+	   empty window -- the ambiguity index.tsv had to solve for the frame
+	   sampler.  Three points make the chain self-reporting:
+
+	     0xb7dec8   the status parse (already counted by the census)
+	     0xb7e442   the parser's ONLY write of 0x4b43d0, the decoded source.
+			R1 already holds the three-bit value.
+	     0xb9b98c   the key dispatcher, with RETS -- it has nine static
+			callers, so the caller has to name itself the same way
+			0xb899fc's did.
+
+	   The census line is printed at every source write and every dispatch,
+	   so a key run carries its own validity statement in its own log.  */
+	else if (pc == 0xb7e442)
+	  {
+	    ++st_src;
+	    fprintf (stderr, "step-trace: source decoded 0x4b43d0 = %u (#%lu)"
+		     " t%.1f | input census -- parses %lu, source writes %lu,"
+		     " key dispatches %lu | key chain -- sends(0x10005) %lu of"
+		     " which arg0-zero %lu, handler 0xba5b6c %lu, arm 0xba4fe0"
+		     " %lu, event root %lu, event targets %lu live / %lu null\n",
+		     (unsigned) DREG (1), st_src,
+		     bfin_sim_seconds (), st_parse, st_src, st_key,
+		     st_send05, st_send05_zero, st_h5b6c, st_h4fe0,
+		     st_evroot, st_evcode_nz, st_evcode_zero);
+	  }
+	else if (pc == 0xb9b98c)
+	  {
+	    /* ++st_key must not share an argument list with st_key: the
+	       evaluation order is unspecified and the census number on this
+	       very line would be the thing in doubt.  */
+	    ++st_key;
+	    fprintf (stderr, "step-trace: key dispatcher 0xb9b98c R2=%u"
+		     " rets=0x%08x (#%lu) t%.1f | input census -- parses %lu,"
+		     " source writes %lu, key dispatches %lu\n",
+		     (unsigned) DREG (2), (unsigned) RETSREG, st_key,
+		     bfin_sim_seconds (), st_parse, st_src, st_key);
+	  }
+	else if (pc == 0xb7dec8)
+	  ++st_parse;
+	if (pc == 0xbb4994 || pc == 0xbaeb6e || pc == 0xbb468c
+	    || pc == 0xbb4696 || pc == 0xbb479e || pc == 0xbb4654
+	    || pc == 0xbb4948 || pc == 0xbb4964 || pc == 0xbb46a6
+	    || pc == 0xb9b98c || pc == 0xb7e442
+	    || pc == 0xba5b6c || pc == 0xba4fe0 || pc == 0xba5b84
+	    || pc == 0xb8ac88 || pc == 0xb8ea82)
+	  fflush (stderr);
+      }
+  }
+
+  /* BFIN_PC_HIST=<seconds> -- where the guest actually spends wall time.
+
+     r134..r137 each show two regimes with a datable boundary: about 12..19
+     status parses over the first several hundred seconds, then ~9 per second
+     until the run ends.  Every counter *upstream* of the parse is flat across
+     that boundary -- the firmware arms and the simulator answers ~23 sixty-four
+     byte receives a second in both regimes, the DMA3 ISR wakes on nearly every
+     one of them, and the firmware's own check at 0xb7c750 proves iset_flg
+     returned E_OK every single time (a non-zero return there falls into
+     `CALL 0xb81b58; JUMP.S .`, so the run would have hung instead).  The flag
+     is therefore set ~9 200 times while the task waiting on it runs 27 times.
+
+     What no breakpoint can say is what the CPU is doing instead.  This does:
+     sample the pc every 61st instruction into 1 KB buckets and print the
+     busiest twelve every <seconds> of wall clock, then reset.  The bucket is
+     coarse on purpose -- the question is which task, not which instruction.
+     The sample count is itself a measurement: samples x 61 is the number of
+     guest instructions retired in that wall interval, so a line also says
+     whether the guest sped up or merely changed what it ran.
+
+     61 rather than 64 so the sampling cannot lock on to a power-of-two loop.  */
+  {
+#define BFIN_PC_HIST_BUCKETS 16384u	/* 1 KB each: 0x00000000..0x00ffffff */
+    static int ph_initialized;
+    static double ph_interval;		/* 0 = off */
+    static double ph_next;
+    static unsigned long ph_tick;
+    static unsigned long ph_total;
+    static unsigned long ph_off;	/* samples outside the mapped window */
+    static unsigned long *ph_bucket;
+
+    if (!ph_initialized)
+      {
+	const char *value_env = getenv ("BFIN_PC_HIST");
+
+	ph_initialized = 1;
+	if (value_env && *value_env && strcmp (value_env, "0") != 0)
+	  {
+	    ph_interval = strtod (value_env, NULL);
+	    if (ph_interval <= 0.0)
+	      ph_interval = 30.0;
+	    ph_bucket = (unsigned long *) calloc (BFIN_PC_HIST_BUCKETS,
+						  sizeof (*ph_bucket));
+	    if (ph_bucket == NULL)
+	      ph_interval = 0.0;
+	    else
+	      ph_next = bfin_sim_seconds () + ph_interval;
+	  }
+      }
+
+    if (ph_interval > 0.0 && ++ph_tick % 61 == 0)
+      {
+	if (pc < (BFIN_PC_HIST_BUCKETS << 10))
+	  ++ph_bucket[pc >> 10];
+	else
+	  ++ph_off;
+	++ph_total;
+
+	if ((ph_total & 0x3ff) == 0)
+	  {
+	    double now = bfin_sim_seconds ();
+
+	    if (now >= ph_next)
+	      {
+		unsigned rank, i, besti;
+		unsigned long best;
+
+		fprintf (stderr, "pc-hist: t%.1f samples %lu (~%lu insn),"
+			 " off-map %lu --", now, ph_total, ph_total * 61,
+			 ph_off);
+		for (rank = 0; rank < 12; ++rank)
+		  {
+		    best = 0;
+		    besti = 0;
+		    for (i = 0; i < BFIN_PC_HIST_BUCKETS; ++i)
+		      if (ph_bucket[i] > best)
+			{
+			  best = ph_bucket[i];
+			  besti = i;
+			}
+		    if (best == 0)
+		      break;
+		    fprintf (stderr, " 0x%06x=%lu(%lu%%)", besti << 10, best,
+			     best * 100 / ph_total);
+		    /* Consumed: the whole array is cleared below anyway.  */
+		    ph_bucket[besti] = 0;
+		  }
+		fprintf (stderr, "\n");
+		fflush (stderr);
+		memset (ph_bucket, 0,
+			BFIN_PC_HIST_BUCKETS * sizeof (*ph_bucket));
+		ph_total = 0;
+		ph_off = 0;
+		ph_next = now + ph_interval;
+	      }
+	  }
+      }
+  }
+
+  /* Synthesise the notification the GUI never receives.
+
+     The media-state screen router FUN_00b9b706(state) decides what the screen
+     shows once a source reports its state, and it is reachable only through
+     widget message 0x10016 or 0x10005.  Neither is ever sent in emulation: the
+     image contains exactly 20 message-send sites and only the two boot screen
+     switches fire, so the router never runs and the screen stays on the
+     power-on layout with its two overlay animations.
+
+     This calls the router once, directly, so that everything downstream of it
+     is the firmware's own behaviour rather than ours.  It answers "is the
+     pre-medium screen reachable, and what does it look like" without waiting
+     for the trigger to be found, and it replaces BFIN_SKIP_WIDGET, which
+     suppressed the overlays by hand and told us nothing.
+
+     The call is injected at the event task's loop head (0xb6d0f2).  R0-R3 and
+     P0-P2 are dead there -- the next instructions reload them -- and the router
+     is an ordinary function, so it preserves everything else.  RETS is set to
+     the loop head itself, so the task simply resumes.
+
+     The wait is counted in *composited frames* (0xb7bb64), not in loop
+     iterations: the event loop blocks on a queue receive, so its head is hit
+     far too rarely to time anything by.
+
+     BFIN_FORCE_ROUTER=<state>, BFIN_FORCE_ROUTER_AFTER=<frames>.  */
+  {
+    static int fr_initialized;
+    static int fr_state = -1;
+    static unsigned long fr_after = 60;
+    static unsigned long fr_frames;
+    static int fr_fired;
+
+    if (!fr_initialized)
+      {
+	const char *value_env = getenv ("BFIN_FORCE_ROUTER");
+	const char *after_env = getenv ("BFIN_FORCE_ROUTER_AFTER");
+
+	fr_initialized = 1;
+	if (value_env && *value_env)
+	  fr_state = strtol (value_env, NULL, 0);
+	if (after_env && *after_env)
+	  fr_after = strtoul (after_env, NULL, 0);
+      }
+
+    if (fr_state >= 0 && pc == 0xb7bb64)
+      ++fr_frames;
+
+    if (fr_state >= 0 && !fr_fired && pc == 0xb6d0f2)
+      {
+	if (fr_frames >= fr_after)
+	  {
+	    fr_fired = 1;
+	    /* Optionally clear the sub-mode first.  Screen 0's splash handler
+	       writes 4 into 0x6b49e0, and FUN_00bb12a0 reacts to that by
+	       switching straight back to screen 0 -- so the router's choice is
+	       undone a moment after it is made.  Clearing the sub-mode from a
+	       record field is not possible: the only way to stop it being
+	       written is to skip screen 0 entirely, which also stops the router
+	       from selecting anything.  BFIN_CLEAR_SUBMODE=1 removes the pin
+	       after the splash has run instead.  */
+	    if (getenv ("BFIN_CLEAR_SUBMODE"))
+	      {
+		unsigned char zero[4] = { 0, 0, 0, 0 };
+
+		sim_write (CPU_STATE (cpu), 0x6b49e0, zero, sizeof (zero));
+		fprintf (stderr, "FORCE_ROUTER cleared sub-mode 0x6b49e0\n");
+	      }
+	    fprintf (stderr, "FORCE_ROUTER calling 0xb9b706(%d) after %lu\n",
+		     fr_state, fr_frames);
+	    fflush (stderr);
+	    SET_DREG (0, (bu32) fr_state);
+	    SET_RETSREG (pc);
+	    SET_PCREG (0xb9b706);
+	    BFIN_CPU_STATE.did_jump = true;
+	    return 2;
+	  }
+      }
+  }
+
+  /* Call a chosen firmware function with chosen D registers, from outside.
+
+     The GUI board has no local input path -- PORTFIO 0xffc00700 is the CFI flash
+     busy line, SPI is three init writes, UART and TWI are unused -- so every key
+     press on a real unit arrives from MAIN.  The chain that carries one is
+     widget message 0x10005, delivered through vtable slot +0x2c and dispatched
+     to FUN_00bae7a2, which passes the key on in R2 to the 16-entry dispatcher
+     FUN_00b9b98c (jump table 0xb2f2e0, index R2-1).  That chain is entirely
+     virtual, so no amount of data fed to the peer reaches it until the sender is
+     found; injecting the call directly makes the eight real keys usable now and
+     shows what each one does.
+
+     The injection point is the compositor flush 0xb7bb64, which runs exactly
+     once per composed frame.  FORCE_ROUTER's point -- the event task's loop head
+     0xb6d0f2 -- is unusable here: that task blocks on a queue receive, so its
+     head is hit only a handful of times and all of them before the frame
+     threshold, and the injection simply never fires.  0xb7bb64 is a CALL site
+     with live scratch registers, so instead of relying on dead registers this
+     saves all sixteen D/P registers and RETS, points RETS back at 0xb7bb64, and
+     restores them when execution arrives there again.  The interrupted CALL then
+     re-executes untouched, so nothing is skipped.
+
+       BFIN_INJECT="<frames>:<target>[:R<n>=<value>]...[;<frames>:<target>...]"
+
+     e.g.  BFIN_INJECT="60:0xb9b98c:R2=2"                  key 2 after 60 frames
+           BFIN_INJECT="60:0xb899fc:R0=0x6a314c:R1=7"      switch to screen 7
+           BFIN_INJECT="60:0xb9b98c:R2=2;120:0xb9b98c:R2=2"  the same key twice
+
+     0x6a314c is the constant FUN_00b8e9be returns, so the app object needs no
+     lookup.  Steps fire in the order written, each once, and never before the
+     previous one has fired.  Frames are counted at the compositor flush
+     0xb7bb64 for the same reason FORCE_ROUTER counts them there: the event loop
+     blocks on a queue receive, so its head is far too rare to time anything by.
+     BFIN_INJECT_AT=<pc> moves the injection point.  */
+  {
+#define BFIN_INJECT_STEPS 8
+    static int inj_initialized;
+    static unsigned inj_nr_steps;
+    static unsigned inj_next;
+    static unsigned long inj_frames;
+    static bu32 inj_at = 0xb7bb64;
+    static int inj_active;
+    static bu32 inj_saved_dp[16];
+    static bu32 inj_saved_rets;
+    static struct
+    {
+      unsigned long after;
+      bu32 target;
+      unsigned regs;			/* bitmask of D registers to set  */
+      bu32 value[8];
+    } inj_step[BFIN_INJECT_STEPS];
+
+    if (!inj_initialized)
+      {
+	const char *value_env = getenv ("BFIN_INJECT");
+	const char *at_env = getenv ("BFIN_INJECT_AT");
+
+	inj_initialized = 1;
+	if (at_env && *at_env)
+	  inj_at = strtoul (at_env, NULL, 0);
+	if (value_env && *value_env)
+	  {
+	    char buf[512];
+	    char *step;
+	    char *step_save = NULL;
+
+	    strncpy (buf, value_env, sizeof (buf) - 1);
+	    buf[sizeof (buf) - 1] = '\0';
+	    for (step = strtok_r (buf, ";", &step_save);
+		 step && inj_nr_steps < BFIN_INJECT_STEPS;
+		 step = strtok_r (NULL, ";", &step_save))
+	      {
+		char *field;
+		char *field_save = NULL;
+		unsigned index = 0;
+
+		field = strtok_r (step, ":", &field_save);
+		for (; field; field = strtok_r (NULL, ":", &field_save), ++index)
+		  {
+		    if (index == 0)
+		      inj_step[inj_nr_steps].after = strtoul (field, NULL, 0);
+		    else if (index == 1)
+		      inj_step[inj_nr_steps].target = strtoul (field, NULL, 0);
+		    else if ((field[0] == 'R' || field[0] == 'r')
+			     && field[1] >= '0' && field[1] <= '7'
+			     && field[2] == '=')
+		      {
+			unsigned reg = field[1] - '0';
+
+			inj_step[inj_nr_steps].regs |= 1u << reg;
+			inj_step[inj_nr_steps].value[reg] =
+			  strtoul (field + 3, NULL, 0);
+		      }
+		    else
+		      fprintf (stderr, "INJECT: ignoring field '%s'\n", field);
+		  }
+		if (inj_step[inj_nr_steps].target != 0)
+		  ++inj_nr_steps;
+	      }
+	    fprintf (stderr, "INJECT: %u step(s) at pc=%#x\n", inj_nr_steps,
+		     inj_at);
+	    fflush (stderr);
+	  }
+      }
+
+    if (inj_nr_steps && pc == 0xb7bb64)
+      ++inj_frames;
+
+    if (inj_active && pc == inj_at)
+      {
+	/* The injected call has returned.  Put the interrupted frame back
+	   exactly as it was and let its own instruction run.  */
+	unsigned reg;
+
+	for (reg = 0; reg < 8; ++reg)
+	  {
+	    SET_DREG (reg, inj_saved_dp[reg]);
+	    SET_PREG (reg, inj_saved_dp[reg + 8]);
+	  }
+	SET_RETSREG (inj_saved_rets);
+	inj_active = 0;
+	fprintf (stderr, "INJECT step %u: returned\n", inj_next - 1);
+	fflush (stderr);
+      }
+    else if (inj_next < inj_nr_steps && pc == inj_at
+	     && inj_frames >= inj_step[inj_next].after)
+      {
+	unsigned reg;
+
+	for (reg = 0; reg < 8; ++reg)
+	  {
+	    inj_saved_dp[reg] = DREG (reg);
+	    inj_saved_dp[reg + 8] = PREG (reg);
+	  }
+	inj_saved_rets = RETSREG;
+
+	for (reg = 0; reg < 8; ++reg)
+	  if (inj_step[inj_next].regs & (1u << reg))
+	    SET_DREG (reg, inj_step[inj_next].value[reg]);
+
+	fprintf (stderr, "INJECT step %u: calling %#x after %lu frames"
+		 " (R0=%#x R1=%#x R2=%#x R3=%#x)\n",
+		 inj_next, inj_step[inj_next].target, inj_frames,
+		 DREG (0), DREG (1), DREG (2), DREG (3));
+	fflush (stderr);
+
+	SET_RETSREG (inj_at);
+	SET_PCREG (inj_step[inj_next].target);
+	BFIN_CPU_STATE.did_jump = true;
+	inj_active = 1;
+	++inj_next;
+	return 2;
+      }
+  }
+
+  /* Report the argument registers at chosen call sites.  Watching framebuffer
+     stores only ever names memcpy, because the GUI composes into an off-screen
+     surface and flushes rectangles from it; the useful fact is the source
+     address passed at the call boundary, which this recovers.
+     BFIN_CALL_WATCH=<pc>[,<pc>...] (comma separated, decimal or 0x).  */
+  {
+    static int cw_initialized;
+    static bu32 cw_pcs[8];
+    static unsigned cw_nr_pcs;
+    static unsigned cw_seen;
+    static unsigned cw_limit = 200;
+
+    if (!cw_initialized)
+      {
+	const char *value_env = getenv ("BFIN_CALL_WATCH");
+
+	cw_initialized = 1;
+	if (value_env && *value_env)
+	  {
+	    char buf[256];
+	    char *tok;
+
+	    strncpy (buf, value_env, sizeof (buf) - 1);
+	    buf[sizeof (buf) - 1] = '\0';
+	    for (tok = strtok (buf, ","); tok && cw_nr_pcs < 8;
+		 tok = strtok (NULL, ","))
+	      cw_pcs[cw_nr_pcs++] = strtoul (tok, NULL, 0);
+	  }
+	value_env = getenv ("BFIN_CALL_WATCH_LIMIT");
+	if (value_env && *value_env)
+	  cw_limit = strtoul (value_env, NULL, 0);
+      }
+
+    if (cw_nr_pcs && cw_seen < cw_limit)
+      {
+	unsigned idx;
+
+	for (idx = 0; idx < cw_nr_pcs; ++idx)
+	  if (pc == cw_pcs[idx])
+	    {
+	      cw_seen++;
+	      fprintf (stderr,
+		       "CALLWATCH pc=%#x R0=%#x R1=%#x R2=%#x R3=%#x "
+		       "P0=%#x P1=%#x P2=%#x rets=%#x seen=%u disp=%lu\n",
+		       pc, DREG (0), DREG (1), DREG (2), DREG (3),
+		       PREG (0), PREG (1), PREG (2), RETSREG,
+		       cw_seen, pc_ring_total);
+	      /* A register value alone is not enough when the interesting
+		 thing is a struct being handed on.  BFIN_CALL_WATCH_DUMP=<n>
+		 also prints n bytes from wherever R1 points, which is where
+		 this firmware puts descriptor pointers by convention.  */
+	      {
+		const char *dump_env = getenv ("BFIN_CALL_WATCH_DUMP");
+
+		if (dump_env && *dump_env)
+		  {
+		    unsigned char mem[64];
+		    unsigned want = strtoul (dump_env, NULL, 0);
+		    unsigned byte;
+
+		    if (want > sizeof (mem))
+		      want = sizeof (mem);
+		    memset (mem, 0, sizeof (mem));
+		    sim_read (CPU_STATE (cpu), DREG (1), mem, want);
+		    fprintf (stderr, "  MEM@R1=%#x:", DREG (1));
+		    for (byte = 0; byte < want; ++byte)
+		      fprintf (stderr, " %02x", mem[byte]);
+		    fprintf (stderr, "\n");
+		  }
+	      }
+	      fflush (stderr);
+	      {
+		const char *snap = getenv ("BFIN_CALL_WATCH_SNAP");
+
+		if (snap && *snap)
+		  {
+		    unsigned char buf[4096];
+		    char path[1024];
+		    const char *base_env = getenv ("BFIN_CALL_WATCH_SNAP_BASE");
+		    bu32 base = base_env && *base_env
+				? strtoul (base_env, NULL, 0) : 0x50db38;
+		    bu32 total = 480 * 255 * 2;
+		    bu32 off;
+		    FILE *fp;
+
+		    snprintf (path, sizeof (path), "%s-%03u.raw", snap, cw_seen);
+		    fp = fopen (path, "wb");
+		    if (fp)
+		      {
+			for (off = 0; off < total; off += sizeof (buf))
+			  {
+			    unsigned amount = min (sizeof (buf), total - off);
+			    sim_read (CPU_STATE (cpu), base + off, buf, amount);
+			    fwrite (buf, 1, amount, fp);
+			  }
+			fclose (fp);
+		      }
+		  }
+	      }
+	      break;
+	    }
+      }
+  }
+
