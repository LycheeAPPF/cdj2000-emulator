+		       bfin_le32 (widget + 0x40), bfin_le32 (widget + 0x44),
+		       bfin_le32 (widget + 0x50));
+	      fflush (wt_stream);
+	    }
+	}
+    }
+
+  /* Draw-list tracer: make the firmware say what it draws and who draws it.
+
+     0xb7b2cc is the blit dispatcher.  Its prologue spills R0/R1/R2 into the
+     incoming-argument home slots [FP+8]/[FP+0xc]/[FP+0x10], then reads
+     W[FP+8] and W[FP+0x18] as the source and destination surface ids (both
+     bound-checked against 0x50), scales them by the 0x2c surface stride and
+     indexes 0x5080fc.  Each of the five converters is then handed
+     &surface[src], FP+0x0c, &surface[dst], FP+0x1c and [FP+0x28] -- i.e. the
+     two 12-byte rectangles bracket the destination id, and the last argument
+     is the mode.  A CALL does not push anything on Blackfin (the return
+     address goes to RETS) and LINK has not run yet at the call boundary, so
+     the callee's FP+8 is the caller's SP+0:
+
+       src id = R0            src rect = R1, R2, [SP+0x0c]
+       dst id = W[SP+0x10]    dst rect = [SP+0x14], [SP+0x18], [SP+0x1c]
+       mode   = [SP+0x20]     caller   = RETS
+
+     Only the first occurrence of each (caller, ids, rects) tuple is written,
+     so a UI repainting the same widget every frame costs a hash lookup instead
+     of a line of output.  That matters: heavy per-call tracing starves this
+     wall-clock-limited run, and the trace then faithfully describes a frame
+     the firmware never reached.  BFIN_BLIT_TRACE=<path>  */
+  if (pc == 0xb7b2cc)
+    {
+      static int bt_initialized;
+      static FILE *bt_stream;
+      static bu32 bt_keys[4096];
+      static unsigned bt_lines;
+      static unsigned bt_limit = 4000;
+
+      if (!bt_initialized)
+	{
+	  const char *path = getenv ("BFIN_BLIT_TRACE");
+	  const char *limit_env = getenv ("BFIN_BLIT_TRACE_LIMIT");
+
+	  bt_initialized = 1;
+	  if (path && *path)
+	    bt_stream = fopen (path, "w");
+	  if (limit_env && *limit_env)
+	    bt_limit = strtoul (limit_env, NULL, 0);
+	}
+
+      if (bt_stream && bt_lines < bt_limit)
+	{
+	  unsigned char stack[0x24];
+	  unsigned char frame[8];
+	  unsigned char src[BFIN_SURFACE_STRIDE], dst[BFIN_SURFACE_STRIDE];
+	  bu32 words[8];
+	  bu32 back[10];
+	  bu32 fp = FPREG;
+	  unsigned src_id = DREG (0) & 0xffff;
+	  unsigned dst_id;
+	  unsigned key = 2166136261u;
+	  unsigned slot, probe, word, level;
+
+	  memset (stack, 0, sizeof (stack));
+	  sim_read (CPU_STATE (cpu), SPREG, stack, sizeof (stack));
+	  dst_id = bfin_le16 (stack + 0x10);
+
+	  words[0] = DREG (1);
+	  words[1] = DREG (2);
+	  words[2] = bfin_le32 (stack + 0x0c);
+	  words[3] = bfin_le32 (stack + 0x14);
+	  words[4] = bfin_le32 (stack + 0x18);
+	  words[5] = bfin_le32 (stack + 0x1c);
+	  words[6] = bfin_le32 (stack + 0x20);
+	  words[7] = (src_id << 16) | dst_id;
+
+	  /* Every blit reaches the dispatcher through one wrapper, so RETS alone
+	     names that wrapper and nothing else.  LINK pushes RETS and then the
+	     old FP, so [FP+0] chains frames and [FP+4] is each frame's return
+	     address.  The compositor is several frames deep, so walk far enough
+	     to come out above it in the widget layer -- that is the whole point
+	     of this trace.  Stacks grow down, so a valid parent frame is always
+	     at a strictly higher address; that plus alignment is enough to stop
+	     the walk on garbage instead of printing it.  */
+	  memset (back, 0, sizeof (back));
+	  for (level = 0; level < ARRAY_SIZE (back); ++level)
+	    {
+	      bu32 next;
+
+	      memset (frame, 0, sizeof (frame));
+	      if (!fp || (fp & 3)
+		  || sim_read (CPU_STATE (cpu), fp, frame, sizeof (frame)) != 8)
+		break;
+	      back[level] = bfin_le32 (frame + 4);
+	      next = bfin_le32 (frame);
+	      if (next <= fp)
+		break;
+	      fp = next;
+	    }
+
+	  key = (key ^ RETSREG) * 16777619u;
+	  key = (key ^ bfin_widget_object) * 16777619u;
+	  for (level = 0; level < ARRAY_SIZE (back); ++level)
+	    key = (key ^ back[level]) * 16777619u;
+	  for (word = 0; word < ARRAY_SIZE (words); ++word)
+	    key = (key ^ words[word]) * 16777619u;
+	  key |= 1;			/* 0 marks an empty slot  */
+
+	  slot = key & (ARRAY_SIZE (bt_keys) - 1);
+	  for (probe = 0; probe < ARRAY_SIZE (bt_keys); ++probe)
+	    {
+	      unsigned at = (slot + probe) & (ARRAY_SIZE (bt_keys) - 1);
+
+	      if (bt_keys[at] == key)
+		goto blit_seen;
+	      if (bt_keys[at] == 0)
+		{
+		  bt_keys[at] = key;
+		  break;
+		}
+	    }
+
+	  if (bfin_surface_read (cpu, src_id, src)
+	      && bfin_surface_read (cpu, dst_id, dst))
+	    {
+	      /* A rectangle is {int x; int y; short w; short h} -- 12 bytes, which
+		 is exactly the gap the dispatcher leaves between its two rect
+		 pointers, and the widths it produces match the source bitmaps.  */
+	      char trace[10 * 11 + 1];
+	      unsigned used = 0;
+	      /* The source bytes *at blit time*.  Reading them out of a resource
+		 bank dump instead assumes the bank still holds what the blit
+		 read, and that assumption is exactly what needs testing: the
+		 text-label bitmaps decode to garbage from the bank while static
+		 pictures in the same bank are pixel-perfect.  */
+	      unsigned char first[16];
+	      char pixels[16 * 3 + 1];
+	      unsigned byte;
+
+	      memset (first, 0, sizeof (first));
+	      sim_read (CPU_STATE (cpu), bfin_le32 (src + BFIN_SURFACE_DATA),
+			first, sizeof (first));
+	      for (byte = 0; byte < sizeof (first); ++byte)
+		snprintf (pixels + byte * 3, 4, "%02x ", first[byte]);
+	      pixels[sizeof (pixels) - 1] = '\0';
+
+	      for (level = 0; level < ARRAY_SIZE (back) && back[level]; ++level)
+		used += snprintf (trace + used, sizeof (trace) - used, "%s%#x",
+				  level ? "," : "", back[level]);
+	      trace[used] = '\0';
+
+	      bt_lines++;
+	      fprintf (bt_stream,
+		       "BLIT widget=%#x/%#lx/%#x from=%s mode=%#x"
+		       " src=%u fmt=%u %ux%u pitch=%u data=%#lx key=%u pal=%lu"
+		       " srect=%d,%d,%dx%d"
+		       " dst=%u fmt=%u %ux%u pitch=%u data=%#lx"
+		       " drect=%d,%d,%dx%d bytes=%s\n",
+		       bfin_widget_object, bfin_widget_vtable, bfin_widget_type,
+		       trace, words[6],
+		       src_id, bfin_le16 (src + BFIN_SURFACE_FORMAT),
+		       bfin_le16 (src + BFIN_SURFACE_WIDTH),
+		       bfin_le16 (src + BFIN_SURFACE_HEIGHT),
+		       bfin_le16 (src + BFIN_SURFACE_PITCH),
+		       bfin_le32 (src + BFIN_SURFACE_DATA),
+		       src[BFIN_SURFACE_KEY],
+		       bfin_le16 (src + BFIN_SURFACE_FORMAT) == 2
+			 ? bfin_le32 (src + BFIN_SURFACE_PALETTE) : 0,
+		       (int) words[0], (int) words[1],
+		       (short) (words[2] & 0xffff), (short) (words[2] >> 16),
+		       dst_id, bfin_le16 (dst + BFIN_SURFACE_FORMAT),
+		       bfin_le16 (dst + BFIN_SURFACE_WIDTH),
+		       bfin_le16 (dst + BFIN_SURFACE_HEIGHT),
+		       bfin_le16 (dst + BFIN_SURFACE_PITCH),
+		       bfin_le32 (dst + BFIN_SURFACE_DATA),
+		       (int) words[3], (int) words[4],
+		       (short) (words[5] & 0xffff), (short) (words[5] >> 16),
+		       pixels);
+	      fflush (bt_stream);
+	    }
+	}
+    blit_seen:
+      ;
+    }
+
+  /* Dump chosen surfaces as PPMs with their live geometry.  The trigger is the
+     rectangle-flush routine's RTS, which fires far more often than once per
+     frame, so the dump is divided down and each file is overwritten -- the
+     result is the most recent state, at a bounded I/O cost.
+     BFIN_SURFACE_DUMP=<id>[,<id>...]  BFIN_SURFACE_DUMP_PREFIX=<prefix>
+     [BFIN_SURFACE_DUMP_EVERY=<n>]  [BFIN_SURFACE_DUMP_PC=<pc>]  */
+  {
+    static int sd_initialized;
+    static unsigned sd_ids[8];
+    static unsigned sd_nr;
+    static unsigned sd_every = 20;
+    static unsigned sd_hits;
+    static bu32 sd_pc = 0xb7bb64;
+    static const char *sd_prefix;
+
+    if (!sd_initialized)
+      {
+	const char *value_env = getenv ("BFIN_SURFACE_DUMP");
+
+	sd_initialized = 1;
+	sd_prefix = getenv ("BFIN_SURFACE_DUMP_PREFIX");
+	if (value_env && *value_env && sd_prefix && *sd_prefix)
+	  {
+	    char buf[256];
+	    char *tok;
+
+	    strncpy (buf, value_env, sizeof (buf) - 1);
+	    buf[sizeof (buf) - 1] = '\0';
+	    for (tok = strtok (buf, ","); tok && sd_nr < ARRAY_SIZE (sd_ids);
+		 tok = strtok (NULL, ","))
+	      sd_ids[sd_nr++] = strtoul (tok, NULL, 0);
+	  }
+	value_env = getenv ("BFIN_SURFACE_DUMP_EVERY");
+	if (value_env && *value_env)
+	  sd_every = strtoul (value_env, NULL, 0);
+	if (sd_every == 0)
+	  sd_every = 1;
+	value_env = getenv ("BFIN_SURFACE_DUMP_PC");
+	if (value_env && *value_env)
+	  sd_pc = strtoul (value_env, NULL, 0);
+      }
+
+    if (sd_nr && pc == sd_pc && ++sd_hits % sd_every == 0)
+      {
+	unsigned idx;
+
+	for (idx = 0; idx < sd_nr; ++idx)
+	  {
+	    char path[1024];
+
+	    snprintf (path, sizeof (path), "%s-surface%u.ppm", sd_prefix,
+		      sd_ids[idx]);
+	    bfin_surface_dump (cpu, sd_ids[idx], path);
+	  }
+      }
+  }
+
+  /* BFIN_ROUTER_TRACE=1 -- who opens the media-state screen router, and with
+     what.
+
+     Four points on one chain, so that a run with no picture change can still
+     say *where* it stopped:
+
+       0xb7e386   the status parser sets the edge byte 0x4b43ef, and it does so
+                  only under CC = !BITTST(W[0xf00032], 0) -- status word 25
+                  bit 0.  A hit means a record carried the edge.
+       0xbae968   the type-1 arm of 0xbae87a has just loaded B[0x4b4398+0x57].
+                  R0 is the edge byte, R4 the state 0xb9b5d6() returned.  This
+                  is the only one of the flag's readers that calls the router.
+       0xb9b706   the router itself, entered.  R0 is the state: 0 -> screen 0
+                  (the Wait platter), 1 and 2 -> screen 5 (the library),
+                  anything else matches no arm at all.
+       0xb89452   the screen switch underneath 0xb899fc.
+
+     Without this, "the screen did not move" has two readings that no frame
+     can separate -- the router never ran, or it ran and did nothing -- and
+     0x4b43ef has two other readers that consume it without calling anything
+     (0xba5796, 0xbaa78e), so the first reading is not far-fetched.  Hits are
+     counted and only the first few of each are printed, because the parser
+     point fires once per record once the edge is held.  */
+  {
+    static int rt_initialized;
+    static int rt_on;
+    static unsigned long rt_edge, rt_gate, rt_gate_open, rt_router, rt_screen;
+    static unsigned long rt_arm64, rt_handler, rt_parse;
+    static unsigned long rt_arm_status, rt_arm_payload, rt_arm_other;
+    static unsigned long rt_crc_bad, rt_isr_busy, rt_isr_wake;
+    static unsigned long rt_pend, rt_pend_ok;
+
+    if (!rt_initialized)
+      {
+	const char *value_env = getenv ("BFIN_ROUTER_TRACE");
+
+	rt_initialized = 1;
+	rt_on = value_env && *value_env && strcmp (value_env, "0") != 0;
+      }
+
+    /* The standing count: how often does the status parser actually run?
+       r092 answered it once from a write log -- 77 runs of 0xb7dec8 against
+       7 019 64-byte records handed over, 1.1 % -- and it is now the number
+       every repair is measured against, so it is counted on every run rather
+       than reconstructed afterwards.
+
+       Three points, because the 90x gap sits between two of them and nobody
+       knows which:
+
+	 0xb7c1aa with R1 == 32   a 64-byte record receive being armed.  The
+				  200-byte housekeeping loop 0xb7ef40 arms
+				  R1 == 100 and is NOT one of these; the
+				  R1 == 32 sites are a dozen states of the
+				  protocol task 0xb7eff4, each preceded by a
+				  call to the housekeeping loop.
+	 0xb7f63a                 the record handler entered.
+	 0xb7dec8                 the parse.  Unconditional once the CRC at
+				  0xb7f6be matches -- the byte test at
+				  0xb7f6d8 jumps to the call either way.
+
+       And once the run says the gap is inside the handler, the handler's own
+       four exits say which one takes the traffic.  All four are reached from
+       0xb7f63a and from nowhere else, so a plain pc count is unambiguous:
+
+	 0xb7f692   state byte 0x5880c0 == 0, the 64-byte arm -- the only one
+		    that can lead to a parse.
+	 0xb7fa06   state byte == 2, the announced-payload arm.
+	 0xb7fb6c   any other state.
+	 0xb7f994   the CRC at 0xb7f6be did not match halfword 31, which is the
+		    one branch that skips 0xb7dec8 after entering the 64-byte
+		    arm.  r109 recomputed the same CRC over the same bytes at
+		    hand-over time with 0 mismatches in 7 630 -- so a large
+		    count here is not "a corrupt frame" but the buffer changing
+		    between the hand-over and the firmware's own pass over it.
+
+       The census also prints every 5 000 handler entries, not only every 25th
+       parse: in a run where the parse is the rare event, waiting for parses to
+       accumulate is waiting for the number under investigation.
+
+       r123 put the gap between the arm and the handler -- 1 379 arms, 102
+       handler runs, 100 parses -- so the last two points are the DMA3
+       interrupt service routine 0xb7c688, which is where an arrival either
+       wakes the handler task or does not.  Its DMA3 arm reads one byte first:
+
+	 0xb7c732  R0 = B[0x5880b8]      -- 1 while a 200-byte housekeeping
+	 0xb7c734  CC = R0 == 1             receive is in flight (0xb7ef5e)
+	 0xb7c73a  B[0x5880b8] = 2       -- BUSY: mark it and return, no wake
+	 0xb7c74a  CALL 0xb9ecd4         -- WAKE: set flag 0x5881fc, pattern 1,
+					    which is the only thing 0xb7fb78
+					    pends on before calling 0xb7f63a
+
+       So a record that completes while that byte is 1 is consumed by the
+       housekeeping bookkeeping (0xb7efd2 sets the byte back to 1 and re-arms
+       the 200-byte receive) and the record handler is never told.  Counting
+       the two arms separates "the arrival never happened" from "the arrival
+       happened in the wrong window", which no frame and no dump can.  */
+    if (rt_on)
+      {
+	if (pc == 0xb7c1aa && DREG (1) == 32)
+	  ++rt_arm64;
+	else if (pc == 0xb7f692)
+	  ++rt_arm_status;
+	else if (pc == 0xb7fa06)
+	  ++rt_arm_payload;
+	else if (pc == 0xb7fb6c)
+	  ++rt_arm_other;
+	else if (pc == 0xb7f994)
+	  ++rt_crc_bad;
+	else if (pc == 0xb7c73a)
+	  ++rt_isr_busy;
+	else if (pc == 0xb7c74a)
+	  ++rt_isr_wake;
+	/* r125 measured 812 wakes against 3 handler runs at t191, so the loss is
+	   not the ISR either -- it is between the flag being set and the task
+	   0xb7fb78 acting on it.  That task is a two-instruction loop:
+
+	     0xb7fc10  CALL 0xba0670    -- pend on flag 0x5881fc, pattern 1
+	     0xb7fc18  IF !CC JUMP 0xb7fc2a   -- non-zero return: back to the
+					        top WITHOUT handling anything
+	     0xb7fc1a  (fall-through)   -- the pend returned 0
+	     0xb7fc24  CALL 0xb7f63a    -- the handler
+
+	   so counting 0xb7fc2a (one per loop iteration) against 0xb7fc1a (one
+	   per successful pend) separates "the task never gets the CPU" from
+	   "the task runs and the pend keeps failing", which is the last fork
+	   left on this path.  */
+	else if (pc == 0xb7fc2a)
+	  ++rt_pend;
+	else if (pc == 0xb7fc1a)
+	  ++rt_pend_ok;
+
+	if (pc == 0xb7f63a)
+	  ++rt_handler;
+	else if (pc == 0xb7dec8)
+	  ++rt_parse;
+
+	/* r124 parsed three records in 500 s and printed nothing after t5:
+	   waiting for the 25th parse is waiting for the number under
+	   investigation, and the 5 000th handler entry never came either.  The
+	   arm is the one point that fires in the thousands in every run, so it
+	   carries the schedule.  */
+	if ((pc == 0xb7dec8 && (rt_parse % 25 == 0 || rt_parse <= 3))
+	    || (pc == 0xb7f63a && rt_handler % 5000 == 0)
+	    || (pc == 0xb7c1aa && DREG (1) == 32 && rt_arm64 % 250 == 0))
+	  {
+	    fprintf (stderr, "router-trace: decode census -- 64-byte arms "
+		     "%lu, handler %lu, parses %lu"
+		     " (handler exits: status %lu, payload %lu, other %lu,"
+		     " crc-bad %lu; dma3 isr: busy %lu, wake %lu;"
+		     " task loops %lu, pends ok %lu)\n",
+		     rt_arm64, rt_handler, rt_parse, rt_arm_status,
+		     rt_arm_payload, rt_arm_other, rt_crc_bad, rt_isr_busy,
+		     rt_isr_wake, rt_pend, rt_pend_ok);
+	    fflush (stderr);
+	  }
+      }
+
+    if (rt_on)
+      {
+	if (pc == 0xb7e386)
+	  {
+	    if (++rt_edge <= 5 || rt_edge % 500 == 0)
+	      fprintf (stderr, "router-trace: edge seen, 0x4b43ef = 1 (#%lu)\n",
+		       rt_edge);
+	  }
+	else if (pc == 0xbae968)
+	  {
+	    ++rt_gate;
+	    if (DREG (0) == 1)
+	      ++rt_gate_open;
+	    if (rt_gate <= 5 || DREG (0) == 1 || rt_gate % 2000 == 0)
+	      fprintf (stderr,
+		       "router-trace: 0xbae87a gate flag=%u state=%u "
+		       "(#%lu, open %lu)\n",
+		       (unsigned) DREG (0), (unsigned) DREG (4), rt_gate,
+		       rt_gate_open);
+	  }
+	else if (pc == 0xb9b706)
+	  {
+	    ++rt_router;
+	    fprintf (stderr, "router-trace: 0xb9b706(state=%u) rets=0x%08x "
+		     "(#%lu)\n", (unsigned) DREG (0), (unsigned) RETSREG,
+		     rt_router);
+	  }
+	else if (pc == 0xb89452)
+	  {
+	    if (++rt_screen <= 20 || rt_screen % 100 == 0)
+	      fprintf (stderr, "router-trace: screen switch 0xb89452 (#%lu)"
+		       " rets=0x%08x t%.1f\n",
+		       rt_screen, (unsigned) RETSREG, bfin_sim_seconds ());
+	  }
+	/* Who switches the screen when the router does not?
+	   r118 and r120 reached screen 5 with 0xb9b706 provably never running,
+	   so a second path exists and it is unnamed.  0xb89452 has two callers,
+	   0xb8980a and 0xb89992, and 0xb8980a's only caller is this one:
+
+	     0xb899fc  (container, screen)  -- R1 is the screen number, the same
+					       R1 = 0x5 the library arms pass
+	     0xb89a06  CALL 0xb899c8        -- look the screen widget up
+	     0xb89a16  CALL 0xb8980a        -- and swap it in
+
+	   0xb899fc has upward of thirty static callers, so enumerating them is
+	   the wrong move: RETS at its entry names the one that actually ran, in
+	   one line, and there were only two switches in 400 s of r122.  0xb89992
+	   is the other direct caller and has no static caller at all -- it is
+	   reached indirectly -- so it gets its own point.  */
+	else if (pc == 0xb899fc)
+	  fprintf (stderr, "router-trace: 0xb899fc(screen=%u, R0=0x%08x)"
+		   " rets=0x%08x t%.1f\n",
+		   (unsigned) DREG (1), (unsigned) DREG (0),
+		   (unsigned) RETSREG, bfin_sim_seconds ());
+	else if (pc == 0xb89992)
+	  fprintf (stderr, "router-trace: 0xb89992 rets=0x%08x t%.1f\n",
+		   (unsigned) RETSREG, bfin_sim_seconds ());
+	/* The sub-mode pin, on the path that actually runs.
+
+	   r128 named the live router: 0xbb466c indexes 0xb35534 with status
+	   halfword 13, and its arm for 0 is 0xbb4708 -- screen 0, the Wait
+	   platter.  Two instructions before it switches, that arm writes the
+	   sub-mode pin:
+
+	     0xbb4712  R1 = 0x4
+	     0xbb4714  [0x6b49e0] = R1
+	     0xbb4718  CALL 0xb899fc   (screen 0)
+
+	   BFIN_CLEAR_SUBMODE already existed but sat inside the BFIN_FORCE_ROUTER
+	   block, so it could only fire in a run that forced the router by hand --
+	   it has never been measured against this path, because this path was not
+	   known.  Zeroing R1 at the store leaves the arm, the switch and the
+	   screen exactly as they are and removes only the pin, which is the one
+	   variable worth changing on its own.  */
+	if (pc == 0xbb4714)
+	  {
+	    static int cs_initialized, cs_on;
+	    static unsigned long cs_hits;
+
+	    if (!cs_initialized)
+	      {
+		const char *env = getenv ("BFIN_CLEAR_SUBMODE");
+
+		cs_initialized = 1;
+		cs_on = env && *env && strcmp (env, "0") != 0;
+	      }
+	    if (cs_on)
+	      {
+		SET_DREG (1, 0);
+		fprintf (stderr, "router-trace: sub-mode pin 0x6b49e0 held at 0"
+			 " instead of 4 (#%lu, t%.1f)\n",
+			 ++cs_hits, bfin_sim_seconds ());
+		fflush (stderr);
+	      }
+	  }
+	if (pc == 0xb7e386 || pc == 0xbae968 || pc == 0xb9b706
+	    || pc == 0xb89452)
+	  fflush (stderr);
+      }
+  }
+
+  /* BFIN_RECORD_TRACE=<seconds> -- every gate the record handler 0xb7f63a
+     walks between "a 64-byte record was checksummed" and "a payload receive is
+     armed", counted where the firmware makes the decision.
+
+     r177 measured the hole from the other side: MAIN answered 2 395 times with
+     a 224-byte record in 300 s and the firmware armed a 224-byte receive
+     **twice**, with an announcement outstanding on 4 736 of 4 789 status
+     handovers.  Decoding r177's own BFIN_MAIN_LINK_DUMP against the firmware's
+     gates says every one of those records should have armed one: halfword 31
+     matches the CRC on 5 203 of 5 203, halfword 19 bit 15 is never set,
+     halfword 13 is 0, halfword 29 is 1 or 9 and halfword 30 is 0x50 or 0x70.
+     So the record is not the problem and the loss is inside the handler --
+     but which branch, and how often the handler runs at all, is exactly what
+     no dump can say.
+
+     The chain, read out of the GUI disassembly, with the value already in a
+     register at each point:
+
+       0xb7f63a  the handler entered
+       0xb7f692 / 0xb7fa06 / 0xb7fb6c   receive state 0 / 2 / other
+       0xb7f994  halfword 31 != the CRC over the first 62 bytes
+       0xb7dec8  the parse
+       0xb7f704  halfword 19 bit 15 SET -- retry, the announcement is never
+                 looked at
+       0xb7f7fc  halfword 13 low byte == 2 -- the eight-word arm instead
+       0xb7f884  the announcement test reached
+       0xb7f898  R0 = halfword 29 & 0x7fff; zero means "no announcement"
+       0xb7f8d2  R0 = halfword 30; 1..2048 or the announcement is refused
+       0xb7f8ec  R1 = halfword 30, the payload receive being armed
+       0xb7f904  the refusal
+       0xb7fa56 / 0xb7fafa   the delivered payload's own checksum, ok or not
+       0xb7faba  the payload handed to its consumer 0xb7eb48
+
+     Plus the two points r123/r125 named as the gap between an arm and the
+     handler, because a handler that never runs explains all of it at once:
+     0xb7c73a (the DMA3 ISR found the housekeeping receive in flight and
+     returned without waking anybody) and 0xb7c74a (it woke the task).
+
+     Counting only; nothing here changes what the firmware sees.  Unset or 0
+     disables it and the run is byte-for-byte the old one.  */
+  {
+    static int rec_initialized;
+    static double rec_every, rec_next;
+    static unsigned long rec_arm64, rec_armother, rec_handler, rec_parse;
+    static unsigned long rec_st0, rec_st2, rec_stx, rec_crcbad;
+    static unsigned long rec_gate19, rec_gate13, rec_anntest;
+    static unsigned long rec_annzero, rec_annnz, rec_w30ok, rec_w30bad;
+    static unsigned long rec_payarm, rec_payrej, rec_payok, rec_paybad;
+    static unsigned long rec_payuse, rec_isrbusy, rec_isrwake;
+    static unsigned long rec_pend, rec_pendok, rec_pendfail;
+    static unsigned rec_lastann, rec_lastw30;
