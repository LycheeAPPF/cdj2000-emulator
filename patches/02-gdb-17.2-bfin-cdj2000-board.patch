+void
+bfin_trace_gui_state_write (SIM_CPU *cpu, bu32 addr, bu32 value,
+			    unsigned bytes)
+{
+  static int initialized;
+  static bu32 start;
+  static bu32 end;
+  static unsigned limit = 100000;
+  static unsigned nr_writes;
+
+  if (!initialized)
+    {
+      const char *value_env = getenv ("BFIN_GUI_STATE_WRITE_START");
+
+      initialized = 1;
+      if (value_env && *value_env)
+	start = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_GUI_STATE_WRITE_END");
+      if (value_env && *value_env)
+	end = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_GUI_STATE_WRITE_LIMIT");
+      if (value_env && *value_env)
+	limit = strtoul (value_env, NULL, 0);
+    }
