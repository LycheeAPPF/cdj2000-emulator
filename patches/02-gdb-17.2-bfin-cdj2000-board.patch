+		if (st_evcode_nz <= 200 || st_evcode_nz % 500 == 0)
+		  fprintf (stderr, "step-trace: event target [evt+4] = %#x"
+			   " (#%lu with a target, %lu without) t%.1f\n",
+			   (unsigned) DREG (0), st_evcode_nz, st_evcode_zero,
