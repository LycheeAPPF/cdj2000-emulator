+  /* BFIN_STEP_TRACE=1 -- what drives [0xb5dbe0], and does any widget message
+     reach the two dispatchers that can move the screen.
+
+     0xbb466c is the live router r128 found, and it has two branches.  Which
+     one runs is decided by a single word:
+
+       0xbb468a  R0 = [0xb5dbe0]
+       0xbb468e  CC = 6 <= R0
+       0xbb4692  IF !CC JUMP 0xbb46f2   -- < 6: the six-step sequence, whose
+					   arms show and hide child widgets
+					   6,5,4,3,2,1 and NEVER call 0xb899fc
+       0xbb4694  R0 = [0xb5dbec]        -- >= 6: the word-13 table, but only
+       0xbb4696  CC = R0 == 1              while this flag is 1, and 0xbb4726
+       0xbb4698  IF CC JUMP 0xbb46a6       clears it again on the way out
+
