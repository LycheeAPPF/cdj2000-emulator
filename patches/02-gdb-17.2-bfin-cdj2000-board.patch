+{
+  static int enabled = -1;
+  static int housekeeping_enabled = -1;
+  static int bootstrap_enabled = -1;
+  static bu32 custom_start;
+  static bu32 custom_end;
+  static bu32 pcs[65536];
+  static bu32 addrs[65536];
+  static unsigned nr_reads;
+  bu32 pc;
+  unsigned i;
