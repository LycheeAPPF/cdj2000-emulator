+#elif defined (_WIN32)
+
+/* A dependency-free fallback for native Windows builds.  GNU sim normally
+   uses SDL for the PPI display, but the MinGW build used by the CDJ GUI lab
+   has no SDL development package.  The old inline stubs returned zero from
+   bfin_gui_update, which made the DMA engine retry the first scanline
+   forever.  This backend accepts the real scanlines and publishes complete
+   frames as binary PPM files.  A small Windows viewer can consume the file
+   without coupling the firmware simulator to a UI toolkit.  */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <windows.h>
+
+struct gui_state
+{
+  unsigned char *rgb;
+  unsigned char *raw;
+  /* The last frame actually written out, so an unchanged one can be skipped.
+     The PPI rescans the framebuffer ~20-30 times a second whether or not the
+     firmware has drawn anything; measured 2026-08-07, the *picture* changes
+     about 0.08 times a second while the file was being rewritten about 20
+     times a second.  Each rewrite is 367 KB plus a MOVEFILE_WRITE_THROUGH
+     rename, so more than 99% of that I/O was republishing an identical
+     image -- and it was the host cost that swallowed the idle-skip's gain.  */
+  unsigned char *published;
+  int have_published;
+  char *output_path;
+  char *raw_output_path;
+  char *best_output_path;
+  char *detail_output_path;
+  int width;
+  int height;
+  int curr_line;
+  int bytes_per_pixel;
+  enum gui_color color;
+  unsigned long frame_score;
+  unsigned long best_score;
+  unsigned long frame_detail;
+  unsigned long best_detail;
+};
+
+static const struct
+{
+  const char *name;
+  int bytes_per_pixel;
+  enum gui_color color;
+} color_spaces[] =
+{
+  { "rgb555le", 2, GUI_COLOR_RGB_555_LE, },
+  { "rgb565",   2, GUI_COLOR_RGB_565,   },
+  { "bgr565",   2, GUI_COLOR_BGR_565,   },
+  { "rgb888",   3, GUI_COLOR_RGB_888,   },
+  { "bgr888",   3, GUI_COLOR_BGR_888,   },
+  { "rgba8888", 4, GUI_COLOR_RGBA_8888, },
+};
+
+enum gui_color
+bfin_gui_color (const char *color)
+{
+  int i;
+
+  if (color)
+    for (i = 0; i < ARRAY_SIZE (color_spaces); ++i)
+      if (!strcmp (color, color_spaces[i].name))
+	return color_spaces[i].color;
+
+  return GUI_COLOR_RGB_565;
+}
+
+int
+bfin_gui_color_depth (enum gui_color color)
+{
+  int i;
+
+  for (i = 0; i < ARRAY_SIZE (color_spaces); ++i)
+    if (color == color_spaces[i].color)
+      return color_spaces[i].bytes_per_pixel * 8;
+
+  return 16;
+}
+
+static int
+bfin_gui_default_height (void)
+{
+  const char *value = getenv ("BFIN_GUI_HEIGHT");
+  char *end;
+  long height;
+
+  if (!value || !*value)
+    return 255;
+
+  height = strtol (value, &end, 0);
+  if (*end || height <= 0 || height > 4096)
+    return 255;
+
+  return height;
+}
+
+void *
+bfin_gui_setup (void *state, int enabled, int width, int height,
+		enum gui_color color)
+{
+  struct gui_state *gui = state;
+  const char *output_path;
+  int bytes_per_pixel;
+
+  if (!enabled)
+    {
+      if (gui)
+	{
+	  free (gui->rgb);
+	  free (gui->raw);
+	  free (gui->output_path);
+	  free (gui->raw_output_path);
+	  free (gui->best_output_path);
+	  free (gui->detail_output_path);
+	  free (gui);
+	}
+      return NULL;
+    }
+
+  if (gui)
+    return gui;
+
+  /* The board file's "color" property never reaches us: machs.c creates and
+     finishes bfin_ppi@0 before --hw-board-file is parsed, so the device's
+     finish() reads no "color" and falls back to RGB565.  The CDJ-2000 panel is
+     little-endian RGB555 (the firmware packs the palette at 0xb7b9d8 with
+     DEPOSIT field specs 0xa05/0x505/0x5 — red at bit 10, green at 5, blue at 0
+     — then clears bit 15), and decoding that as RGB565 turns every
+     palette-blitted background into green/pink streaks.  Allow an explicit
+     override that is applied at the point the format is actually used.  */
+  {
+    const char *color_env = getenv ("BFIN_GUI_COLOR");
+
+    if (color_env && *color_env)
+      color = bfin_gui_color (color_env);
+  }
+
+  bytes_per_pixel = bfin_gui_color_depth (color) / 8;
+  if (width <= 0 || width > 8192 || bytes_per_pixel <= 0)
+    return NULL;
+  if (height <= 0)
+    height = bfin_gui_default_height ();
+
+  output_path = getenv ("BFIN_GUI_OUTPUT");
+  if (!output_path || !*output_path)
+    output_path = "bfin-gui.ppm";
+
+  gui = XNEW (struct gui_state);
+  gui->width = width;
+  gui->height = height;
+  gui->curr_line = 0;
+  gui->bytes_per_pixel = bytes_per_pixel;
+  gui->color = color;
+  if (getenv ("BFIN_GUI_TRACE"))
+    fprintf (stderr, "GUI setup width=%d height=%d color=%d bpp=%d\n",
+	     width, height, color, bytes_per_pixel);
+  gui->output_path = xstrdup (output_path);
+  output_path = getenv ("BFIN_GUI_RAW_OUTPUT");
+  gui->raw_output_path = output_path && *output_path
+			 ? xstrdup (output_path) : NULL;
+  output_path = getenv ("BFIN_GUI_BEST_OUTPUT");
+  gui->best_output_path = output_path && *output_path
+			  ? xstrdup (output_path) : NULL;
+  output_path = getenv ("BFIN_GUI_DETAIL_OUTPUT");
+  gui->detail_output_path = output_path && *output_path
+			    ? xstrdup (output_path) : NULL;
+  gui->rgb = XNEWVEC (unsigned char, (size_t) width * height * 3);
+  gui->raw = XNEWVEC (unsigned char,
+		     (size_t) width * height * bytes_per_pixel);
+  gui->published = XNEWVEC (unsigned char, (size_t) width * height * 3);
+  gui->have_published = 0;
+  memset (gui->rgb, 0, (size_t) width * height * 3);
+  memset (gui->raw, 0, (size_t) width * height * bytes_per_pixel);
+  gui->frame_score = 0;
+  gui->best_score = 0;
+  gui->frame_detail = 0;
+  gui->best_detail = 0;
+  return gui;
+}
+
+static void
+bfin_gui_convert_line (struct gui_state *gui, const unsigned char *source)
+{
+  unsigned char *dest = gui->rgb + (size_t) gui->curr_line * gui->width * 3;
+  unsigned long previous = 0;
+  int x;
+
+  for (x = 0; x < gui->width; ++x)
+    {
+      unsigned r, g, b;
+      unsigned char *pixel_dest = dest;
+
+      if (gui->color == GUI_COLOR_RGB_555_LE)
+	{
+	  unsigned pixel = source[0] | ((unsigned) source[1] << 8);
+
+	  r = (pixel >> 10) & 0x1f;
+	  g = (pixel >> 5) & 0x1f;
+	  b = pixel & 0x1f;
+	  *dest++ = (r << 3) | (r >> 2);
+	  *dest++ = (g << 3) | (g >> 2);
+	  *dest++ = (b << 3) | (b >> 2);
+	}
+      else if (gui->color == GUI_COLOR_RGB_565
+	  || gui->color == GUI_COLOR_BGR_565)
+	{
+	  /* Match SDL_ConvertBlitLineFrom above: the PPI presents RGB565
+	     pixels most-significant byte first.  BGR565 has Rshift == 0 in
+	     the SDL format and is assembled least-significant byte first.  */
+	  unsigned pixel = gui->color == GUI_COLOR_RGB_565
+			   ? ((unsigned) source[0] << 8) | source[1]
+			   : source[0] | ((unsigned) source[1] << 8);
+	  unsigned hi = (pixel >> 11) & 0x1f;
+	  unsigned lo = pixel & 0x1f;
+
+	  g = (pixel >> 5) & 0x3f;
+	  if (gui->color == GUI_COLOR_RGB_565)
+	    {
+	      r = hi;
+	      b = lo;
+	    }
+	  else
+	    {
+	      r = lo;
+	      b = hi;
+	    }
+
+	  *dest++ = (r << 3) | (r >> 2);
+	  *dest++ = (g << 2) | (g >> 4);
+	  *dest++ = (b << 3) | (b >> 2);
+	}
+      else
+	{
+	  if (gui->color == GUI_COLOR_BGR_888)
+	    {
+	      b = source[0];
+	      g = source[1];
+	      r = source[2];
+	    }
+	  else
+	    {
+	      r = source[0];
+	      g = source[1];
+	      b = source[2];
+	    }
+	  *dest++ = r;
+	  *dest++ = g;
+	  *dest++ = b;
+	}
+
+      {
+	unsigned long pixel = ((unsigned long) pixel_dest[0] << 16)
+			      | ((unsigned long) pixel_dest[1] << 8)
+			      | pixel_dest[2];
+	if (pixel)
+	  gui->frame_score++;
+	if (pixel != previous)
+	  {
+	    gui->frame_score += 64;
+	    gui->frame_detail++;
+	  }
+	previous = pixel;
+      }
+
+      source += gui->bytes_per_pixel;
+    }
+}
+
+static void
+bfin_gui_write_frame_to (struct gui_state *gui, const char *output_path)
+{
+  size_t path_len = strlen (output_path);
+  char *temporary = XNEWVEC (char, path_len + 5);
+  FILE *stream;
+
+  memcpy (temporary, output_path, path_len);
+  memcpy (temporary + path_len, ".tmp", 5);
+  stream = fopen (temporary, "wb");
+  if (stream)
+    {
+      fprintf (stream, "P6\n%d %d\n255\n", gui->width, gui->height);
+      fwrite (gui->rgb, 3, (size_t) gui->width * gui->height, stream);
+      if (!fclose (stream))
+	MoveFileExA (temporary, output_path,
+		     MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+    }
+  free (temporary);
+}
+
+/* The CDJ-2000 jog-wheel LCD is a physically separate display, but this
+   firmware composites its "vinyl platter + status" widget (e.g. the "Wait"
+   disc) into the main framebuffer.  Extract that rectangle from the finished
+   RGB frame to its own PPM so it can be driven independently, and optionally
+   blank it on the main output.  Operating on the composed frame keeps this out
+   of the entangled render pipeline.
+     BFIN_JOG_RECT="x,y,w,h"  BFIN_JOG_OUTPUT=<path>  [BFIN_JOG_BLANK=1]  */
+static void
+bfin_gui_handle_jog (struct gui_state *gui)
+{
+  static int initialized;
+  static int enabled;
+  static int jx, jy, jw, jh, blank;
+  static char out_path[1024];
+
+  if (!initialized)
+    {
+      const char *rect = getenv ("BFIN_JOG_RECT");
+      const char *out = getenv ("BFIN_JOG_OUTPUT");
+
+      initialized = 1;
+      if (rect && *rect && out && *out
+	  && sscanf (rect, "%d,%d,%d,%d", &jx, &jy, &jw, &jh) == 4
+	  && jw > 0 && jh > 0)
+	{
+	  strncpy (out_path, out, sizeof (out_path) - 1);
+	  out_path[sizeof (out_path) - 1] = '\0';
+	  blank = getenv ("BFIN_JOG_BLANK") != NULL;
+	  enabled = 1;
+	}
+    }
+  if (!enabled)
+    return;
+
+  {
+    int x0 = jx < 0 ? 0 : jx;
+    int y0 = jy < 0 ? 0 : jy;
+    int x1 = jx + jw > gui->width ? gui->width : jx + jw;
+    int y1 = jy + jh > gui->height ? gui->height : jy + jh;
+    int w = x1 - x0;
+    int h = y1 - y0;
+    int x, y;
+
+    if (w <= 0 || h <= 0)
+      return;
+
+    {
+      size_t path_len = strlen (out_path);
+      char *temporary = XNEWVEC (char, path_len + 5);
+      FILE *stream;
+
+      memcpy (temporary, out_path, path_len);
+      memcpy (temporary + path_len, ".tmp", 5);
+      stream = fopen (temporary, "wb");
+      if (stream)
+	{
+	  fprintf (stream, "P6\n%d %d\n255\n", w, h);
+	  for (y = y0; y < y1; ++y)
+	    fwrite (gui->rgb + ((size_t) y * gui->width + x0) * 3, 3, w, stream);
+	  if (!fclose (stream))
+	    MoveFileExA (temporary, out_path,
+			 MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+	}
+      free (temporary);
+    }
+
+    if (blank)
+      for (y = y0; y < y1; ++y)
+	for (x = x0; x < x1; ++x)
+	  {
+	    unsigned char *p = gui->rgb + ((size_t) y * gui->width + x) * 3;
+
+	    p[0] = p[1] = p[2] = 0;
+	  }
+  }
+}
+
+static void
+bfin_gui_write_raw_frame (struct gui_state *gui)
+{
+  FILE *stream;
+
+  if (!gui->raw_output_path)
+    return;
+  stream = fopen (gui->raw_output_path, "wb");
+  if (stream)
+    {
+      fwrite (gui->raw, gui->bytes_per_pixel,
+	      (size_t) gui->width * gui->height, stream);
+      fclose (stream);
+    }
+}
+
+unsigned
+bfin_gui_update (void *state, const void *source, unsigned nr_bytes)
+{
+  struct gui_state *gui = state;
+  size_t line_bytes;
+
+  /* A disconnected display must still consume PPI output.  Returning zero is
+     DMA backpressure and was the reason the unmodified simulator never
+     advanced beyond the first scanline.  */
+  if (!gui)
+    return nr_bytes;
+
+  line_bytes = (size_t) gui->width * gui->bytes_per_pixel;
+  if (nr_bytes < line_bytes)
+    return 0;
+
+  memcpy (gui->raw + (size_t) gui->curr_line * line_bytes,
+	  source, line_bytes);
+  bfin_gui_convert_line (gui, source);
+  if (++gui->curr_line == gui->height)
+    {
+      /* BFIN_GUI_FRAME_TRACE: how many frames the compositor has *completed*,
+	 which is the one thing a frame sampler cannot see.  A screen whose
+	 bytes stop changing and a compositor that has stopped publishing look
+	 identical from outside -- r105 and r106 both stand still from ~t180
+	 while MAIN keeps taking 7 000 requests, and a late press of the one bit
+	 known to redraw (18.3, r096) moved nothing.  This line separates "the
+	 picture is static" from "the drawing task is gone" without a
+	 breakpoint.  */
+      {
+	extern double bfin_sim_seconds (void);	/* dv-bfin_cec.c */
+	static int enabled = -1;
+	static unsigned long frames;
+	static double next;
+
+	if (enabled < 0)
+	  enabled = (getenv ("BFIN_GUI_FRAME_TRACE") != NULL);
+	if (enabled)
+	  {
+	    double now = bfin_sim_seconds ();
+
+	    frames++;
+	    if (now >= next)
+	      {
+		fprintf (stderr, "gui frames %lu completed at t%.1f\n",
+			 frames, now);
+		fflush (stderr);
+		next = now + 20.0;
+	      }
+	  }
+      }
+      gui->curr_line = 0;
+      bfin_gui_handle_jog (gui);
+      /* Only publish a picture that is not the one already on disk.  A viewer
+	 watching the file for changes sees exactly the same sequence of
+	 images; what it stops seeing is the same image over and over.
+	 BFIN_GUI_WRITE_EVERY_FRAME=1 restores the unconditional write for a
+	 run that wants every scan on disk.  */
+      {
+	size_t bytes = (size_t) gui->width * gui->height * 3;
+	static int always = -1;
+
+	if (always < 0)
+	  {
+	    const char *env = getenv ("BFIN_GUI_WRITE_EVERY_FRAME");
+
+	    always = env && *env;
+	  }
+	if (always || !gui->have_published
+	    || memcmp (gui->rgb, gui->published, bytes) != 0)
+	  {
+	    memcpy (gui->published, gui->rgb, bytes);
+	    gui->have_published = 1;
+	    bfin_gui_write_frame_to (gui, gui->output_path);
+	    bfin_gui_write_raw_frame (gui);
+	  }
+      }
+      if (gui->best_output_path && gui->frame_score > gui->best_score)
+	{
+	  gui->best_score = gui->frame_score;
+	  bfin_gui_write_frame_to (gui, gui->best_output_path);
+	}
+      if (gui->detail_output_path && gui->frame_detail > gui->best_detail)
+	{
+	  gui->best_detail = gui->frame_detail;
+	  bfin_gui_write_frame_to (gui, gui->detail_output_path);
+	}
+      gui->frame_score = 0;
+      gui->frame_detail = 0;
+    }
+
+  return nr_bytes;
+}
