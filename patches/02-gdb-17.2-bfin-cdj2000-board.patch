+			   st_send05_zero, bfin_sim_seconds ());
+	      }
+	    else if (st_send <= 80 || st_send % 2000 == 0)
+	      fprintf (stderr, "step-trace: send 0xb8a3fa target=0x%08x"
+		       " code=%#x arg0=0x%08x rets=0x%08x (#%lu) t%.1f\n",
+		       (unsigned) DREG (1), (unsigned) DREG (2),
+		       (unsigned) DREG (0), (unsigned) RETSREG, st_send,
+		       bfin_sim_seconds ());
+	  }
+	/* THE THREE STAGES ABOVE THE KEY DISPATCHER.
