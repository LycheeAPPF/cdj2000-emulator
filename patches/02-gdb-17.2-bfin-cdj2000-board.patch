+#endif
+
+static void bfin_sport_peer_trace (struct bfin_sport *sport, const char *event,
+				   unsigned value);
+
+/* Connect one non-blocking TCP client socket to host:port.  */
+
+static int
+bfin_sport_link_connect (const char *host, unsigned port)
+{
+  struct sockaddr_in address;
+  int fd;
+
+  fd = (int) socket (AF_INET, SOCK_STREAM, 0);
+  if (fd < 0)
+    return -1;
+
+  memset (&address, 0, sizeof (address));
+  address.sin_family = AF_INET;
+  address.sin_port = htons ((unsigned short) port);
+  address.sin_addr.s_addr = inet_addr (host);
+
+  if (connect (fd, (struct sockaddr *) &address, sizeof (address)) != 0)
+    {
+      closesocket (fd);
+      return -1;
+    }
+
+#ifdef _WIN32
+  {
+    u_long nonblocking = 1;
+    ioctlsocket (fd, FIONBIO, &nonblocking);
+  }
+#else
+  {
+    int flags = fcntl (fd, F_GETFL, 0);
+    fcntl (fd, F_SETFL, flags | O_NONBLOCK);
+  }
+#endif
+  return fd;
+}
+
+/* BFIN_MAIN_LINK=host:port.  Opened lazily so the MAIN machine has time to
+   come up and start listening; a failed attempt is retried on the next
+   transfer rather than being fatal.  */
+
+static void
+bfin_sport_link_open (struct bfin_sport *sport)
+{
+  const char *spec = getenv ("BFIN_MAIN_LINK");
+  char host[64];
+  const char *colon;
+  unsigned port;
+
+  if (spec == NULL || *spec == '\0')
+    return;
+
+  colon = strrchr (spec, ':');
+  if (colon == NULL || (size_t) (colon - spec) >= sizeof (host))
+    return;
+  memcpy (host, spec, colon - spec);
+  host[colon - spec] = '\0';
+  port = (unsigned) strtoul (colon + 1, NULL, 0);
+
+#ifdef _WIN32
+  {
+    static int started;
+    if (!started)
+      {
+	WSADATA data;
+	WSAStartup (MAKEWORD (2, 2), &data);
+	started = 1;
+      }
+  }
+#endif
+
+  sport->link_request_fd = bfin_sport_link_connect (host, port);
+  sport->link_record_fd = bfin_sport_link_connect (host, port + 2);
+  if (sport->link_request_fd >= 0 && sport->link_record_fd >= 0)
+    {
+      sport->link_opened = 1;
+      bfin_sport_peer_trace (sport, "link-open", port);
+    }
+  else
+    {
+      if (sport->link_request_fd >= 0)
+	closesocket (sport->link_request_fd);
+      if (sport->link_record_fd >= 0)
+	closesocket (sport->link_record_fd);
+      sport->link_request_fd = sport->link_record_fd = -1;
+    }
+}
+
+/* Split the staging buffer into whole frames, keeping only the newest frame of
+   each length.
+
+   A queue is the wrong model here and was tried first: MAIN sends its 224-byte
+   records in bursts the GUI only occasionally reads, the unread ones pile up,
+   the socket fills, and `qemu_chr_fe_write_all' then blocks the whole MAIN
+   board -- which loses its ten-second GuiCom startup race and stops sending
+   almost entirely.  One slot per length instead keeps the socket drained and
+   matches the wire, which carries MAIN's latest record of each kind and
+   nothing older.  */
+
+/* Whether the yield budget is granted only for the 64-byte status record.
+
+   It is, and the obvious complaint about that is real: the budget is what lets
+   the housekeeping poll loop at 0xb7ef40 give the shared DMA channel back, so a
+   record length that never earns a budget never wins the channel, and over one
+   600 s run (r083) MAIN put 7 187 records on the wire while the GUI received 46
+   of the 48-byte payloads and 2 of the 224-byte ones against 8 429 handovers of
+   the same 64-byte status record.
+
+   Granting the budget to every length is nevertheless **much worse**, and that
+   is why it is opt-in.  Measured, one binary, same card, 600 s each:
+
+     r083  neither switch (this default)                8 289 requests
+     r086  BFIN_LINK_YIELD_ANY=1                          427 requests
+     r084  BFIN_LINK_YIELD_ANY=1 + CDJ_LINK_RX_ONESHOT=1 1 508 requests
+     r085  CDJ_LINK_RX_ONESHOT=1 alone                       10 requests
+
+   r086 never even reached the SD source: all 428 status records it delivered
+   still carry word 18 = 4 (LINK).  Refusing the housekeeping read for a payload
+   the GUI is not waiting for does not hand the channel to the record path, it
+   just stops the board.  The right fix has to keep an announcement and its
+   payload together, which one slot per length cannot do -- see the chapter in
+   CONTINUE_MAIN_RE.md.  */
+
+static int
+bfin_sport_link_yield_status_only (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = getenv ("BFIN_LINK_YIELD_ANY") == NULL;
+  return cached;
+}
+
+/* BFIN_LINK_W30_TRACE: watch the two halfwords the payload transaction turns on,
+   in the bytes actually handed to the firmware.
+
+   This is a measurement, not a repair, and it exists to settle one question
+   before anything is built on it: **is the halfword 30 that `0xb7fa24` reads
+   back a different one from the halfword 30 that `0xb7f8ce` validated?**  The
+   fault dump proves only the end state (`w30 = 0` while the receive state says
+   a payload was announced); it cannot show that a non-zero value was there
+   first.  A line per *change* can, and costs nothing between changes.
+
+   Halfword 29 (`0x00f0003a`) is the announcement marker and halfword 30
+   (`0x00f0003c`) its word count, so the pair says both "this record announces"
+   and "this many words".  The run length carries the rest of the argument: an
+   announcement that survives one delivery and is replaced by a plain record
+   before the firmware comes back is exactly the race, spelled out.  */
+
+static bu16 bfin_sport_peer_crc (const unsigned char *, size_t);
+
+static void
+bfin_sport_link_trace_w30 (const unsigned char *record, const char *how)
+{
+  static int enabled = -1;
+  static unsigned w13, w19, w29, w30;
+  static unsigned long run, total, bad_crc;
+  static int have;
+  unsigned now13, now19, now29, now30;
+  unsigned stored, computed;
+
+  if (enabled < 0)
+    enabled = (getenv ("BFIN_LINK_W30_TRACE") != NULL);
+  if (!enabled)
+    return;
+
+  /* Halfword 13 decides whether the announcement is even looked at: 0xb7f7f4
+     reads its low byte and a 2 diverts to the eight-word arm at 0xb7f872, which
+     sets receive state 2 with no announcement at all.  It belongs in the same
+     line as the pair it gates.  */
+  now13 = record[26] | (record[27] << 8);
+  /* Halfword 19 bit 15 is the gate that decides whether the announcement is
+     ever acted on: 0xb7f700 tests it and, when it is SET, the task bumps a
+     retry counter, re-arms a 64-byte receive, sends its next request and
+     returns -- it never reaches the announcement test at 0xb7f884.  Only when
+     MAIN clears it does the payload get fetched.  */
+  now19 = record[38] | (record[39] << 8);
+  now29 = record[58] | (record[59] << 8);
+  now30 = record[60] | (record[61] << 8);
+  total++;
+
+  /* The firmware checksums the first 62 bytes at 0xb7f6a2 and compares against
+     halfword 31; a mismatch takes it to 0xb7f994 and it never looks at the
+     announcement at all.  A record we repeat could fail that check without
+     anything else in this file noticing -- so check it here, with the model of
+     the firmware's own CRC that already lives in this file, and count the
+     failures instead of assuming there are none.  */
+  stored = record[62] | (record[63] << 8);
+  computed = bfin_sport_peer_crc (record, 62);
+  if (stored != computed)
+    {
+      unsigned long n = ++bad_crc;
+
+      while (n >= 10 && n % 10 == 0)
+	n /= 10;
+      if (n == 1)
+	{
+	  fprintf (stderr, "link crc MISMATCH on a %s delivery at t%.1f:"
+		   " stored %04x computed %04x, x%lu of %lu\n", how,
+		   bfin_sim_seconds (), stored, computed, bad_crc, total);
+	  fflush (stderr);
+	}
+    }
+
+  if (have && now13 == w13 && now19 == w19 && now29 == w29 && now30 == w30)
+    {
+      run++;
+      return;
+    }
+  fprintf (stderr, "link w13/w19/w29/w30: %u/%04x/%u/%u -> %u/%04x/%u/%u"
+	   " (bit15 %d) at t%.1f (%s; crc %s; previous held %lu deliveries,"
+	   " %lu total, %lu bad crc)\n", w13, w19, w29, w30,
+	   now13, now19, now29, now30, (now19 >> 15) & 1, bfin_sim_seconds (),
+	   how, stored == computed ? "ok" : "BAD", run, total, bad_crc);
+  fflush (stderr);
+  w13 = now13;
+  w19 = now19;
+  w29 = now29;
+  w30 = now30;
+  run = 1;
+  have = 1;
+}
+
+static int
+bfin_sport_link_budget_any (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_BUDGET_ANY") != NULL);
+  return cached;
+}
+
+static int
+bfin_sport_link_budget_announced (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_BUDGET_ANNOUNCED") != NULL);
+  return cached;
+}
+
+/* BFIN_LINK_HOLD_ANNOUNCE keeps an announcement and its payload together.
+
+   Measured in r098, and it is not a theory about the protocol -- it is the
+   register dump the simulator printed when it died.  The firmware announces a
+   payload in halfword 29 of the 64-byte status record and its word count in
+   halfword 30 at 0x00f0003c, validates that count against 1..2048 at 0xb7f8d2,
+   sets its receive state at 0x005880c0 to 2 and waits.  The payload lands at
+   0x00f00040 -- but every 64-byte receive it arms in the meantime is answered
+   here with the *newest* status record, straight into 0x00f00000, on top of the
+   announcement.  When that newer record carries no announcement, halfword 30
+   reads 0, 0xb7fa2a computes (0-1)*2 = 0xfffffffe, and the checksum loop at
+   0xb7cb50 walks 0x00f00040 upwards until it leaves the firmware's own CPLB map
+   at 0x01100000.
+
+   From there the firmware has no way back: its EVT3 vector (0xb99192, installed
+   by 0xb99060) is `LINK 0xb0 ... RTX` with no UNLINK and no repair, so RTX
+   re-executes the faulting instruction, the fault repeats -- 1000+ times inside
+   a tenth of a second in r098 -- and each entry leaks 184 bytes of stack until
+   the push at 0xb99196 itself faults at 0xffffff50 and the simulator takes a
+   double fault.  That is the freeze in r095/r096 and the death in r097/r098.
+
+   The repair is deliberately the smallest one that cannot stall: while the
+   firmware is in receive state 2, a 64-byte receive is answered with the record
+   it *already holds*, so the DMA still completes on time and the announcement
+   survives to be used.  A fresh record is not consumed and waits its turn.  Four
+   earlier rules gated the payload side and none of them moved the fault count;
+   this one gates the status side, which is the side the dump indicts.
+
+   Opt-in, so the default behaviour is bit-for-bit what every earlier run
+   measured and an A/B stays one build.
+
+   **The first trigger was the firmware's receive state, and it was measured
+   unreachable.**  `r099` ran 745 s and never held once; `r100` says why.  Every
+   single receive the simulator serves reads `0x005880c0` as 0 -- 5 966 64-byte
+   receives into 0x00f00000, 7 827 200-byte housekeeping reads, one 224-byte
+   payload, `rxstate 0` on all of them.  The firmware writes the 2 *after*
+   arming (`0xb7f8ec` arms, `0xb7f8f2` writes) and this model's DMA runs
+   synchronously inside the arming store, so the state the simulator can observe
+   is always the one before the transfer.  **Rule, not anecdote: nothing gated
+   on that byte can ever fire from here.**
+
+   **The trigger is now the frame's own bytes, and `r103` is why.**  With the
+   halfword pair traced on every delivery, one 300 s run shows the buffer change
+   under the firmware and the fault land on the changed value:
+
+       link w29/w30: 0/0   -> 9/112 at t2.6    (previous held 43 deliveries)
+       link w29/w30: 9/112 -> 0/0   at t89.7   (announcement held 1502)
+       link w29/w30: 0/0   -> 9/112 at t90.1   (the zero held 9 -- survived)
+       link w29/w30: 9/112 -> 0/0   at t168.5  (announcement held 1385)
+       bfin fault 0x26 addr 0x01100000 pc 0x00b7cb50 read supv   t218.7
+
+   So it is **one** defect, not two: halfword 30 is 112 when `0xb7f8ce`
+   validates it and 0 when `0xb7fa24` reads it back, `(0-1)*2` underflows, and
+   the checksum walks off the map.  The t89.7 window is the control inside the
+   same run -- the same zero, nine deliveries long, no fault -- which is what a
+   race looks like.
+
+   The hold is therefore: while a delivered record announced a payload and no
+   payload has gone over yet, a *plain* 64-byte record is not allowed to replace
+   it.  The repeat path answers with the announcing record instead, so the DMA
+   still completes on time and nothing stalls -- that is the difference from
+   CDJ_LINK_RX_ONESHOT (r085, 10 requests) and BFIN_LINK_BUDGET_ANY (r101, dead
+   at t62.7), which both held up the whole channel to protect one buffer.
+   Capped at BFIN_LINK_HOLD_MAX in a row so a payload that never arrives cannot
+   silence the status stream for a whole run; the give-up is logged.  */
+
+static int
+bfin_sport_link_hold_announce (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_HOLD_ANNOUNCE") != NULL);
+  return cached;
+}
+
+/* Never more than this many in a row: if the firmware never leaves state 2 the
+   hold would silence the status stream for the rest of the run, which is a
+   worse failure than the one being repaired and would look like a hang.
+
+   **That justification is now measured false, and the cap is measured to be
+   the thing that kills the run.**  A hold does not silence anything -- it
+   re-delivers the record the firmware already holds, and the firmware parses
+   it: in `r137` and `r138` the GUI's status parser ran at ~9 records a second
+   for the whole 1 000-hold run.  What the give-up does is exactly the race the
+   hold exists to prevent, at a moment when the firmware is guaranteed to be
+   waiting: it puts a plain record on top of the announcement, halfword 30
+   reads 0 where 112 was validated, `(0-1)*2` underflows at 0xb7fa2a and the
+   checksum loop at 0xb7cb50 walks off the CPLB map.
+
+       run   give-up   last parse   double fault 0xb99196
+       r137  t443.6    t443.5       t489.2
+       r138  t525.2    t525.1       t572.0
+       r134  t424.1    t473.4       none seen -- run ended at 520 s
+       r136  never     t504.2       none, complete 600 s
+
+   The parse stream stops on the give-up to within a tenth of a second, and the
+   fault follows ~46 s later.  `r138`'s pc histogram names the same address
+   independently: its last two 20 s windows are 76 % and 99 % inside the 1 KB
+   bucket at 0xb7c800, which is where 0xb7cb50 lives.
+
+   So the cap is a tunable now, default unchanged so that A/B stays one build
+   and every earlier run remains bit-for-bit reproducible.  */
+/* BFIN_LINK_ANNOUNCE_STICKY=1 -- the repair the give-up should have been.
+
+   Two things go wrong with the repeat-the-whole-record hold, and both were
+   measured in r134..r139 rather than reasoned about:
+
+   1. **The give-up is the fault.**  After BFIN_LINK_HOLD_MAX holds the
+      simulator lets a plain record land on top of the announcement, which is
+      exactly the race the hold exists to prevent, at the one moment the
+      firmware is guaranteed to be mid-transaction: it validated halfword 30 as
+      112 at 0xb7f8ce and reads 0 back at 0xb7fa24, `(0-1)*2` underflows and
+      0xb7cb50 walks off the CPLB map.  Every run that reached the give-up
+      double-faulted ~46 s later (r135, r137, r138); neither run that stayed
+      under the cap did (r136, r139).
+
+   2. **Repeating the whole record re-announces a spent payload.**  The plain
+      repeat path below hands the last record back between MAIN's
+      transmissions -- announcement included -- so the firmware re-enters
+      receive state 2 on every repeat.  That is the 1:1 status/payload
+      ping-pong: 95-96 % of r135/r137/r138's parses are the *same record*
+      parsed again, which is why r137 had 268 parses and nine of them useful.
+
+   The rule here is what the wire actually guarantees: **the announcement is a
+   field the firmware is mid-transaction on, and it is a one-shot.**  So
+
+     - while a payload is outstanding, fresh status records go through as
+       normal but halfwords 29 and 30 are carried over from the record the
+       firmware already validated, and the record CRC is re-stamped (the
+       firmware skips the parse otherwise, 0xb7f6a2/0xb7f6be).  Nothing is
+       repeated, nothing is fabricated, and halfword 30 cannot change under a
+       validated count -- so there is no underflow and no cap is needed;
+     - once a payload has gone over, the announcement is wiped out of the held
+       record too, so the repeat path cannot announce it a second time.
+
+   Opt-in, default off, so every earlier run stays bit-for-bit and the A/B is
+   one build.  */
+static int
+bfin_sport_link_announce_sticky (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_ANNOUNCE_STICKY") != NULL);
+  return cached;
+}
+
+/* BFIN_LINK_ANNOUNCE_ONESHOT=1 -- the *second half* of the sticky rule alone.
+
+   r140 turned both halves on at once and the burst disappeared with them, which
+   leaves two candidates and no way to tell them apart: carrying the
+   announcement onto fresh records (which suppresses something), or wiping a
+   spent announcement out of the held record (which stops the repeat path
+   re-announcing a payload that already went over).
+
+   This is the control: keep the hold and its cap exactly as they were, and only
+   stop the repeat path from announcing the same payload twice.  If the burst
+   survives this, carrying is what suppressed it; if the burst disappears here
+   too, the burst *is* the repeat path re-announcing -- i.e. a simulator
+   artefact rather than a firmware state, which is the claim r140 could not
+   test on its own.  */
+static int
+bfin_sport_link_announce_oneshot (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_ANNOUNCE_ONESHOT") != NULL);
+  return cached;
+}
+
+/* Copy the outstanding announcement into a fresh record and re-stamp the CRC,
+   so the firmware reads back the count it validated.  */
+static void
+bfin_sport_link_carry_announce (unsigned char *dest,
+				const unsigned char *held)
+{
+  bu16 crc;
+
+  dest[58] = held[58];
+  dest[59] = held[59];
+  dest[60] = held[60];
+  dest[61] = held[61];
+  crc = bfin_sport_peer_crc (dest, 62);
+  dest[62] = crc;
+  dest[63] = crc >> 8;
+}
+
+/* Retract a spent announcement from the held record, CRC re-stamped.  */
+static void
+bfin_sport_link_clear_announce (unsigned char *record)
+{
+  bu16 crc;
+
+  record[58] = 0;
+  record[59] = 0;
+  record[60] = 0;
+  record[61] = 0;
+  crc = bfin_sport_peer_crc (record, 62);
+  record[62] = crc;
+  record[63] = crc >> 8;
+}
+
+static int
+bfin_sport_link_hold_max (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    {
+      const char *value_env = getenv ("BFIN_LINK_HOLD_MAX");
+
+      cached = 1000;
+      if (value_env && *value_env)
+	{
+	  long value = strtol (value_env, NULL, 0);
+
+	  if (value > 0)
+	    cached = (int) value;
+	}
+    }
+  return cached;
+}
+
+/* BFIN_LINK_YIELD_ANNOUNCED=1 -- the narrow form of the two failed cures.
+
+   The delivery hole is measured, on real content, from r160's own artefacts:
+   MAIN's log counts what it put on the wire, BFIN_MAIN_LINK_DUMP counts what
+   was handed to the firmware, and the two disagree by two orders of magnitude
+   for every length except the status record.
+
+     length   MAIN sent   handed over   note
+       64       5 970       22 493      repeated by the announce hold
+       48       2 738          47
+       80         781          44       the browse answer with the two names
+      160       1 183           5
+      224       1 226           4
+
+   Both earlier attempts moved only one half of the mechanism, which is why
+   neither worked:
+
+     BFIN_LINK_YIELD_ANY widens the *test* in record_waiting() so a payload
+     frame also refuses the 200-byte housekeeping read -- but the budget it
+     needs is still granted only by a 64-byte arrival, and it refuses on every
+     payload whether or not the firmware wants one (r086: 427 requests).
+
+     BFIN_LINK_BUDGET_ANY / _ANNOUNCED grant the *budget* for a payload -- but
+     record_waiting() still counts 64-byte slots only, so on the default the
+     grant can never be spent, and BUDGET_ANY starves the housekeeping loop
+     outright (r101: died at t62.7 with 41 requests).
+
+   This switch moves both halves together and gates both on the one window in
+   which the firmware is actually waiting for a payload: an announcement is
+   outstanding.  Outside that window it is bit-for-bit the default, so the
+   housekeeping loop cannot starve the way BUDGET_ANY starved it.  Off unless
+   set, so one build carries both sides of the A/B.  */
+
+static int
+bfin_sport_link_yield_announced (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_YIELD_ANNOUNCED") != NULL);
+  return cached;
+}
+
+/* How many unread frames of one length to keep -- see the struct comment.  */
+
+static unsigned
+bfin_sport_link_depth (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    {
+      const char *env = getenv ("BFIN_LINK_DEPTH");
+      long value = (env && *env) ? strtol (env, NULL, 0) : 1;
+
+      if (value < 1)
+	value = 1;
+      if (value > BFIN_LINK_DEPTH_MAX)
+	value = BFIN_LINK_DEPTH_MAX;
+      cached = (int) value;
+    }
+  return (unsigned) cached;
+}
+
+/* BFIN_LINK_CENSUS=1 -- where the payload frames go, per length, without
+   changing a single decision.
+
+   "MAIN sent 781, the firmware got 44" does not say *which* of the three
+   possible losses happened, and the three want different repairs:
+
+     arrived  -> overwritten   MAIN answers faster than the firmware reads, and
+                               the slot for that length is one deep
+     armed    -> stale         the firmware asked and the slot held a frame it
+                               had already been given
+     armed    -> absent        the firmware asked for a length that never came
+
+   The last column is the one that decides whether YIELD_ANNOUNCED can bite at
+   all: if `announce_pending` is 0 whenever a payload arrives, the window the
+   switch gates on is closed and no amount of budget will open it.  r105
+   measured that window as "two short stretches out of 400 s" -- before the
+   hold and the one-shot existed, so it is worth re-reading, not assuming.
+
+   A line every 30 simulated seconds, so the last line before the runner kills
+   the process is a complete snapshot; there is no atexit to rely on.  */
+
+#define BFIN_LINK_CENSUS_LENGTHS 8
+
+static struct
+{
+  unsigned length;
+  unsigned long arrived, overwritten, armed, hit, stale, absent;
+  unsigned long arrived_announced, hit_announced;
+} bfin_link_census[BFIN_LINK_CENSUS_LENGTHS];
+
+static unsigned long bfin_link_census_other;
+static unsigned long bfin_link_census_status_announced;
+static double bfin_link_census_last_report = -1.0;
+
+static int
+bfin_sport_link_census (void)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_CENSUS") != NULL);
+  return cached;
+}
+
+static int
+bfin_link_census_slot (unsigned length)
+{
+  int i;
+
+  for (i = 0; i < BFIN_LINK_CENSUS_LENGTHS; i++)
+    {
+      if (bfin_link_census[i].length == length)
+	return i;
+      if (bfin_link_census[i].length == 0)
+	{
+	  bfin_link_census[i].length = length;
+	  return i;
+	}
+    }
+  bfin_link_census_other++;
+  return -1;
+}
+
+static void
+bfin_link_census_report (void)
+{
+  double now;
+  int i;
+
+  if (!bfin_sport_link_census ())
+    return;
+  now = bfin_sim_seconds ();
+  if (bfin_link_census_last_report >= 0.0
+      && now - bfin_link_census_last_report < 30.0)
+    return;
+  bfin_link_census_last_report = now;
+  fprintf (stderr, "link census t%.1f -- status records carrying an"
+	   " announcement: %lu, unclassified lengths: %lu\n", now,
+	   bfin_link_census_status_announced, bfin_link_census_other);
+  for (i = 0; i < BFIN_LINK_CENSUS_LENGTHS; i++)
+    {
+      if (bfin_link_census[i].length == 0)
+	continue;
+      fprintf (stderr, "link census   len %-4u arrived %-7lu (announced"
+	       " %-7lu) overwritten %-7lu armed %-7lu hit %-7lu (announced"
+	       " %-7lu) stale %-7lu absent %lu\n",
+	       bfin_link_census[i].length,
+	       bfin_link_census[i].arrived,
+	       bfin_link_census[i].arrived_announced,
+	       bfin_link_census[i].overwritten,
+	       bfin_link_census[i].armed,
+	       bfin_link_census[i].hit,
+	       bfin_link_census[i].hit_announced,
+	       bfin_link_census[i].stale,
+	       bfin_link_census[i].absent);
+    }
+  fflush (stderr);
+}
+
+static void
+bfin_sport_link_split (struct bfin_sport *sport)
+{
+  while (sport->link_in_len >= 8)
+    {
+      const unsigned char *head = sport->link_in;
+      unsigned length;
+      unsigned slot, free_slot;
+
+      if (memcmp (head, "CDJL", 4) != 0)
+	{
+	  /* No header: an unframed peer.  Leave the bytes where they are and
+	     let the flat-stream path consume them.  */
+	  sport->link_rx_resync++;
+	  return;
+	}
+      sport->link_framed = 1;
+      length = head[4] | (head[5] << 8) | (head[6] << 16)
+	       | ((unsigned) head[7] << 24);
+      if (length == 0 || length > BFIN_LINK_FRAME_MAX)
+	{
+	  /* Unusable length -- resynchronise on the next magic rather than
+	     wedging on a byte we cannot interpret.  */
+	  sport->link_rx_flush++;
+	  sport->link_in_len = 0;
+	  return;
+	}
+      if (sport->link_in_len < 8 + length)
+	return;			/* the rest of the frame is still in flight */
+
+      /* Which frame lands in which slot, and whether the record that announced
+	 a payload is still the one the GUI holds when the payload arrives.  */
+      if (getenv ("BFIN_SPORT_RX_ADDR_TRACE"))
+	{
+	  const unsigned char *b = head + 8;
+
+	  fprintf (stderr, "link-split len %u%s\n", length,
+		   length == sizeof (sport->link_last)
+		   ? ((b[58] | (b[59] << 8)) ? " announce" : " plain") : "");
+	  fflush (stderr);
+	}
+
+      free_slot = BFIN_LINK_SIZES;
+      for (slot = 0; slot < BFIN_LINK_SIZES; slot++)
+	{
+	  if (sport->link_frame_len[slot] == length)
+	    break;
+	  if (sport->link_frame_len[slot] == 0 && free_slot == BFIN_LINK_SIZES)
+	    free_slot = slot;
+	}
+      if (slot == BFIN_LINK_SIZES)
+	slot = free_slot;
+      if (slot < BFIN_LINK_SIZES)
+	{
+	  unsigned depth = bfin_sport_link_depth ();
+	  unsigned put = sport->link_frame_put[slot] % depth;
+
+	  if (bfin_sport_link_census ())
+	    {
+	      int c = bfin_link_census_slot (length);
+
+	      if (c >= 0)
+		{
+		  bfin_link_census[c].arrived++;
+		  if (sport->link_announce_pending)
+		    bfin_link_census[c].arrived_announced++;
+		  /* A frame that was still fresh is one the firmware was never
+		     given: this is the "MAIN answers faster than the firmware
+		     reads" loss, counted rather than inferred.  */
+		  if (sport->link_frame_fresh[slot][put])
+		    bfin_link_census[c].overwritten++;
+		}
+	      if (length == sizeof (sport->link_last)
+		  && (head[8 + 58] | head[8 + 59]))
+		bfin_link_census_status_announced++;
+	    }
+	  /* Unconditional, because BFIN_LINK_RX_CENSUS has to be able to say
+	     whether MAIN's records reach this model at all -- "the firmware was
+	     handed the same bytes 21 000 times" has three possible causes and
+	     only this counter separates the first from the other two.  */
+	  if (length == sizeof (sport->link_last))
+	    {
+	      sport->link_rx_arrived++;
+	      if (sport->link_frame_fresh[slot][put])
+		sport->link_rx_lost++;
+	    }
+	  /* Overwriting the entry the reader is pointing at drops the oldest
+	     frame; move the reader on so it does not hand out the newest one
+	     and then walk back through the ring.  */
+	  if (sport->link_frame_fresh[slot][put]
+	      && sport->link_frame_get[slot] % depth == put)
+	    sport->link_frame_get[slot] = (put + 1) % depth;
+	  memcpy (sport->link_frame[slot][put], head + 8, length);
+	  sport->link_frame_len[slot] = length;
+	  sport->link_frame_fresh[slot][put] = 1;
+	  sport->link_frame_put[slot] = (put + 1) % depth;
+	  /* Who earns a turn on the shared DMA channel.  Granting the budget only
+	     for the 64-byte status record starves the payload, and that is
+	     measured, not feared: `r100` (150 s, BFIN_REQUEST_KIND=2) had 2 524
+	     payload frames arrive from MAIN and handed the firmware exactly **one**
+	     -- against 5 966 64-byte receives into 0x00f00000 and 7 827 200-byte
+	     housekeeping reads.  BFIN_LINK_YIELD_ANY only ever widened the test in
+	     record_waiting() below; the budget it needs was never granted for a
+	     payload, which is why turning it on alone (r086) changed nothing but
+	     the throughput.
+
+	     BFIN_LINK_BUDGET_ANY grants it for any length -- and it is a **measured
+	     failure**, kept switchable so the next attempt starts from the number
+	     rather than repeating the experiment.  `r101` (300 s, both halves under
+	     BFIN_LINK_YIELD_ANY in that binary) died at t62.7 with 41 requests
+	     against r100's 2 549: with 2 500 payload frames arriving the budget is
+	     effectively always granted, every 200-byte housekeeping read is refused,
+	     and the loop the refusal was meant to nudge starves instead.  The
+	     payload ratio did improve -- 4 of 19 against 1 of 2 524 -- so the
+	     diagnosis holds and only this cure does not.
+
+	     BFIN_LINK_BUDGET_ANNOUNCED is the narrow version of that failure:
+	     grant the budget to a payload frame **only while an announcement is
+	     outstanding**, which is the one window in which the firmware
+	     actually wants one.  It cannot starve the housekeeping loop the way
+	     BUDGET_ANY does, because the window closes as soon as a payload goes
+	     over -- in r105 the announcement was outstanding for two short
+	     stretches out of 400 s.  */
+	  if (length == sizeof (sport->link_last)
+	      || bfin_sport_link_budget_any ()
+	      || ((bfin_sport_link_budget_announced ()
+		   || bfin_sport_link_yield_announced ())
+		  && sport->link_announce_pending))
+	    sport->link_yield_budget = 3;
+	}
+      bfin_link_census_report ();
+
+      sport->link_in_len -= 8 + length;
+      memmove (sport->link_in, sport->link_in + 8 + length,
+	       sport->link_in_len);
+    }
+}
+
+/* Drain whatever MAIN has sent into the staging buffer.  */
+
+static void
+bfin_sport_link_poll (struct bfin_sport *sport)
+{
+  for (;;)
+    {
+      int got;
+
+      /* Break rather than return: the staging buffer is only drained by the
+	 split below, so leaving early on a full buffer would never empty it.  */
+      if (sport->link_in_len >= sizeof (sport->link_in))
+	{
+	  sport->link_rx_stall++;
+	  break;
+	}
+      got = recv (sport->link_record_fd,
+		  (char *) sport->link_in + sport->link_in_len,
+		  (int) (sizeof (sport->link_in) - sport->link_in_len), 0);
+      if (got <= 0)
+	break;
+      sport->link_rx_bytes += (unsigned long) got;
+      sport->link_in_len += (size_t) got;
+    }
+  bfin_sport_link_split (sport);
+}
+
+/* BFIN_MAIN_LINK_DUMP names a file of every record handed to the firmware, in
+   the same "SPRX" + length + body form as the TX dump, so a run can be decoded
+   afterwards without a second consumer on the socket.  */
+
+/* BFIN_LINK_W13=<n>: overwrite status halfword 13 on the way in.
+
+   r128 named the screen router that actually runs -- 0xbb466c, which indexes an
+   18-entry table at 0xb35534 with B[0x4b43c8], and 0xb7ded8 fills that byte from
+   W[0x00f0001a], record offset 26, status halfword 13.  MAIN sends 0 there in
+   9 714 of 9 714 archived records and its record builder never writes the field,
+   so the table has only ever taken arm 0: screen 0, the Wait platter.
+
+   Injecting the field here is the one-run test of what the rest of that table
+   does -- 1 selects screen 7, 2..5 screen 10, 10..17 screen 2.  It is a
+   diagnostic and never an acceptance run: the value is ours, not MAIN's.
+
+   The firmware checksums the first 62 bytes and compares against halfword 31
+   (0xb7f6a2 / 0xb7f6be), so the record has to be re-stamped or the parse is
+   skipped and the injection would silently measure nothing.  */
+
+static void
+bfin_sport_link_force_w13 (void *record)
+{
+  static int initialized;
+  static int value = -1;
+  unsigned char *bytes = record;
+  bu16 crc;
+
+  if (!initialized)
+    {
+      const char *env = getenv ("BFIN_LINK_W13");
+
+      initialized = 1;
+      if (env && *env)
+	value = (int) strtol (env, NULL, 0);
+    }
+  if (value < 0)
+    return;
+
+  bytes[26] = (unsigned char) value;
+  bytes[27] = (unsigned char) (value >> 8);
+  crc = bfin_sport_peer_crc (bytes, 62);
+  bytes[62] = crc;
+  bytes[63] = crc >> 8;
+}
+
+static void
+bfin_sport_link_dump (const void *data, unsigned nr_bytes)
+{
+  const char *path = getenv ("BFIN_MAIN_LINK_DUMP");
+  FILE *stream;
+
+  if (path == NULL || *path == 0)
+    return;
+  stream = fopen (path, "ab");
+  if (stream == NULL)
+    return;
+  {
+    unsigned char header[8] =
+    {
+      'S', 'P', 'R', 'X',
+      nr_bytes, nr_bytes >> 8, nr_bytes >> 16, nr_bytes >> 24,
+    };
+    fwrite (header, 1, sizeof (header), stream);
+    fwrite (data, 1, nr_bytes, stream);
+  }
+  fclose (stream);
+}
+
+/* BFIN_LINK_RX_CENSUS=<seconds> -- print the fresh/repeat split periodically.
+
+   The one line answers "who freezes": if `fresh` stands still while `repeat`
+   climbs, MAIN stopped transmitting and this model is repeating its last
+   record; if `fresh` climbs while `changed` stands still, MAIN is transmitting
+   and its record builder is producing the same bytes.  The two have completely
+   different repairs and a BFIN_MAIN_LINK_DUMP cannot tell them apart.
+
+   Unset or 0 disables it and the run is byte-for-byte the old one.  */
+
+static double
+bfin_sport_link_rx_census_every (void)
+{
+  static int initialized;
+  static double every;
+
+  if (!initialized)
+    {
+      const char *env = getenv ("BFIN_LINK_RX_CENSUS");
+
+      initialized = 1;
+      every = (env && *env) ? strtod (env, NULL) : 0.0;
+      if (env && *env && every <= 0.0)
+	every = 10.0;
+    }
+  return every;
+}
+
+static void
+bfin_sport_link_rx_census (struct bfin_sport *sport, int final)
+{
+  double every = bfin_sport_link_rx_census_every ();
+  double now;
+
+  if (every <= 0.0)
+    return;
+  now = bfin_sim_seconds ();
+  if (!final && now < sport->link_census_next)
+    return;
+  sport->link_census_next = now + every;
+  fprintf (stderr, "link: rx census t%.1f bytes=%lu resync=%lu flush=%lu "
+	   "stall=%lu arrived=%lu lost=%lu fresh=%lu changed=%lu repeat=%lu "
+	   "hold=%lu payload=%lu\n", now, sport->link_rx_bytes,
+	   sport->link_rx_resync, sport->link_rx_flush, sport->link_rx_stall,
+	   sport->link_rx_arrived, sport->link_rx_lost, sport->link_rx_fresh,
+	   sport->link_rx_changed, sport->link_rx_repeat,
+	   sport->link_hold_total, sport->link_rx_payload);
+  fflush (stderr);
+}
+
+/* Hand over the newest frame whose length matches the receive the GUI armed.
+
+   The 64-byte status record is repeated while MAIN has not sent a newer one:
+   between transmissions the wire still carries the last one, and answering
+   "nothing" stalls the GUI's protocol task -- the rule this file already
+   applied before there was any framing.  A payload is handed over once and
+   then withheld until MAIN sends another.
+
+   Repeating payloads too was tried and is measurably worse: the GUI re-reads
+   and re-parses the same record instead of advancing, and a 200 s run gets 38
+   requests out where withholding gets 1450.  Returns 0 when there is nothing
+   of that length.  */
+
+static unsigned
+bfin_sport_link_take (struct bfin_sport *sport, void *dest, unsigned nr_bytes)
+{
+  unsigned slot;
+  int c = bfin_sport_link_census () ? bfin_link_census_slot (nr_bytes) : -1;
+
+  sport->link_take_fresh = 1;
+  if (c >= 0)
+    bfin_link_census[c].armed++;
+
+  for (slot = 0; slot < BFIN_LINK_SIZES; slot++)
+    {
+      unsigned depth, step, get, entry;
+
+      if (sport->link_frame_len[slot] != nr_bytes)
+	continue;
+
+      /* Oldest unread first, so a ring hands the answers over in the order
+	 MAIN produced them.  With depth 1 this loop runs exactly once on
+	 entry 0 and the test below is the old `!fresh` test.  */
+      depth = bfin_sport_link_depth ();
+      get = sport->link_frame_get[slot] % depth;
+      entry = depth;
+      for (step = 0; step < depth; step++)
+	if (sport->link_frame_fresh[slot][(get + step) % depth])
+	  {
+	    entry = (get + step) % depth;
+	    break;
+	  }
+      if (entry == depth)
+	{
+	  /* Nothing unread.  A 64-byte status record is repeated anyway --
+	     a real link carries MAIN's last record continuously -- and for
+	     that case the newest entry is the one on the wire.  */
+	  if (nr_bytes != sizeof (sport->link_last))
+	    {
+	      if (c >= 0)
+		bfin_link_census[c].stale++;
+	      return 0;
+	    }
+	  entry = (sport->link_frame_put[slot] + depth - 1) % depth;
+	  /* This record is not a transmission, it is the wire still carrying
+	     the last one.  BFIN_LINK_RX_CENSUS separates the two.  */
+	  sport->link_take_fresh = 0;
+	}
+      memcpy (dest, sport->link_frame[slot][entry], nr_bytes);
+      sport->link_frame_fresh[slot][entry] = 0;
+      sport->link_frame_get[slot] = (entry + 1) % depth;
+      if (c >= 0)
+	{
+	  bfin_link_census[c].hit++;
+	  if (sport->link_announce_pending)
+	    bfin_link_census[c].hit_announced++;
+	}
+      return nr_bytes;
+    }
+  if (c >= 0)
+    bfin_link_census[c].absent++;
+  return 0;
+}
+
+/* Is any entry of this length's ring still unread?  With depth 1 this is the
+   `link_frame_fresh[slot]` test it replaced.  */
+
+static int
+bfin_sport_link_slot_unread (struct bfin_sport *sport, unsigned slot)
+{
+  unsigned depth = bfin_sport_link_depth (), i;
+
+  for (i = 0; i < depth; i++)
+    if (sport->link_frame_fresh[slot][i])
+      return 1;
+  return 0;
+}
+
+/* The 64-byte frame a 64-byte receive would be given, without consuming it.
+   Freshness is deliberately ignored: take() repeats a 64-byte frame whether or
+   not it is fresh, so the slot is what the firmware would get either way.  */
+
+static const unsigned char *
+bfin_sport_link_peek_status (struct bfin_sport *sport)
+{
+  unsigned slot;
+
+  for (slot = 0; slot < BFIN_LINK_SIZES; slot++)
+    if (sport->link_frame_len[slot] == sizeof (sport->link_last))
+      {
+	unsigned depth = bfin_sport_link_depth ();
+
+	/* The newest entry is the one on the wire, which is what take()
+	   repeats for this length.  */
+	return sport->link_frame[slot]
+	  [(sport->link_frame_put[slot] + depth - 1) % depth];
+      }
+  return NULL;
+}
+
+/* BFIN_LINK_NO_ZERO200=1 -- stop manufacturing a completion for a transfer the
+   wire never satisfies.
+
+   BFIN_SPORT_RX_ZERO_200 exists because a flat replay file cannot predict how
+   many housekeeping reads the emulated threads schedule, so those reads are
+   answered with 200 zero bytes.  Against a **live MAIN** that is a fiction with
+   a price, and r178/r179 measured both halves of it:
+
+     * MAIN sends no 200-byte record at all.  Every census this project has
+       taken says `len 200 arrived 0` -- 402 armed, 402 absent in r178.  On the
+       real board that receive simply does not complete.
+     * Every manufactured completion re-arms the loop the record-handler task is
+       trapped in.  0xb7ef40 sets B[0x5880b8] = 1, arms 200 bytes and polls
+       DMA3_CURR_X_COUNT; it leaves only when the count stands still *and* the
+       byte is still 1.  A completion makes the DMA3 ISR write 2 there
+       (0xb7c73a), and 0xb7efd8 answers a 2 by re-arming.  r179 caught the task
+       inside that loop: `task(pend=17 ok=17 fail=16) handler=17 ... w30(ok=1)
+       payload(arm=0)` frozen from t20 to t80 while `armsother` climbed 2 232 ->
+       4 528, i.e. the 17th handler run validated halfword 30 = 112, called
+       0xb7ef40 at 0xb7f8de and never came back.
+
+   With the read refused the count stands still on the second poll, the loop
+   exits at 0xb7efc8, releases the channel and the caller arms what it came for.
+   Opt-in, so the default build is bit-for-bit every earlier run and the A/B is
+   one binary.
+
+   This is NOT BFIN_LINK_YIELD_ANY.  That one refuses the housekeeping read
+   while an unread *payload* exists -- a state that comes and goes and that the
+   firmware is not necessarily waiting on -- and it measured 427 requests in
+   r086.  This refuses the read whose data never existed.  */
+
+static int
+bfin_sport_link_refuse_housekeeping (struct bfin_sport *sport)
+{
+  static int cached = -1;
+
+  if (cached < 0)
+    cached = (getenv ("BFIN_LINK_NO_ZERO200") != NULL);
+  return cached && sport->link_enabled && sport->link_opened;
+}
+
+/* Is a record from MAIN sitting unread?
+
+   The GUI multiplexes its 200-byte housekeeping transfers and MAIN's records
+   over the same DMA channel (3), and the housekeeping poll loop at 0xb7ef40
+   re-arms the moment one completes.  Answering those reads instantly means it
+   never yields: measured over 150 s, 7 252 housekeeping completions against 12
+   record receives, so the GUI decoded 14 status records out of 2 522 delivered
+   and never saw a source change.  Refusing the housekeeping read while a record
+   is waiting lets the loop reach its own give-up exit (0xb7efc8, which calls
+   0xb7c22e and releases the channel) and the record path gets a turn.  */
+
+static int
+bfin_sport_link_record_waiting (struct bfin_sport *sport)
+{
+  unsigned slot;
+
+  if (!sport->link_enabled || !sport->link_opened)
+    return 0;
+
+  /* Drain the socket first: this runs before the link branch below, so without
+     it the freshness flags are one read behind and the housekeeping loop keeps
+     the channel exactly when a record has just arrived.  */
+  bfin_sport_link_poll (sport);
+
+  if (sport->link_yield_budget <= 0)
+    return 0;
+
+  for (slot = 0; slot < BFIN_LINK_SIZES; slot++)
+    if (sport->link_frame_len[slot] != 0
+	&& bfin_sport_link_slot_unread (sport, slot)
+	&& (!bfin_sport_link_yield_status_only ()
+	    || sport->link_frame_len[slot] == sizeof (sport->link_last)
+	    /* The other half of BFIN_LINK_YIELD_ANNOUNCED: a waiting payload
+	       may refuse the housekeeping read, but only while the firmware
+	       has an announcement outstanding.  Outside that window this line
+	       is false and the test is the default one, byte for byte.  */
+	    || (bfin_sport_link_yield_announced ()
+		&& sport->link_announce_pending)))
+      {
+	sport->link_yield_budget--;
+	return 1;
+      }
+  sport->link_yield_budget = 0;
+  return 0;
+}
+
+/* Reproduce the firmware's 16-bit record checksum (GUI 0x00b7cb2a).  */
+
+static bu16
+bfin_sport_peer_crc (const unsigned char *data, size_t len)
+{
+  bu32 state = 0;
+  size_t i;
+  unsigned bit;
+
+  for (i = 0; i < len; ++i)
+    {
+      state |= data[i];
+      for (bit = 0; bit < 8; ++bit)
+	{
+	  state <<= 1;
+	  if (state & (1 << 24))
+	    state ^= 0x01102100;
+	}
+    }
+  for (bit = 0; bit < 16; ++bit)
+    {
+      state <<= 1;
+      if (state & (1 << 24))
+	state ^= 0x01102100;
+    }
+  return (state >> 8) & 0xffff;
+}
+
+static void bfin_sport_peer_trace (struct bfin_sport *sport, const char *event,
+				   unsigned value);
+
+/* Load the status-record sequence, if one was named.  */
+
+static void
+bfin_sport_peer_load_status (struct bfin_sport *sport)
+{
+  const char *path = getenv ("BFIN_MAIN_PEER_STATUS");
+  const char *hold = getenv ("BFIN_MAIN_PEER_STATUS_HOLD");
+  FILE *file;
+
+  sport->peer_seq_loaded = 1;
+  sport->peer_seq_hold = 200;
+  if (hold && *hold)
+    sport->peer_seq_hold = strtoul (hold, NULL, 0);
+  if (sport->peer_seq_hold == 0)
+    sport->peer_seq_hold = 1;
+  if (!path || !*path)
+    return;
+
+  file = fopen (path, "rb");
+  if (file == NULL)
+    {
+      bfin_sport_peer_trace (sport, "status-open-failed", 0);
+      return;
+    }
+  while (sport->peer_seq_count < BFIN_SPORT_PEER_STATUS_MAX
+	 && fread (sport->peer_seq[sport->peer_seq_count], 1, 64, file) == 64)
+    sport->peer_seq_count++;
+  fclose (file);
+  bfin_sport_peer_trace (sport, "status-records", sport->peer_seq_count);
+}
+
+/* Load one payload file into *SLOT, if the environment names it.  TAG is
+   type * 100 + cursor for the trace, with cursor 99 meaning the any-cursor
+   fallback, so a log line reads e.g. "payload-loaded=111" for type 1 cursor 11.
+   Slots are allocated on demand: 16 types x 16 cursors x 8 KB would be a
+   megabyte of mostly-unused struct otherwise.  */
+
+static void
+bfin_sport_peer_load_payload_path (struct bfin_sport *sport, const char *path,
+				   unsigned char **slot, size_t *slot_size,
+				   unsigned tag)
+{
+  unsigned char *buffer;
+  FILE *file;
+  size_t got;
+
+  if (path == NULL || *path == '\0')
+    return;
+
+  file = fopen (path, "rb");
+  if (file == NULL)
+    {
+      bfin_sport_peer_trace (sport, "payload-open-failed", tag);
+      return;
+    }
+
+  buffer = malloc (BFIN_SPORT_PEER_PAYLOAD_MAX);
+  if (buffer == NULL)
+    {
+      fclose (file);
+      bfin_sport_peer_trace (sport, "payload-no-memory", tag);
+      return;
+    }
+
+  got = fread (buffer, 1, BFIN_SPORT_PEER_PAYLOAD_MAX, file);
+  fclose (file);
+
+  /* The GUI reads whole words and the last one is the CRC.  */
+  if (got < 4 || (got & 1))
+    {
+      free (buffer);
+      bfin_sport_peer_trace (sport, "payload-bad-size", (unsigned) got);
+      return;
+    }
+
+  free (*slot);
+  *slot = buffer;
+  *slot_size = got;
+  bfin_sport_peer_trace (sport, "payload-loaded", tag);
+}
+
+/* The original env-name form, kept so every existing call site is unchanged.  */
+
+static void
+bfin_sport_peer_load_payload (struct bfin_sport *sport, const char *name,
+			      unsigned char **slot, size_t *slot_size,
+			      unsigned tag)
+{
+  bfin_sport_peer_load_payload_path (sport, getenv (name), slot, slot_size, tag);
+}
+
+/* Load a comma-separated list of payload files into one type's sequence.  */
+
+static void
+bfin_sport_peer_load_sequence (struct bfin_sport *sport, unsigned type)
+{
+  char name[64];
+  const char *list;
+  char buffer[2048];
+  char *item;
+  char *save = NULL;
+
+  sprintf (name, "BFIN_MAIN_PEER_PAYLOAD_%u_SEQ", type);
+  list = getenv (name);
+  if (list == NULL || *list == '\0')
+    return;
+
+  strncpy (buffer, list, sizeof (buffer) - 1);
+  buffer[sizeof (buffer) - 1] = '\0';
+
+  for (item = strtok_r (buffer, ",", &save);
+       item != NULL && sport->peer_plseq_count[type] < BFIN_SPORT_PEER_PLSEQ_MAX;
+       item = strtok_r (NULL, ",", &save))
+    {
+      unsigned slot = sport->peer_plseq_count[type];
+
+      bfin_sport_peer_load_payload_path (sport, item,
+					 &sport->peer_plseq[type][slot],
+					 &sport->peer_plseq_size[type][slot],
+					 type * 100 + slot);
+      if (sport->peer_plseq_size[type][slot] != 0)
+	sport->peer_plseq_count[type] = slot + 1;
+    }
+  bfin_sport_peer_trace (sport, "payload-sequence",
+			 type * 100 + sport->peer_plseq_count[type]);
+}
+
+/* Harvest a status template and the payloads out of the scripted stream so the
+   peer answers with authentic captured data rather than invented values.  */
+
+static void
+bfin_sport_peer_scan (struct bfin_sport *sport)
+{
+  size_t offset = 0;
+
+  sport->peer_scanned = true;
+  while (offset + 4 <= sport->rx_size)
+    {
+      const unsigned char *header = sport->rx_data + offset;
+      size_t size = ((size_t) header[0] | (size_t) header[1] << 8
+		     | (size_t) header[2] << 16 | (size_t) header[3] << 24);
+      const unsigned char *body = sport->rx_data + offset + 4;
+
+      if (size == 0 || offset + 4 + size > sport->rx_size)
+	break;
+      if (size == 64)
+	{
+	  unsigned announced = body[58] | (body[59] << 8);
+
+	  /* Word 29 marks an announcement; a plain status record is the
+	     template.  Prefer the steady-state record, not the bootstrap.  */
+	  if (announced != 1 && offset != 0 && !sport->peer_have_status)
+	    {
+	      memcpy (sport->peer_status, body, 64);
+	      sport->peer_have_status = true;
+	    }
+	}
+      else if (size > 64 && size <= sizeof (sport->peer_wave))
+	{
+	  /* 436 words is the overview waveform; 128 words the player state.  */
+	  if (size == 872 && sport->peer_wave_size == 0)
+	    {
+	      memcpy (sport->peer_wave, body, size);
+	      sport->peer_wave_size = size;
+	    }
+	  else if (size == 256 && sport->peer_state_size == 0)
+	    {
+	      memcpy (sport->peer_state, body, size);
+	      sport->peer_state_size = size;
+	    }
+	}
+      offset += 4 + size;
+    }
+
+  /* Synthesized payloads override anything harvested, so a hand-built waveform
+     or player state can be substituted for the captured one.  */
+  {
+    unsigned type, cursor;
+    const char *hold_env = getenv ("BFIN_MAIN_PEER_SEQ_HOLD");
+
+    sport->peer_plseq_hold = hold_env && *hold_env
+			     ? (unsigned) strtoul (hold_env, NULL, 0) : 1;
+    if (sport->peer_plseq_hold == 0)
+      sport->peer_plseq_hold = 1;
+
+    for (type = 0; type < BFIN_SPORT_PEER_TYPES; ++type)
+      {
+	char name[64];
+
+	bfin_sport_peer_load_sequence (sport, type);
+
+	sprintf (name, "BFIN_MAIN_PEER_PAYLOAD_%u", type);
+	bfin_sport_peer_load_payload (sport, name, &sport->peer_payload_any[type],
+				      &sport->peer_payload_any_size[type],
+				      type * 100 + 99);
+
+	for (cursor = 0; cursor < BFIN_SPORT_PEER_CURSORS; ++cursor)
+	  {
+	    sprintf (name, "BFIN_MAIN_PEER_PAYLOAD_%u_%u", type, cursor);
+	    bfin_sport_peer_load_payload (sport, name,
+					  &sport->peer_payload[type][cursor],
+					  &sport->peer_payload_size[type][cursor],
+					  type * 100 + cursor);
+	  }
+      }
+  }
+
+  /* Types whose payload keeps its own command word (the bulk transports).  */
+  {
+    const char *raw = getenv ("BFIN_MAIN_PEER_RAW");
+
+    while (raw && *raw)
+      {
+	char *end;
+	unsigned long type = strtoul (raw, &end, 0);
+
+	if (end == raw)
+	  break;
+	if (type < BFIN_SPORT_PEER_TYPES)
+	  {
+	    sport->peer_raw_types |= 1u << type;
+	    bfin_sport_peer_trace (sport, "raw-command-type", (unsigned) type);
+	  }
+	raw = (*end == ',') ? end + 1 : end;
+      }
+  }
+}
+
+static void
+bfin_sport_peer_trace (struct bfin_sport *sport, const char *event,
+		       unsigned value)
+{
+  const char *trace = getenv ("BFIN_MAIN_PEER_TRACE");
+
+  if (trace && *trace)
+    {
+      fprintf (stderr, "MAIN peer base=%#x %s=%u\n", sport->base, event, value);
+      fflush (stderr);
+    }
+}
+
+/* Answer one GUI read.  Returns the number of bytes produced, or 0 when the
+   peer has nothing to say for this transfer size.  */
+
+static unsigned
+bfin_sport_peer_read (struct bfin_sport *sport, void *dest, unsigned nr_bytes)
+{
+  if (!sport->peer_scanned)
+    bfin_sport_peer_scan (sport);
+
+  /* A payload the previous status record announced takes priority: the GUI
+     reads exactly the advertised number of bytes.  */
+  if (sport->peer_pending != NULL && sport->peer_pending_size == nr_bytes
+      && nr_bytes >= 4 && nr_bytes <= sizeof (sport->peer_answer))
+    {
+      unsigned char *answer = sport->peer_answer;
+      bu16 crc;
+
+      memcpy (answer, sport->peer_pending, nr_bytes);
+
+      /* The GUI validates the response against the request: at 0x00b7ebbc it
+	 requires (command & 0xf) to equal the tag it is expecting, and sets an
+	 error bit otherwise.  The tag rides in word 2 of the request (type 4 ->
+	 4, type 9 -> 1), so echo it in the command's low nibble.  Commands
+	 outside 0x10..0x1c take a different path in 0x00b7eb48.  */
+      if (!sport->peer_pending_raw)
+	{
+	  answer[0] = 0x10 | (sport->peer_pending_tag & 0xf);
+	  answer[1] = 0;
+	}
+
+      crc = bfin_sport_peer_crc (answer, nr_bytes - 2);
+      answer[nr_bytes - 2] = crc;
+      answer[nr_bytes - 1] = crc >> 8;
+
+      memcpy (dest, answer, nr_bytes);
+      sport->peer_pending = NULL;
+      sport->peer_pending_size = 0;
+      bfin_sport_peer_trace (sport, "payload-cmd", answer[0]);
+      return nr_bytes;
+    }
+
+  if (nr_bytes != 64 || !sport->peer_have_status)
+    {
+      bfin_sport_peer_trace (sport, "unanswered", nr_bytes);
+      return 0;
+    }
+
+  {
+    unsigned char status[64];
+    const unsigned char *payload = NULL;
+    size_t payload_size = 0;
+
+    if (!sport->peer_seq_loaded)
+      bfin_sport_peer_load_status (sport);
+
+    if (sport->peer_seq_count != 0)
+      {
+	memcpy (status, sport->peer_seq[sport->peer_seq_index], sizeof (status));
+	if (++sport->peer_seq_reads >= sport->peer_seq_hold
+	    && sport->peer_seq_index + 1 < sport->peer_seq_count)
+	  {
+	    sport->peer_seq_reads = 0;
+	    sport->peer_seq_index++;
+	    bfin_sport_peer_trace (sport, "status-advance",
+				   sport->peer_seq_index);
+	  }
+      }
+    else
+      memcpy (status, sport->peer_status, sizeof (status));
+
+    /* The (type, cursor) pair the GUI last asked for selects the payload.  The
+       GUI labels an incoming payload by its own request, so the payload's
+       command word does not have to match the type.  A pair-specific file wins
+       over the any-cursor one, which is what keeps the older
+       BFIN_MAIN_PEER_PAYLOAD_<type> recipes working.  */
+    if (sport->peer_request < BFIN_SPORT_PEER_TYPES
+	&& sport->peer_plseq_count[sport->peer_request] != 0)
+      {
+	unsigned type = sport->peer_request;
+	unsigned n = sport->peer_plseq_count[type];
+	unsigned index =
+	  (sport->peer_plseq_served[type] / sport->peer_plseq_hold) % n;
+
+	payload = sport->peer_plseq[type][index];
+	payload_size = sport->peer_plseq_size[type][index];
+	sport->peer_plseq_served[type]++;
+	/* Only on a change, so a long run does not drown the log: the interesting
+	   event is the window moving, not each of the thousands of deliveries.  */
+	if (sport->peer_plseq_served[type] == 1
+	    || (sport->peer_plseq_served[type] - 1) % sport->peer_plseq_hold == 0)
+	  bfin_sport_peer_trace (sport, "sequence-index", type * 100 + index);
+      }
+    else if (sport->peer_request < BFIN_SPORT_PEER_TYPES)
+      {
+	unsigned cursor = sport->peer_tag;
+
+	if (cursor < BFIN_SPORT_PEER_CURSORS
+	    && sport->peer_payload_size[sport->peer_request][cursor] != 0)
+	  {
+	    payload = sport->peer_payload[sport->peer_request][cursor];
+	    payload_size = sport->peer_payload_size[sport->peer_request][cursor];
+	  }
+	else if (sport->peer_payload_any_size[sport->peer_request] != 0)
+	  {
+	    payload = sport->peer_payload_any[sport->peer_request];
+	    payload_size = sport->peer_payload_any_size[sport->peer_request];
+	  }
+      }
+
+    if (payload == NULL && sport->peer_request == 4 && sport->peer_wave_size != 0)
+      {
+	payload = sport->peer_wave;
+	payload_size = sport->peer_wave_size;
+      }
+    else if (payload == NULL && sport->peer_request == 9
+	     && sport->peer_state_size != 0)
+      {
+	payload = sport->peer_state;
+	payload_size = sport->peer_state_size;
+      }
+
+    if (payload != NULL)
+      {
+	unsigned words = (unsigned) (payload_size / 2);
+
+	status[58] = 1;
+	status[59] = 0;
+	status[60] = words;
+	status[61] = words >> 8;
+	sport->peer_pending = payload;
+	sport->peer_pending_size = payload_size;
+	sport->peer_pending_tag = sport->peer_tag;
+	/* peer_request is word1 & 0x7fff, so it is not bounded by the table size
+	   -- shifting by it unguarded would be undefined.  */
+	sport->peer_pending_raw =
+	  sport->peer_request < BFIN_SPORT_PEER_TYPES
+	  && ((sport->peer_raw_types >> sport->peer_request) & 1);
+	/* Logged as type * 100 + cursor, so "announce=111" is type 1 cursor 11.  */
+	bfin_sport_peer_trace (sport, "announce",
+			       sport->peer_request * 100 + (sport->peer_tag & 0xff));
+      }
+    else
+      {
+	status[58] = 0;
+	status[59] = 0;
+	status[60] = 0;
+	status[61] = 0;
+      }
+
+    {
+      bu16 crc = bfin_sport_peer_crc (status, 62);
+
+      status[62] = crc;
+      status[63] = crc >> 8;
+    }
+    memcpy (dest, status, sizeof (status));
+    return nr_bytes;
+  }
+}
+
+static void
+bfin_sport_trace_rx (struct bfin_sport *sport, const char *event,
+		     unsigned count)
+{
+  const char *trace = getenv ("BFIN_SPORT_TRACE");
+
+  if (trace && *trace)
+    fprintf (stderr, "SPORT RX base=%#x event=%s count=%u offset=%lu/%lu\n",
+	     sport->base, event, count, (unsigned long) sport->rx_offset,
+	     (unsigned long) sport->rx_size);
+}
+
+static void
+bfin_sport_initialize_rx (struct hw *me, struct bfin_sport *sport)
+{
+  const char *path = getenv ("BFIN_SPORT_RX_INPUT");
+  const char *zero_bytes = getenv ("BFIN_SPORT_RX_ZERO_BYTES");
+  FILE *stream;
+  long size;
+
+  sport->rx_initialized = true;
+  sport->rx_records = getenv ("BFIN_SPORT_RX_RECORDS") != NULL;
+  sport->peer_enabled = getenv ("BFIN_MAIN_PEER") != NULL;
+  sport->link_enabled = getenv ("BFIN_MAIN_LINK") != NULL;
+  sport->link_request_fd = sport->link_record_fd = -1;
+
+  if (path && *path)
+    {
+      stream = fopen (path, "rb");
+      if (!stream)
+	hw_abort (me, "Cannot open BFIN_SPORT_RX_INPUT '%s'", path);
+      if (fseek (stream, 0, SEEK_END) != 0 || (size = ftell (stream)) < 0
+	  || fseek (stream, 0, SEEK_SET) != 0)
+	hw_abort (me, "Cannot size BFIN_SPORT_RX_INPUT '%s'", path);
+      if (size != 0)
+	{
+	  sport->rx_data = HW_NALLOC (me, unsigned char, (size_t) size);
+	  if (fread (sport->rx_data, 1, (size_t) size, stream)
+	      != (size_t) size)
+	    hw_abort (me, "Cannot read BFIN_SPORT_RX_INPUT '%s'", path);
+	  sport->rx_size = (size_t) size;
+	}
+      fclose (stream);
+    }
+  else if (zero_bytes && *zero_bytes)
+    {
+      char *end;
+      unsigned long count = strtoul (zero_bytes, &end, 0);
+
+      if (*end != '\0' || count > 16 * 1024 * 1024)
+	hw_abort (me, "Invalid BFIN_SPORT_RX_ZERO_BYTES '%s'", zero_bytes);
+      if (count != 0)
+	{
+	  sport->rx_data = HW_NALLOC (me, unsigned char, (size_t) count);
+	  memset (sport->rx_data, 0, (size_t) count);
+	  sport->rx_size = (size_t) count;
+	}
+    }
+}
+
+static unsigned
+bfin_sport_io_write_buffer (struct hw *me, const void *source, int space,
+			    address_word addr, unsigned nr_bytes)
+{
+  struct bfin_sport *sport = hw_data (me);
+  bu32 off = addr - sport->base;
+
+  if (!dv_bfin_mmr_require_16_32 (me, addr, nr_bytes, true))
+    return 0;
+  if (off >= BFIN_MMR_SPORT_SIZE)
+    {
+      dv_bfin_mmr_invalid (me, addr, nr_bytes, true);
+      return 0;
+    }
+
+  if (nr_bytes == 4)
+    sport->regs[off / 4] = dv_load_4 (source);
+  else
+    sport->regs[off / 4] = ((sport->regs[off / 4] & 0xffff0000)
+			    | dv_load_2 (source));
+  if (getenv ("BFIN_SPORT_TRACE"))
+    fprintf (stderr, "SPORT MMR base=%#x write off=%#x bytes=%u value=%#x\n",
+	     sport->base, off, nr_bytes, sport->regs[off / 4]);
+  return nr_bytes;
+}
+
+static unsigned
+bfin_sport_io_read_buffer (struct hw *me, void *dest, int space,
+			   address_word addr, unsigned nr_bytes)
+{
+  struct bfin_sport *sport = hw_data (me);
+  bu32 off = addr - sport->base;
+
+  if (!dv_bfin_mmr_require_16_32 (me, addr, nr_bytes, false))
+    return 0;
+  if (off >= BFIN_MMR_SPORT_SIZE)
+    {
+      dv_bfin_mmr_invalid (me, addr, nr_bytes, false);
+      return 0;
+    }
+
+  if (nr_bytes == 4)
+    dv_store_4 (dest, sport->regs[off / 4]);
+  else
+    dv_store_2 (dest, sport->regs[off / 4]);
+  return nr_bytes;
+}
+
+static unsigned
+bfin_sport_dma_read_buffer (struct hw *me, void *dest, int space,
+			    unsigned_word addr, unsigned nr_bytes)
+{
+  struct bfin_sport *sport = hw_data (me);
+  size_t remaining;
+
+  /* Which buffer a record lands in is the whole question when the GUI's
+     receive descriptor and the record it gets do not match: the status record
+     goes to 0x00f00000 and an announced payload to 0x00f00040, and a 64-byte
+     record delivered into 0x00f00000 while the firmware is waiting for a
+     payload rewrites the word count it is about to use.  */
+  if (getenv ("BFIN_SPORT_RX_ADDR_TRACE"))
+    {
+      unsigned char state = 0;
+      unsigned char busy = 0;
+
+      sim_read (hw_system (me), 0x005880c0, &state, 1);
+      /* 0x005880b8 is 1 while the 200-byte housekeeping receive is in flight
+	 (set at 0xb7ef5e).  The DMA3 interrupt handler 0xb7c688 reads it before
+	 anything else: at 1 it writes 2 and returns without setting the flag
+	 the record handler task waits on, so a record delivered in that window
+	 is never handed to 0xb7f63a at all.  r123 measured the consequence from
+	 the other end -- 1 379 armed 64-byte receives, 102 handler runs -- and
+	 this byte is what a delivery would have to look at to stay out of that
+	 window.  */
+      sim_read (hw_system (me), 0x005880b8, &busy, 1);
+      fprintf (stderr, "sport rx addr 0x%08x len %u rxstate %u busy %u\n",
+	       (unsigned) addr, nr_bytes, state, busy);
+      fflush (stderr);
+    }
+
+  /* The CDJ GUI multiplexes fixed 200-byte housekeeping transactions and
+     variable MAIN protocol packets over the same SPORT.  A flat replay file
+     cannot predict how many housekeeping reads the emulated threads will
+     schedule, so optionally satisfy those reads without advancing the MAIN
+     packet script.  */
+  if (nr_bytes == 200 && getenv ("BFIN_SPORT_RX_ZERO_200"))
+    {
+      /* record_waiting() drains the socket and spends the yield budget, so it
+	 has to run whichever way the refusal below goes -- otherwise the switch
+	 would also change how often MAIN's records are read off the wire, and
+	 the A/B would measure two things at once.  */
+      int waiting = bfin_sport_link_record_waiting (sport);
+
+      if (!waiting && !bfin_sport_link_refuse_housekeeping (sport))
+	{
+	  memset (dest, 0, nr_bytes);
+	  bfin_sport_trace_rx (sport, "zero200", nr_bytes);
+	  return nr_bytes;
+	}
+    }
+
+  if (!sport->rx_initialized)
+    bfin_sport_initialize_rx (me, sport);
+
+  /* A live MAIN board answers before any file-based peer does.  */
+  if (sport->link_enabled)
+    {
+      if (!sport->link_opened)
+	bfin_sport_link_open (sport);
+      if (sport->link_opened)
+	{
+	  bfin_sport_link_poll (sport);
+	  /* Hold the announcing record in place while the firmware waits for the
+	     payload it announced -- see BFIN_LINK_HOLD_ANNOUNCE above.  */
+	  if (bfin_sport_link_hold_announce ()
+	      && !bfin_sport_link_announce_sticky ()
+	      && nr_bytes == sizeof (sport->link_last)
+	      && sport->link_have_last
+	      && sport->link_announce_pending)
+	    {
+	      const unsigned char *candidate
+		= bfin_sport_link_peek_status (sport);
+
+	      if (candidate != NULL
+		  && (candidate[58] | candidate[59]) == 0
+		  && sport->link_hold_run
+		     < (unsigned long) bfin_sport_link_hold_max ())
+		{
+		  unsigned long n = ++sport->link_hold_total;
+
+		  sport->link_hold_run++;
+		  memcpy (dest, sport->link_last, nr_bytes);
+		  while (n >= 10 && n % 10 == 0)
+		    n /= 10;
+		  if (n == 1)
+		    {
+		      fprintf (stderr, "link: held the announcing record at "
+			       "0x%08x, run %lu, x%lu, t%.1f\n",
+			       (unsigned) addr, sport->link_hold_run,
+			       sport->link_hold_total, bfin_sim_seconds ());
+		      fflush (stderr);
+		    }
+		  bfin_sport_link_rx_census (sport, 0);
+		  return nr_bytes;
+		}
+	      if (sport->link_hold_run
+		  == (unsigned long) bfin_sport_link_hold_max ())
+		{
+		  sport->link_hold_run++;
+		  sport->link_announce_pending = 0;
+		  fprintf (stderr, "link: giving up the hold after %d in a row"
+			   " at t%.1f -- the announced payload never went "
+			   "over\n", bfin_sport_link_hold_max (),
+			   bfin_sim_seconds ());
+		  fflush (stderr);
+		}
+	    }
+	  if (sport->link_framed
+	      ? bfin_sport_link_take (sport, dest, nr_bytes) != 0
+	      : sport->link_in_len >= nr_bytes)
+	    {
+	      if (!sport->link_framed)
+		{
+		  sport->link_take_fresh = 1;
+		  memcpy (dest, sport->link_in, nr_bytes);
+		  sport->link_in_len -= nr_bytes;
+		  memmove (sport->link_in, sport->link_in + nr_bytes,
+			   sport->link_in_len);
+		}
+	      if (nr_bytes == sizeof (sport->link_last))
+		{
+		  unsigned char *bytes = dest;
+
+		  /* The announcement is a field the firmware is mid-transaction
+		     on: carry it across a fresh record rather than letting the
+		     validated count change underneath it.  */
+		  if (bfin_sport_link_announce_sticky ()
+		      && sport->link_have_last
+		      && sport->link_announce_pending
+		      && (bytes[58] | bytes[59]) == 0)
+		    {
+		      unsigned long n = ++sport->link_hold_total;
+
+		      bfin_sport_link_carry_announce (bytes, sport->link_last);
+		      while (n >= 10 && n % 10 == 0)
+			n /= 10;
+		      if (n == 1)
+			{
+			  fprintf (stderr, "link: carried the announcement onto"
+				   " a fresh record, x%lu, t%.1f\n",
+				   sport->link_hold_total,
+				   bfin_sim_seconds ());
+			  fflush (stderr);
+			}
+		    }
+		  bfin_sport_link_force_w13 (dest);
+		  /* Count before link_last moves on: `changed` is what the
+		     firmware could possibly have noticed.  */
+		  if (sport->link_take_fresh)
+		    {
+		      sport->link_rx_fresh++;
+		      if (!sport->link_have_last
+			  || memcmp (dest, sport->link_last,
+				     sizeof (sport->link_last)) != 0)
+			sport->link_rx_changed++;
+		    }
+		  else
+		    sport->link_rx_repeat++;
+		  memcpy (sport->link_last, dest, sizeof (sport->link_last));
+		  sport->link_have_last = 1;
+		  if (bytes[58] | bytes[59])
+		    {
+		      sport->link_announce_pending = 1;
+		      sport->link_hold_run = 0;
+		    }
+		  bfin_sport_link_trace_w30 (dest, "fresh");
+		}
+	      else
+		{
+		  /* A payload went over: the announcement it belonged to is
+		     spent, so a newer status record may take its place again.
+		     Wipe it out of the held record as well, or the repeat path
+		     below announces the same payload for the rest of the run
+		     and the firmware re-enters receive state 2 every time.  */
+		  sport->link_announce_pending = 0;
+		  sport->link_rx_payload++;
+		  if ((bfin_sport_link_announce_sticky ()
+		       || bfin_sport_link_announce_oneshot ())
+		      && sport->link_have_last)
+		    bfin_sport_link_clear_announce (sport->link_last);
+		}
+	      bfin_sport_link_rx_census (sport, 0);
+	      bfin_sport_link_dump (dest, nr_bytes);
+	      bfin_sport_peer_trace (sport, "link-rx", nr_bytes);
+	      return nr_bytes;
+	    }
+	  /* Between MAIN's transmissions the wire still carries its last
+	     record, so repeat it rather than stalling the GUI.  */
+	  if (nr_bytes == sizeof (sport->link_last) && sport->link_have_last)
+	    {
+	      memcpy (dest, sport->link_last, nr_bytes);
+	      sport->link_rx_repeat++;
+	      bfin_sport_link_rx_census (sport, 0);
+	      bfin_sport_link_trace_w30 (dest, "repeat");
+	      return nr_bytes;
+	    }
+	}
+      /* Nothing live yet.  Fall through to the file-based peer if one is
+	 configured: a real MAIN is already transmitting when the GUI boots,
+	 and without that first record the GUI's protocol task never runs far
+	 enough to transmit a request -- so the live link would have nothing to
+	 answer and the two would deadlock.  The bootstrap record is replaced
+	 by MAIN's own the moment one arrives.  */
+      if (!sport->peer_enabled)
+	return 0;
+    }
+
+  if (sport->peer_enabled)
+    {
+      unsigned produced = bfin_sport_peer_read (sport, dest, nr_bytes);
+
+      if (produced != 0)
+	return produced;
+      /* Nothing to say for this size: apply backpressure rather than feed the
+	 GUI a stale record, which is what provokes E-8709.  */
+      return 0;
+    }
+
+  if (sport->rx_records)
+    {
+      size_t record_size = 0;
+
+      if (sport->rx_offset + 4 <= sport->rx_size)
+	{
+	  const unsigned char *header = sport->rx_data + sport->rx_offset;
+	  record_size = ((size_t) header[0]
+			 | (size_t) header[1] << 8
+			 | (size_t) header[2] << 16
+			 | (size_t) header[3] << 24);
+	}
+      if (record_size == nr_bytes
+	  && record_size <= sizeof (sport->rx_last)
+	  && sport->rx_offset + 4 + record_size <= sport->rx_size)
+	{
+	  sport->rx_offset += 4;
+	  memcpy (dest, sport->rx_data + sport->rx_offset, record_size);
+	  memcpy (sport->rx_last, sport->rx_data + sport->rx_offset,
+		  record_size);
+	  sport->rx_offset += record_size;
+	  sport->rx_last_size = record_size;
+	  bfin_sport_trace_rx (sport, "record", nr_bytes);
+	  return nr_bytes;
+	}
+      if (sport->rx_last_size == nr_bytes)
+	{
+	  memcpy (dest, sport->rx_last, nr_bytes);
+	  bfin_sport_trace_rx (sport, "repeat", nr_bytes);
+	  return nr_bytes;
+	}
+
+      /* Keep the DMA pending until the firmware requests the size of the
+	 next scripted record.  This models MAIN repeating an announcement
+	 while it waits for the GUI to request the advertised payload.  */
+      bfin_sport_trace_rx (sport, "record-wait", nr_bytes);
+      return 0;
+    }
+
+  remaining = sport->rx_size - sport->rx_offset;
+  if (remaining != 0)
+    {
+      unsigned count = nr_bytes;
+
+      if (count > remaining)
+	count = (unsigned) remaining;
+      memcpy (dest, sport->rx_data + sport->rx_offset, count);
+      sport->rx_offset += count;
+      bfin_sport_trace_rx (sport, "data", count);
+      return count;
+    }
+
+  /* With no MAIN-side words queued, returning zero applies backpressure and
+     lets the DMAC retry instead of aborting on a missing peer.  */
+  if (!sport->rx_exhaustion_reported)
+    {
+      sport->rx_exhaustion_reported = true;
+      bfin_sport_trace_rx (sport, "empty", 0);
+    }
+  return 0;
+}
+
+/* BFIN_REQUEST_KIND=<n> overwrites word 4 of every outgoing type-1 request.
+
+   Word 4 is the source the GUI is asking about, and MAIN reads it as
+   KIND: 0 = LINK, 1 = USB, 2 = SD/CARD, 3 = DISC (the switch at 0x151b80 and
+   its pool at 0x151c00).  Measured in r083, all 685 cursor-1 type-1 requests
+   carry 1, so MAIN answers a one-row list saying `NO USB` while its own status
+   record reports word 18 = 2, SD, in 7 605 of 8 429 records.
+
+   This is a diagnostic, not a repair: it asks "if the GUI named the right
+   source, would the rest of the chain deliver rows out of export.pdb?" without
+   first having to find out why the GUI names the wrong one.  A run with it set
+   is NOT acceptance evidence for GOAL point 2, which requires the GUI to ask
+   correctly by itself.
+
+   MAIN checksums every request it receives (0x2a423e; frames it rejects are
+   counted at 0x0489bc88, measured 0), so the last halfword has to be recomputed
+   or the frame is discarded unexamined.  The checksum is the firmware's own,
+   little-endian, over the first 46 bytes -- verified against 400 saved requests
+   from r083.  The guest's DMA buffer is never touched: the substitution happens
+   in a local copy.  */
+
+static const unsigned char *
+bfin_sport_force_kind (const unsigned char *source, unsigned nr_bytes,
+		       unsigned char *scratch)
+{
+  static int cached = -2;
+  unsigned word1;
+  bu16 sum;
+
+  if (cached == -2)
+    {
+      const char *spec = getenv ("BFIN_REQUEST_KIND");
+
+      cached = (spec && *spec) ? (int) strtoul (spec, NULL, 0) : -1;
+    }
+  if (cached < 0 || nr_bytes != 48)
+    return source;
+  word1 = source[2] | (source[3] << 8);
+  if ((word1 & 0x3fff) != 1)
+    return source;
+
+  memcpy (scratch, source, nr_bytes);
+  scratch[8] = (unsigned char) cached;
+  scratch[9] = (unsigned char) (cached >> 8);
+  sum = bfin_sport_peer_crc (scratch, nr_bytes - 2);
+  scratch[nr_bytes - 2] = sum & 0xff;
+  scratch[nr_bytes - 1] = (sum >> 8) & 0xff;
+  return scratch;
+}
+
+static unsigned
+bfin_sport_dma_write_buffer (struct hw *me, const void *source, int space,
+			     unsigned_word addr, unsigned nr_bytes,
+			     int violate_read_only_section)
+{
+  struct bfin_sport *sport = hw_data (me);
+  const char *path = getenv ("BFIN_SPORT_TX_OUTPUT");
+  unsigned char scratch[48];
+
+  /* Everything below -- the wire, the peer's request tracking and the TX dump
+     -- sees what actually went out, so a dump decoded afterwards shows the
+     substitution rather than the GUI's intent.  That is deliberate: it is how a
+     run proves the switch took effect.  */
+  if (nr_bytes <= sizeof (scratch))
+    source = bfin_sport_force_kind (source, nr_bytes, scratch);
+
+  /* A request can precede the first read, so make sure the peer is live.  */
+  if (!sport->rx_initialized)
+    bfin_sport_initialize_rx (me, sport);
+
+  if (sport->link_enabled)
+    {
+      if (!sport->link_opened)
+	bfin_sport_link_open (sport);
+      if (sport->link_opened)
+	{
+	  send (sport->link_request_fd, (const char *) source, (int) nr_bytes, 0);
+	  bfin_sport_peer_trace (sport, "link-tx", nr_bytes);
+	}
+    }
+
+  /* The GUI's requests arrive here.  Word 1 of a 48-byte request is
+     0x8000|type and word 2 is the cursor; remember both so the next status read
+     can answer that exact pair.  Reacting on the type alone was wrong: the GUI
+     asks for type 1 with cursors 1, 3 and 11 without ever changing the type, so
+     the cursor-11 request (the right browse pane) was answered with the
+     cursor-1 body.  */
+  if (sport->peer_enabled && nr_bytes >= 4)
+    {
+      const unsigned char *bytes = source;
+      unsigned word1 = bytes[2] | (bytes[3] << 8);
+
+      if (word1 & 0x8000)
+	{
+	  unsigned type = word1 & 0x7fff;
+	  /* Word 2 is both the cursor and the tag the GUI expects echoed in the
+	     response's command low nibble.  */
+	  unsigned tag = (nr_bytes >= 6) ? (bytes[4] | (bytes[5] << 8))
+					 : sport->peer_tag;
+
+	  if (type != sport->peer_request || tag != sport->peer_tag)
+	    bfin_sport_peer_trace (sport, "request", type * 100 + (tag & 0xff));
+	  sport->peer_request = type;
+	  sport->peer_tag = tag;
+	}
+    }
+
+  /* Preserve packet boundaries and the SPORT instance for protocol analysis.
+     Each little-endian record is: "SPTX", SPORT base, payload length, bytes.  */
+  if (path && *path)
+    {
+      FILE *stream = fopen (path, "ab");
+      if (stream)
+	{
+	  unsigned char header[12] =
+	  {
+	    'S', 'P', 'T', 'X',
+	    sport->base, sport->base >> 8, sport->base >> 16,
+	    sport->base >> 24,
+	    nr_bytes, nr_bytes >> 8, nr_bytes >> 16, nr_bytes >> 24,
+	  };
+	  fwrite (header, 1, sizeof (header), stream);
+	  fwrite (source, 1, nr_bytes, stream);
+	  fclose (stream);
+	}
+    }
+
+  return nr_bytes;
+}
+
+static const struct hw_port_descriptor bfin_sport_ports[] =
+{
+  { "stat", 0, 0, output_port, },
+  { "tx",   1, 0, output_port, },
+  { "rx",   2, 0, output_port, },
+  { NULL, 0, 0, 0, },
+};
+
+static void
+bfin_sport_finish (struct hw *me)
+{
+  struct bfin_sport *sport;
+  address_word attach_address;
+  int attach_space;
+  unsigned attach_size;
+  reg_property_spec reg;
+
+  if (hw_find_property (me, "reg") == NULL)
+    hw_abort (me, "Missing \"reg\" property");
+  if (!hw_find_reg_array_property (me, "reg", 0, &reg))
+    hw_abort (me, "\"reg\" property must contain three addr/size entries");
+
+  hw_unit_address_to_attach_address (hw_parent (me), &reg.address,
+				     &attach_space, &attach_address, me);
+  hw_unit_size_to_attach_size (hw_parent (me), &reg.size, &attach_size, me);
+  if (attach_size != BFIN_MMR_SPORT_SIZE)
+    hw_abort (me, "\"reg\" size must be %#x", BFIN_MMR_SPORT_SIZE);
+
+  sport = HW_ZALLOC (me, struct bfin_sport);
+  sport->base = attach_address;
+  set_hw_data (me, sport);
+  set_hw_io_read_buffer (me, bfin_sport_io_read_buffer);
+  set_hw_io_write_buffer (me, bfin_sport_io_write_buffer);
+  set_hw_dma_read_buffer (me, bfin_sport_dma_read_buffer);
+  set_hw_dma_write_buffer (me, bfin_sport_dma_write_buffer);
+  set_hw_ports (me, bfin_sport_ports);
+
+  hw_attach_address (hw_parent (me), 0, attach_space, attach_address,
+		     attach_size, me);
+}
