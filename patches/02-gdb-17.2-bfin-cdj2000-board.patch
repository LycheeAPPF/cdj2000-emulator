+/* BFIN_EXCEPTION_TRACE names the first fault.  Without it the only thing the
+   log carries is "double fault at <handler entry>", which is the second one
+   and says nothing about the cause.
+
+   It has to fold.  A CPLB miss is ordinary traffic on this firmware, and
+   illegal_instruction() calls cec_exception() from inside a `while (1)`, so an
+   unfolded printer emits an unbounded stream and slows the very run it is
+   measuring.  Repeats are folded by (excp, pc) and re-reported at every power
+   of ten, so no count is lost; sites beyond the table are folded together
+   rather than dropped, because "there were more kinds than I tracked" is
+   itself a finding.  */
+static void
+bfin_cec_trace_exception (SIM_CPU *cpu, int excp)
+{
+  static struct { bu32 pc; int excp; unsigned long hits; } seen[64];
+  static unsigned nr_seen;
+  static int enabled = -1;
+  bu32 pc = PCREG;
+  unsigned i;
+
+  if (enabled < 0)
+    enabled = (getenv ("BFIN_EXCEPTION_TRACE") != NULL);
+  if (!enabled)
+    return;
+
+  for (i = 0; i < nr_seen; ++i)
+    if (seen[i].pc == pc && seen[i].excp == excp)
+      {
+	unsigned long n = ++seen[i].hits;
+
+	while (n >= 10 && n % 10 == 0)
+	  n /= 10;
+	if (n != 1)
+	  return;
+	fprintf (stderr, "bfin exception %#x at pc 0x%08x in EVT%i"
+		 " t%.1f x%lu\n", excp, pc, cec_get_ivg (cpu),
+		 bfin_sim_seconds (), seen[i].hits);
+	fflush (stderr);
+	return;
+      }
+
+  if (nr_seen == ARRAY_SIZE (seen))
+    {
+      static unsigned long overflow;
+      unsigned long n = ++overflow;
+
+      while (n >= 10 && n % 10 == 0)
+	n /= 10;
+      if (n != 1)
+	return;
+      fprintf (stderr, "bfin exception %#x at pc 0x%08x in EVT%i t%.1f"
+	       " (past the %u tracked sites, x%lu)\n", excp, pc,
+	       cec_get_ivg (cpu), bfin_sim_seconds (),
+	       (unsigned) ARRAY_SIZE (seen), overflow);
+      fflush (stderr);
+      return;
+    }
+
+  seen[nr_seen].pc = pc;
+  seen[nr_seen].excp = excp;
+  seen[nr_seen].hits = 1;
+  ++nr_seen;
+  fprintf (stderr, "bfin exception %#x at pc 0x%08x in EVT%i t%.1f\n",
+	   excp, pc, cec_get_ivg (cpu), bfin_sim_seconds ());
+  fflush (stderr);
+}
