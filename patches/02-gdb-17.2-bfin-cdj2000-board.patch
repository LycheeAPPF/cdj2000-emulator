+      {
+	if (pc == 0xb7c1aa)
+	  {
+	    if (DREG (1) == 32)
+	      ++rec_arm64;
+	    else
+	      ++rec_armother;
+	  }
+	else if (pc == 0xb7f63a)
+	  ++rec_handler;
+	else if (pc == 0xb7dec8)
+	  ++rec_parse;
+	else if (pc == 0xb7f692)
+	  ++rec_st0;
+	else if (pc == 0xb7fa06)
+	  ++rec_st2;
+	else if (pc == 0xb7fb6c)
+	  ++rec_stx;
+	else if (pc == 0xb7f994)
+	  ++rec_crcbad;
+	else if (pc == 0xb7f704)
+	  ++rec_gate19;
+	else if (pc == 0xb7f7fc)
+	  ++rec_gate13;
+	else if (pc == 0xb7f884)
+	  ++rec_anntest;
+	else if (pc == 0xb7f898)
+	  {
+	    rec_lastann = (unsigned) DREG (0);
+	    if (DREG (0) == 0)
+	      ++rec_annzero;
+	    else
+	      ++rec_annnz;
+	  }
+	else if (pc == 0xb7f8d2)
+	  {
+	    rec_lastw30 = (unsigned) DREG (0);
+	    if (DREG (0) >= 1 && DREG (0) <= 2048)
+	      ++rec_w30ok;
+	    else
+	      ++rec_w30bad;
+	  }
+	else if (pc == 0xb7f8ec)
+	  ++rec_payarm;
+	else if (pc == 0xb7f904)
+	  ++rec_payrej;
+	else if (pc == 0xb7fa56)
+	  ++rec_payok;
+	else if (pc == 0xb7fafa)
+	  ++rec_paybad;
+	else if (pc == 0xb7faba)
+	  ++rec_payuse;
+	else if (pc == 0xb7c73a)
+	  ++rec_isrbusy;
+	else if (pc == 0xb7c74a)
+	  ++rec_isrwake;
+	/* r178 put the whole loss between the wake and the task: 5 022 wakes
+	   against 24 handler runs in 260 s, then ~9 handler runs a second after
+	   ~t285.  These three separate "the task never gets the CPU" from "the
+	   task runs and its wai_flg keeps failing", which is the last fork on
+	   this path and the mechanism of the parse-regime switch.
+
+	     0xb7fc10  CALL 0xba0670   -- pend on flag 0x5881fc, pattern 1
+	     0xb7fc1a  the pend returned 0: the flag is cleared and 0xb7f63a runs
+	     0xb7fc2a  a non-zero return: back to the top having handled nothing  */
