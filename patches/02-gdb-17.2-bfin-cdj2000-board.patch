+	       "%s read pc=%#x return=%#x addr=%#x bytes=%u value=%#x distinct=%u\n",
+	       addr >= 0x00f00000 ? "Bootstrap"
+	       : addr >= 0x005880e4 ? "Housekeeping" : "GUI state",
+	       pc, RETSREG, addr, bytes, value, nr_reads);
+      fflush (stderr);
