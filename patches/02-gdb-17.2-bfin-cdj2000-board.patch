+/* Minimal AMD/Fujitsu standard command set.  This covers the unlock/program
+   and unlock/erase sequences used by the CDJ-2000 settings store.  Operations
+   complete immediately in simulated time, so subsequent DQ polling observes
+   the programmed data rather than an Intel-style status register.  */
+static bool
+cmdset_amd_write (struct hw *me, struct cfi *cfi, const void *source,
+		  unsigned offset, unsigned value, unsigned nr_bytes)
+{
+  unsigned shifted_offset = cfi_unshift_addr (cfi, offset);
+
+  if (cfi->amd_unlock_step == 0)
+    {
+      if (value == AMD_CMD_UNLOCK_FIRST
+	  && shifted_offset == AMD_ADDR_UNLOCK_FIRST)
+	{
+	  cfi->amd_unlock_step = 1;
+	  return true;
+	}
+      return false;
+    }
+  if (cfi->amd_unlock_step == 1)
+    {
+      if (value == AMD_CMD_UNLOCK_SECOND
+	  && shifted_offset == AMD_ADDR_UNLOCK_SECOND)
+	{
+	  cfi->amd_unlock_step = 2;
+	  return true;
+	}
+      cfi->amd_unlock_step = 0;
+      return false;
+    }
+
+  cfi->amd_unlock_step = 0;
+  if (cfi->amd_erase_setup)
+    {
+      if (value == AMD_CMD_ERASE_SECTOR)
+	cfi_erase_block (me, cfi, offset);
+      else if (value == AMD_CMD_ERASE_CHIP
+	       && shifted_offset == AMD_ADDR_UNLOCK_FIRST)
+	memset (cfi->data, 0xff, cfi->dev_size);
+      else
+	return false;
+      cfi->amd_erase_setup = false;
+      cfi->state = CFI_STATE_READ;
+      return true;
+    }
+
+  if (shifted_offset != AMD_ADDR_UNLOCK_FIRST)
+    return false;
+  if (value == AMD_CMD_PROGRAM)
+    cfi->state = CFI_STATE_WRITE;
+  else if (value == AMD_CMD_ERASE_SETUP)
+    cfi->amd_erase_setup = true;
+  else
+    return false;
+  return true;
+}
+
+static bool
+cmdset_amd_read (struct hw *me, struct cfi *cfi, void *dest,
+		 unsigned offset, unsigned shifted_offset, unsigned nr_bytes)
+{
+  unsigned char *sdest = dest;
+  if (cfi->state != CFI_STATE_READ_ID)
+    return false;
+  memset (dest, 0, nr_bytes);
+  if ((shifted_offset & 0x1ff) == 0)
+    *sdest = AMD_ID_MANU;
+  else if ((shifted_offset & 0x1ff) == 1)
+    *sdest = 0x7e;
+  return true;
+}
+
+static void
+cmdset_amd_setup (struct hw *me, struct cfi *cfi)
+{
+  cfi->amd_unlock_step = 0;
+  cfi->amd_erase_setup = false;
+}
