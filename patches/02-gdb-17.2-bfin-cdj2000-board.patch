+	  fprintf (stderr, "step-trace: 0xbb4542 zeroes [0xb5dbe0] (#%lu)"
+		   " t%.1f\n", ++st_zero, bfin_sim_seconds ());
+	else if (pc == 0xbb4948)
+	  fprintf (stderr, "step-trace: 0x10016 arm 0xbb4948 arg2=%u (#%lu)"
+		   " t%.1f\n", (unsigned) DREG (2), ++st_arm16,
+		   bfin_sim_seconds ());
+	else if (pc == 0xbb4964)
+	  fprintf (stderr, "step-trace: [0xb5dbec] = 1, the word-13 branch is"
+		   " ARMED t%.1f\n", bfin_sim_seconds ());
