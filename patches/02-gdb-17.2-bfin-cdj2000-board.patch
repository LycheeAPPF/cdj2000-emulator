Blackfin sim: model the CDJ-2000 GUI board

Everything the stock BF531 model is missing before Pioneer's GUI firmware will
boot and draw.  Each piece is off by default and is switched on through an
environment variable, so an unconfigured simulator behaves as it does upstream.

  sim/common/dv-cfi.c   The AMD/Fujitsu command set, CFI cmdset 2.  Upstream
  sim/common/dv-cfi.h   implements only the Intel set, and the CDJ's 2 MiB
                        parallel flash is an AMD part: without this the board
                        file is rejected with "cmdset 2 not supported", the
                        simulator runs with no flash behind the EBIU, and the
                        firmware double-faults a fraction of a second in --
                        which looks nothing like a missing device.

  sim/bfin/dv-bfin_ppi.c
                        The display path and the board's two peripherals.  The
                        PPI grows a real scanline converter (BFIN_GUI_COLOR,
                        rgb555le for this panel, and BFIN_GUI_HEIGHT for the
                        blanking rows the DMA includes).  A SPORT MMR and DMA
                        model is added, together with the serial link to the
                        MAIN board: BFIN_MAIN_LINK=host:port connects to a
                        listening peer, BFIN_MAIN_PEER* replays a capture from
                        files instead, and BFIN_SPORT_TX_OUTPUT records what
                        the GUI transmits.

  sim/bfin/gui.c        Frame publishing without SDL: BFIN_GUI_OUTPUT writes
  sim/bfin/gui.h        PPM, BFIN_GUI_RAW_OUTPUT the raw framebuffer, both
                        through a temporary file and a rename so a reader never
                        sees a torn frame.  A frame identical to the last one is
                        not republished unless BFIN_GUI_WRITE_EVERY_FRAME is
                        set -- the PPI rescans 20-30 times a second while the
                        picture changes about once every twelve, so this removes
                        over 99% of the write-through.

  sim/bfin/dv-bfin_dma.c
                        Three interrupt-delivery corrections.  Completion status
                        is published before the interrupt is raised, because
                        firmware commonly reads IRQ_STATUS first thing in the
                        handler.  A 2D transfer interrupts when the last row
                        completes, not after every row.  The interrupt output is
                        treated as level sensitive: it stays asserted while DONE
                        or ERR is pending and drops only when firmware
                        acknowledges those bits, so a zero-length pulse can no
                        longer be lost before the CEC services the SIC and leave
                        a receive task asleep for good.  BFIN_PPI_DMA_DELAY
                        paces the display DMA; without it the LCD consumes one
                        hardware event per simulated cycle.

  sim/bfin/bfin-sim.c   Packet write-back semantics for parallel-issue
  sim/bfin/bfin-sim.h   containers (BFIN_PARALLEL_WRITEBACK), a host-side fast
                        path for the firmware's LZSS decompressor
                        (BFIN_FAST_LZSS), and the observation tools the board
                        work needed: a PC ring and sampler, PC hit counters,
                        call and memory watches, and register/memory injection.

  sim/common/sim-load.c A loaded section that was only partly written is
                        indistinguishable from one fully written, because the
                        loop discarded do_write's short count.  It is captured
                        now, and SIM_LOAD_TRACE prints requested against actual
                        per section.

  sim/common/sim-core.c SIM_CORE_CENSUS=<lo>:<hi> names which mapping served
                        each stretch of a write.  A hw device that accepts bytes
                        and drops them still returns a full count, so "written
                        == requested" does not mean "stored".

  sim/bfin/dv-bfin_cec.c
  sim/bfin/dv-bfin_mmu.c
  sim/bfin/dv-bfin_gpio.c
  sim/bfin/machs.c      Exception and CPLB tracing, a GPIO PF0 flash-ready
                        toggle (BFIN_GPIO5_READY_TOGGLE) for the boot handshake,
                        and the BF531 wiring the board needs.

  sim/bfin/interp.c     A comment only.  It records why the guest idle loop must
                        not be optimised away: guest time advances per
                        instruction executed, and two attempts at skipping it
                        made boot slower.

Not included: sim/sh/ also carries changes in the tree this came from -- an
attempt to run the CDJ's MAIN board on the SH simulator rather than on QEMU.
That line of work is not part of this emulator and is left out deliberately.

Applies to: GDB 17.2, after 01-gdb-17.2-bfin-parallel-dsp32alu.patch.

--- a/sim/bfin/bfin-sim.c
+++ b/sim/bfin/bfin-sim.c
@@ -36,6 +36,662 @@
 
 #define HOST_LONG_WORD_SIZE (sizeof (long) * 8)
 
+/* --- CDJ-2000 GUI surface introspection -----------------------------------
+
+   The GUI keeps 81 surface descriptors at 0x5080fc, stride 0x2c.  Ids 0..3 are
+   the fixed display surfaces (0 = the 480x234 panel, 1 = the 480x140 browse
+   area, 2 = the 480x94 player area); 4..0x50 are transient slots that get
+   rebound per bitmap.  Resolving an id to its descriptor is what turns a blit
+   from a pair of pointers into a statement about the screen, which is the
+   difference between reverse-engineering the panel and guessing at pixels.  */
+
+#define BFIN_SURFACE_TABLE	0x5080fc
+#define BFIN_SURFACE_STRIDE	0x2c
+#define BFIN_SURFACE_MAX_ID	0x50
+#define BFIN_SURFACE_KEY	0x0c	/* colour key (byte)  */
+#define BFIN_SURFACE_FORMAT	0x12	/* 2 = 8-bit paletted, 3, 8 = 16-bit  */
+#define BFIN_SURFACE_WIDTH	0x18
+#define BFIN_SURFACE_HEIGHT	0x1a
+#define BFIN_SURFACE_PITCH	0x1c	/* stride in bytes  */
+#define BFIN_SURFACE_DATA	0x20
+#define BFIN_SURFACE_PALETTE	0x24	/* index into the palette table  */
+
+/* 30 palettes of 260 RGB555 entries, each preceded by a 4-byte count.  */
+#define BFIN_PALETTE_TABLE	0x508ec8
+#define BFIN_PALETTE_STRIDE	0x20c
+#define BFIN_PALETTE_ENTRIES	260
+
+/* The widget the per-widget dispatcher was last entered with, so a blit can be
+   attributed to the object that wanted it rather than to the compositor.  */
+static bu32 bfin_widget_object;
+static unsigned long bfin_widget_vtable;
+static unsigned bfin_widget_type = 0xff;
+
+static unsigned
+bfin_le16 (const unsigned char *p)
+{
+  return p[0] | ((unsigned) p[1] << 8);
+}
+
+static unsigned long
+bfin_le32 (const unsigned char *p)
+{
+  return bfin_le16 (p) | ((unsigned long) bfin_le16 (p + 2) << 16);
+}
+
+static int
+bfin_surface_read (SIM_CPU *cpu, unsigned id, unsigned char *desc)
+{
+  if (id > BFIN_SURFACE_MAX_ID)
+    return 0;
+  memset (desc, 0, BFIN_SURFACE_STRIDE);
+  return sim_read (CPU_STATE (cpu),
+		   BFIN_SURFACE_TABLE + id * BFIN_SURFACE_STRIDE,
+		   desc, BFIN_SURFACE_STRIDE) == BFIN_SURFACE_STRIDE;
+}
+
+/* Unpack one RGB555LE pixel.  The panel is RGB555 little-endian (red at bit 10,
+   green at 5, blue at 0, bit 15 cleared) -- decoding it as RGB565 is what once
+   turned every palette-blitted background into green/pink streaks.  */
+static void
+bfin_rgb555 (unsigned pixel, unsigned char *out)
+{
+  unsigned r = (pixel >> 10) & 0x1f;
+  unsigned g = (pixel >> 5) & 0x1f;
+  unsigned b = pixel & 0x1f;
+
+  out[0] = (r << 3) | (r >> 2);
+  out[1] = (g << 3) | (g >> 2);
+  out[2] = (b << 3) | (b >> 2);
+}
+
+/* Write surface ID to PATH as a PPM using its *live* geometry.  This is the
+   honest alternative to cropping the composed frame: surfaces 1 and 2 are the
+   two halves of the panel as the firmware itself sees them, with none of the
+   PPI's 21 blanking rows and no compositing in the way.  */
+static void
+bfin_surface_dump (SIM_CPU *cpu, unsigned id, const char *path)
+{
+  unsigned char desc[BFIN_SURFACE_STRIDE];
+  unsigned char palette[BFIN_PALETTE_ENTRIES * 2];
+  unsigned char *row;
+  unsigned char *out;
+  unsigned width, height, pitch, format;
+  unsigned long data;
+  unsigned long palette_index;
+  unsigned y;
+  FILE *stream;
+
+  if (!bfin_surface_read (cpu, id, desc))
+    return;
+
+  format = bfin_le16 (desc + BFIN_SURFACE_FORMAT);
+  width = bfin_le16 (desc + BFIN_SURFACE_WIDTH);
+  height = bfin_le16 (desc + BFIN_SURFACE_HEIGHT);
+  pitch = bfin_le16 (desc + BFIN_SURFACE_PITCH);
+  data = bfin_le32 (desc + BFIN_SURFACE_DATA);
+  palette_index = bfin_le32 (desc + BFIN_SURFACE_PALETTE);
+
+  /* A transient slot caught mid-rebind legitimately has no geometry; skip it
+     rather than emitting a broken file.  */
+  if (!width || !height || width > 4096 || height > 4096 || !pitch || !data)
+    return;
+
+  memset (palette, 0, sizeof (palette));
+  if (format == 2)
+    sim_read (CPU_STATE (cpu),
+	      BFIN_PALETTE_TABLE + palette_index * BFIN_PALETTE_STRIDE,
+	      palette, sizeof (palette));
+
+  row = xmalloc (pitch);
+  out = xmalloc ((size_t) width * 3);
+  stream = fopen (path, "wb");
+  if (stream)
+    {
+      fprintf (stream, "P6\n%u %u\n255\n", width, height);
+      for (y = 0; y < height; ++y)
+	{
+	  unsigned x;
+
+	  memset (row, 0, pitch);
+	  sim_read (CPU_STATE (cpu), data + (bu32) y * pitch, row, pitch);
+	  for (x = 0; x < width; ++x)
+	    {
+	      if (format == 2)
+		{
+		  unsigned index = x < pitch ? row[x] : 0;
+
+		  bfin_rgb555 (bfin_le16 (palette + index * 2), out + x * 3);
+		}
+	      else if (x * 2 + 1 < pitch)
+		bfin_rgb555 (bfin_le16 (row + x * 2), out + x * 3);
+	      else
+		out[x * 3] = out[x * 3 + 1] = out[x * 3 + 2] = 0;
+	    }
+	  fwrite (out, 3, width, stream);
+	}
+      fclose (stream);
+    }
+  free (row);
+  free (out);
+}
+
+void
+bfin_trace_framebuffer_store (SIM_CPU *cpu, bu32 addr, bu32 value,
+			      unsigned bytes)
+{
+  static int enabled = -1;
+  static int target_enabled = -1;
+  static int target_trace_zero = -1;
+  static bu32 target_addr;
+  static unsigned target_count;
+  static unsigned target_limit = 32;
+  static int target_ignore_enabled = -1;
+  static bu32 target_ignore;
+  static unsigned target_dump_after;
+  static bool target_dumped;
+  static bu32 pcs[128];
+  static bu32 returns[128];
+  static unsigned counts[128];
+  static bool saw_nonzero[128];
+  static unsigned nr_pcs;
+  bu32 pc;
+  bu32 return_pc;
+  unsigned i;
+
+  if (enabled < 0)
+    {
+      const char *value_env = getenv ("BFIN_FRAMEBUFFER_WRITE_TRACE");
+      enabled = value_env && *value_env;
+      value_env = getenv ("BFIN_FRAMEBUFFER_TARGET");
+      target_enabled = value_env && *value_env;
+      if (target_enabled)
+	target_addr = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_TARGET_TRACE_ZERO");
+      target_trace_zero = value_env && *value_env;
+      value_env = getenv ("BFIN_TARGET_TRACE_LIMIT");
+      if (value_env && *value_env)
+	target_limit = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_TARGET_TRACE_IGNORE");
+      target_ignore_enabled = value_env && *value_env;
+      if (target_ignore_enabled)
+	target_ignore = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_TARGET_DUMP_AFTER");
+      if (value_env && *value_env)
+	target_dump_after = strtoul (value_env, NULL, 0);
+    }
+  if (target_enabled && (value != 0 || target_trace_zero)
+      && !(target_ignore_enabled
+	   && (value == target_ignore
+	       || (bytes == 4
+		   && value == (target_ignore | (target_ignore << 16)))))
+      && target_count < target_limit
+      && addr < target_addr + 16 && addr + bytes > target_addr)
+    {
+      target_count++;
+      fprintf (stderr,
+	       "FRAMEBUFFER target=%#x hit=%u writer=%#x return=%#x addr=%#x bytes=%u value=%#x p0=%#x p1=%#x p2=%#x p3=%#x p4=%#x p5=%#x r0=%#x r1=%#x r2=%#x r3=%#x r4=%#x r5=%#x r6=%#x r7=%#x i0=%#x i1=%#x i2=%#x i3=%#x\n",
+	       target_addr, target_count, PCREG, RETSREG, addr, bytes, value,
+	       PREG (0), PREG (1), PREG (2), PREG (3), PREG (4), PREG (5),
+	       DREG (0), DREG (1), DREG (2), DREG (3), DREG (4), DREG (5),
+	       DREG (6), DREG (7), IREG (0), IREG (1), IREG (2), IREG (3));
+      fflush (stderr);
+      if (!target_dumped && target_dump_after
+	  && target_count >= target_dump_after)
+	{
+	  const char *prefix = getenv ("BFIN_TARGET_DUMP_PREFIX");
+	  static const struct { const char *suffix; bu32 addr; bu32 size; } dumps[] =
+	    {
+	      { "objects", 0x00508000, 0x00010000 },
+	      { "lowram", 0x00040000, 0x00040000 },
+	    };
+	  unsigned dump;
+
+	  if (prefix && *prefix)
+	    for (dump = 0; dump < ARRAY_SIZE (dumps); ++dump)
+	      {
+		unsigned char buffer[4096];
+		char path[1024];
+		bu32 offset;
+		FILE *fp;
+
+		snprintf (path, sizeof (path), "%s-%s.bin", prefix,
+			  dumps[dump].suffix);
+		fp = fopen (path, "wb");
+		if (!fp)
+		  continue;
+		for (offset = 0; offset < dumps[dump].size;
+		     offset += sizeof (buffer))
+		  {
+		    unsigned amount = min (sizeof (buffer),
+					   dumps[dump].size - offset);
+		    sim_read (CPU_STATE (cpu), dumps[dump].addr + offset,
+			      buffer, amount);
+		    fwrite (buffer, 1, amount, fp);
+		  }
+		fclose (fp);
+	      }
+	  target_dumped = true;
+	}
+    }
+  if (!enabled || addr < 0x0050cc38 || addr >= 0x005862b8)
+    return;
+
+  pc = PCREG;
+  return_pc = RETSREG;
+  for (i = 0; i < nr_pcs; ++i)
+    if (pcs[i] == pc && returns[i] == return_pc)
+      {
+	counts[i]++;
+	if (value != 0 && !saw_nonzero[i])
+	  {
+	    saw_nonzero[i] = true;
+	    fprintf (stderr,
+		     "FRAMEBUFFER nonzero writer=%#x return=%#x addr=%#x bytes=%u value=%#x count=%u p0=%#x p1=%#x p2=%#x p3=%#x p4=%#x p5=%#x\n",
+		     pc, return_pc, addr, bytes, value, counts[i], PREG (0),
+		     PREG (1), PREG (2), PREG (3), PREG (4), PREG (5));
+	    fflush (stderr);
+	  }
+	return;
+      }
+
+  if (nr_pcs < ARRAY_SIZE (pcs))
+    {
+      pcs[nr_pcs] = pc;
+      returns[nr_pcs] = return_pc;
+      counts[nr_pcs] = 1;
+      saw_nonzero[nr_pcs] = value != 0;
+      nr_pcs++;
+      fprintf (stderr,
+	       "FRAMEBUFFER writer=%#x return=%#x addr=%#x bytes=%u value=%#x distinct=%u p0=%#x p1=%#x p2=%#x p3=%#x p4=%#x p5=%#x\n",
+	       pc, return_pc, addr, bytes, value, nr_pcs, PREG (0), PREG (1),
+	       PREG (2), PREG (3), PREG (4), PREG (5));
+      fflush (stderr);
+    }
+}
+
+/* BFIN_PC_RING=<n> -- the last n program counters, in order, dumped once when
+   the first illegal instruction is decoded.
+
+   Every other pc instrument here samples (BFIN_PC_SAMPLE_TRACE), buckets
+   (BFIN_PC_HIST) or deduplicates, and the memory note
+   cdj-emulator-trace-artifacts records what that costs: a thinned trace looks
+   like a contiguous one and is not.  This drops nothing -- one store per
+   dispatch, wrap-around, no I/O until the dump -- so consecutive entries are
+   genuinely consecutive instructions, which is the whole point when the
+   question is "did execution run off the end of a block or jump there".  */
+#define BFIN_PC_RING_MAX 65536u
+static bu32 pc_ring[BFIN_PC_RING_MAX];
+static unsigned pc_ring_n;		/* 0 = disabled */
+static unsigned pc_ring_pos;
+static unsigned long pc_ring_total;
+static int pc_ring_initialized;
+static int pc_ring_dumped;
+
+/* BFIN_PC_PEEK=<addr>[,<addr>...] -- print 16 bytes of guest memory at each
+   address, once early (after BFIN_PC_PEEK_AT dispatches, default 200000) and
+   again at the ring dump.  The question this exists for is "does the guest
+   memory equal the file", and the only honest way to answer it is to look
+   rather than to derive it from the ELF.  Two samples separate "never loaded"
+   from "overwritten later".  */
+static bu32 peek_addr[8];
+static unsigned peek_n;
+static unsigned long peek_at = 200000;
+static int peek_initialized;
+static int peek_early_done;
+static bu32 dump_pc;
+static int dump_pc_armed;
+
+/* BFIN_PEEK_WATCH=<addr>[,<addr>...] -- read these words on every dispatch and
+   print only when one CHANGES.  Point samples (BFIN_PC_PEEK) answer "what is
+   there now"; they cannot answer "was something ever there", and a receive
+   buffer that is filled and drained between two samples reads zero at both.
+   This sees every transition, including ones produced by DMA, because it looks
+   at memory rather than at the CPU store path.  */
+static bu32 pw_addr[4];
+static bu32 pw_last[4];
+static int pw_seen[4];
+static unsigned pw_n;
+static unsigned pw_prints;
+static unsigned pw_limit = 200;
+static int pw_initialized;
+
+/* BFIN_POKE=<addr>=<value>[,<addr>=<value>...] applied when the guest reaches
+   BFIN_POKE_AT_PC (default: the first dispatched instruction), at most
+   BFIN_POKE_LIMIT times (default 1).  Each application prints the address, the
+   value that was there and the value written, so a poke that changed nothing is
+   visible as such rather than assumed to have worked.
+
+   This is a probe, not a patch: it lets a run answer "is there anything
+   runnable behind this gate" without deciding what the gate should really
+   contain.  The gdb stub could do it, but only by stopping the guest, which
+   distorts every timing race this firmware depends on.  */
+static bu32 poke_addr[8];
+static bu32 poke_value[8];
+static unsigned poke_n;
+static bu32 poke_at_pc;
+static int poke_at_pc_armed;
+static unsigned poke_limit = 1;
+static unsigned poke_done;
+static int poke_initialized;
+
+static void
+bfin_peek_print (SIM_CPU *cpu, const char *when)
+{
+  unsigned i, b;
+
+  for (i = 0; i < peek_n; ++i)
+    {
+      fprintf (stderr, "PCPEEK %s %#010x:", when, peek_addr[i]);
+      for (b = 0; b < 16; b += 4)
+	fprintf (stderr, " %08x", GET_LONG (peek_addr[i] + b));
+      fprintf (stderr, "\n");
+    }
+  fflush (stderr);
+}
+
+static void bfin_pc_ring_dump (SIM_CPU *cpu, const char *why, bu32 at);
+
+static void
+bfin_pc_ring_record (SIM_CPU *cpu, bu32 pc)
+{
+  if (!pc_ring_initialized)
+    {
+      const char *value_env = getenv ("BFIN_PC_RING");
+
+      pc_ring_initialized = 1;
+      if (value_env && *value_env)
+	{
+	  unsigned long want = strtoul (value_env, NULL, 0);
+
+	  if (want > BFIN_PC_RING_MAX)
+	    want = BFIN_PC_RING_MAX;
+	  pc_ring_n = (unsigned) want;
+	}
+    }
+  if (!peek_initialized)
+    {
+      const char *value_env = getenv ("BFIN_PC_PEEK");
+
+      peek_initialized = 1;
+      if (value_env && *value_env)
+	{
+	  char buf[256];
+	  char *tok;
+
+	  strncpy (buf, value_env, sizeof (buf) - 1);
+	  buf[sizeof (buf) - 1] = '\0';
+	  for (tok = strtok (buf, ","); tok && peek_n < 8;
+	       tok = strtok (NULL, ","))
+	    peek_addr[peek_n++] = strtoul (tok, NULL, 0);
+	}
+      value_env = getenv ("BFIN_PC_PEEK_AT");
+      if (value_env && *value_env)
+	peek_at = strtoul (value_env, NULL, 0);
+      value_env = getenv ("BFIN_PC_RING_DUMP_PC");
+      if (value_env && *value_env)
+	{
+	  dump_pc = strtoul (value_env, NULL, 0);
+	  dump_pc_armed = 1;
+	}
+    }
+  if (!poke_initialized)
+    {
+      const char *value_env = getenv ("BFIN_POKE");
+
+      poke_initialized = 1;
+      if (value_env && *value_env)
+	{
+	  char buf[256];
+	  char *tok;
+
+	  strncpy (buf, value_env, sizeof (buf) - 1);
+	  buf[sizeof (buf) - 1] = '\0';
+	  for (tok = strtok (buf, ","); tok && poke_n < 8;
+	       tok = strtok (NULL, ","))
+	    {
+	      char *eq = strchr (tok, '=');
+
+	      if (eq == NULL)
+		continue;
+	      *eq = '\0';
+	      poke_addr[poke_n] = strtoul (tok, NULL, 0);
+	      poke_value[poke_n] = strtoul (eq + 1, NULL, 0);
+	      poke_n++;
+	    }
+	}
+      value_env = getenv ("BFIN_POKE_AT_PC");
+      if (value_env && *value_env)
+	{
+	  poke_at_pc = strtoul (value_env, NULL, 0);
+	  poke_at_pc_armed = 1;
+	}
+      value_env = getenv ("BFIN_POKE_LIMIT");
+      if (value_env && *value_env)
+	poke_limit = strtoul (value_env, NULL, 0);
+    }
+  if (!pw_initialized)
+    {
+      const char *value_env = getenv ("BFIN_PEEK_WATCH");
+
+      pw_initialized = 1;
+      if (value_env && *value_env)
+	{
+	  char buf[128];
+	  char *tok;
+
+	  strncpy (buf, value_env, sizeof (buf) - 1);
+	  buf[sizeof (buf) - 1] = '\0';
+	  for (tok = strtok (buf, ","); tok && pw_n < 4;
+	       tok = strtok (NULL, ","))
+	    pw_addr[pw_n++] = strtoul (tok, NULL, 0);
+	}
+      value_env = getenv ("BFIN_PEEK_WATCH_LIMIT");
+      if (value_env && *value_env)
+	pw_limit = strtoul (value_env, NULL, 0);
+    }
+  if (pw_n && pw_prints < pw_limit)
+    {
+      unsigned i;
+
+      for (i = 0; i < pw_n; ++i)
+	{
+	  bu32 now = GET_LONG (pw_addr[i]);
+
+	  if (!pw_seen[i] || now != pw_last[i])
+	    {
+	      if (pw_seen[i])
+		{
+		  pw_prints++;
+		  fprintf (stderr, "PEEKWATCH %#x: %#010x -> %#010x"
+			   " at pc %#x after %lu dispatches\n",
+			   pw_addr[i], pw_last[i], now, pc, pc_ring_total);
+		  fflush (stderr);
+		}
+	      pw_seen[i] = 1;
+	      pw_last[i] = now;
+	    }
+	}
+    }
+  if (poke_n && poke_done < poke_limit
+      && (poke_at_pc_armed ? pc == poke_at_pc : 1))
+    {
+      unsigned i;
+
+      poke_done++;
