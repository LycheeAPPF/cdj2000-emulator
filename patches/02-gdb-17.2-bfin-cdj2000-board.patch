+		       " arg2=%u rets=0x%08x (#%lu) t%.1f\n",
+		       (unsigned) DREG (1), (unsigned) DREG (0),
+		       (unsigned) DREG (2), (unsigned) RETSREG, st_disp_a,
+		       bfin_sim_seconds ());
+	  }
+	else if (pc == 0xbaeb6e)
+	  {
+	    ++st_disp_b;
+	    if (st_disp_b <= 60 || st_disp_b % 500 == 0)
+	      fprintf (stderr, "step-trace: dispatch 0xbaeb6e code=%#x arg0=%u"
+		       " arg2=%u rets=0x%08x (#%lu) t%.1f\n",
+		       (unsigned) DREG (1), (unsigned) DREG (0),
+		       (unsigned) DREG (2), (unsigned) RETSREG, st_disp_b,
+		       bfin_sim_seconds ());
+	  }
+	/* R0 already holds [0xb5dbe0] here; the compare is the next insn.  */
