+	  fprintf (stderr, "step-trace: word-13 branch taken (#%lu) t%.1f\n",
+		   ++st_w13, bfin_sim_seconds ());
+	/* r131 put 0x10016 on the wire and 0xbaeb6e's class at zero messages,
+	   so the question moved from "which code" to "which target".  The one
+	   place that decides it is the sender itself:
+
